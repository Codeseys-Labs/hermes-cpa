+      await second.promise
+    })
+    expect(container.querySelector('iframe')?.getAttribute('src')).toBe('blob:https://host.test/1')
+    await act(async () => {
+      first.resolve(await webcrypto.subtle.digest('SHA-256', new NodeTextEncoder().encode(a.html)))
