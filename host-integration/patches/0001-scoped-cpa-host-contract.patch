@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { pluginSelectionHeaders } from './plugin-selection.js'
+
+test('selection bridge permits only comparison tokens on plugin routes', () => {
+  assert.deepEqual(pluginSelectionHeaders('/api/status'), {})
+  const token = { client: 'generated-window-id', scope: 'a'.repeat(32), epoch: 7 }
+  assert.deepEqual(pluginSelectionHeaders('/api/plugins/hermes-cpa/config', token), {
+    'X-Hermes-Plugin-Client': token.client,
+    'X-Hermes-Plugin-Scope': token.scope,
+    'X-Hermes-Plugin-Epoch': '7'
+  })
+  for (const invalid of [{ ...token, epoch: true }, { ...token, epoch: -1 },
+    { ...token, client: 'injected\r\nheader' }, { ...token, scope: 'bad' }]) {
+    assert.throws(() => pluginSelectionHeaders('/api/plugins/hermes-cpa/config', invalid as never))
+  }
+  assert.throws(() => pluginSelectionHeaders('/api/status', token))
+})
diff --git a/apps/desktop/electron/plugin-selection.ts b/apps/desktop/electron/plugin-selection.ts
new file mode 100644
index 0000000..df175cb
--- /dev/null
+++ b/apps/desktop/electron/plugin-selection.ts
@@ -0,0 +1,22 @@
+export interface PluginSelectionToken {
+  client: string
+  scope?: string
+  epoch: number
+}
+
+/** Only comparison tokens cross this bridge. Authentication headers remain
+ * Electron-owned; a renderer cannot provide a credential or a home here. */
+export function pluginSelectionHeaders(path: string, token?: PluginSelectionToken): Record<string, string> {
+  if (token === undefined) return {}
+  if (!/^\/api\/plugins\/[a-zA-Z0-9_-]+\//.test(path) ||
+      typeof token.client !== 'string' || !/^[a-zA-Z0-9_-]{16,128}$/.test(token.client) ||
+      !Number.isSafeInteger(token.epoch) || token.epoch < 0 ||
+      (token.scope !== undefined && !/^[a-f0-9]{32}$/.test(token.scope))) {
+    throw new Error('Invalid plugin selection token')
+  }
+  return {
+    'X-Hermes-Plugin-Client': token.client,
+    'X-Hermes-Plugin-Epoch': String(token.epoch),
+    ...(token.scope ? { 'X-Hermes-Plugin-Scope': token.scope } : {})
+  }
+}
diff --git a/apps/desktop/src/api/plugin-selection-session.node-test.ts b/apps/desktop/src/api/plugin-selection-session.node-test.ts
new file mode 100644
index 0000000..09d29e1
--- /dev/null
+++ b/apps/desktop/src/api/plugin-selection-session.node-test.ts
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { PluginSelectionSession } from './plugin-selection-session.js'
+
+const owner = (profile: string) => ({ profile, connectionId: 'local' })
+const tick = () => new Promise(resolve => setImmediate(resolve))
+
+test('switch invalidates queued reads and deselects old owner before selecting new', async () => {
+  const calls: string[] = []
+  let release!: () => void
+  const held = new Promise<void>(resolve => { release = resolve })
+  const session = new PluginSelectionSession(async (o, path, token) => {
+    calls.push(`${o.profile}:${path}:${token.epoch}`)
+    if (calls.length === 1) await held
+    return { scope_id: 'a'.repeat(32), epoch: token.epoch + 1 }
+  }, () => 'client_identity_1234')
+  session.change(owner('A'))
+  const stale = session.acquire()
+  const refused = assert.rejects(stale, /STALE_SCOPE/)
+  await tick()
+  session.change(owner('B'))
+  release()
+  await refused
+  const current = await session.acquire()
+  assert.equal(current.owner.profile, 'B')
+  assert.deepEqual(calls, ['A:selection:0', 'A:deselection:1', 'B:selection:0'])
+  assert.equal(session.current(current), true)
+  session.change(owner('A'))
+  assert.equal(session.current(current), false)
+  const back = await session.acquire()
+  assert.equal(back.token.epoch, 3)
+  assert.deepEqual(calls.slice(3), ['B:deselection:1', 'A:selection:2'])
+})
+
+test('lost deselection acknowledgment latches closed, never selects another host', async () => {
+  const calls: string[] = []
+  const session = new PluginSelectionSession(async (o, path, token) => {
+    calls.push(`${o.profile}:${path}`)
+    if (path === 'deselection') throw new Error('network lost')
+    return { scope_id: 'b'.repeat(32), epoch: token.epoch + 1 }
+  }, () => 'client_identity_1234')
+  session.change(owner('A'))
+  await session.acquire()
+  session.change(owner('B'))
+  await assert.rejects(session.acquire(), /network lost/)
+  session.change(owner('A'))
+  await assert.rejects(session.acquire(), /network lost/)
+  assert.deepEqual(calls, ['A:selection', 'A:deselection'])
+})
+
+test('late responses and rapid ABA are invalid even before switch acknowledgment', async () => {
+  const session = new PluginSelectionSession(async (_o, _p, token) => ({
+    scope_id: 'c'.repeat(32), epoch: token.epoch + 1
+  }), () => 'client_identity_1234')
+  session.change(owner('A'))
+  const original = await session.acquire()
+  session.change(owner('B'))
+  session.change(owner('A'))
+  assert.equal(session.current(original), false)
+  const next = await session.acquire()
+  assert.equal(next.owner.profile, 'A')
+  assert.notEqual(original.token.epoch, next.token.epoch)
+})
diff --git a/apps/desktop/src/api/plugin-selection-session.ts b/apps/desktop/src/api/plugin-selection-session.ts
new file mode 100644
index 0000000..04b9681
--- /dev/null
+++ b/apps/desktop/src/api/plugin-selection-session.ts
@@ -0,0 +1,73 @@
+// Comparison tokens are issued by the authenticated host, never by the guest.
+export interface SelectionOwner {
+  profile: string | null
+  connectionId: string | null
+}
+export interface SelectionToken { client: string; scope?: string; epoch: number }
+interface Acknowledgment { scope_id: string; epoch: number }
+export interface SelectionLease {
+  owner: SelectionOwner
+  token: SelectionToken
+  generation: number
+}
+type Exchange = (owner: SelectionOwner, action: 'selection' | 'deselection', token: SelectionToken) => Promise<Acknowledgment>
+
+export class PluginSelectionSession {
+  private generation = 0
+  private desired: string | null = null
+  private selected: SelectionLease | null = null
+  private tail: Promise<void> = Promise.resolve()
+  private routes = new Map<string, SelectionToken>()
+  private exchange: Exchange
+  private clientId: () => string
+
+  constructor(exchange: Exchange, clientId: () => string = () => crypto.randomUUID()) {
+    this.exchange = exchange
+    this.clientId = clientId
+  }
+
+  change(owner: SelectionOwner): void {
+    const captured = { ...owner }
+    const key = JSON.stringify(captured)
+    if (key === this.desired) return
+    this.desired = key
+    const generation = ++this.generation
+    // Do not recover an ambiguous write by silently minting a new client.
+    // A lost ACK requires explicit connection recovery, not a blind retry.
+    this.tail = this.tail.then(async () => {
+      if (this.selected) {
+        const old = this.selected
+        const ack = await this.exchange(old.owner, 'deselection', old.token)
+        this.routes.set(JSON.stringify(old.owner), this.validate(old.token, ack))
+        this.selected = null
+      }
+      const token = this.routes.get(key) ?? { client: this.clientId(), epoch: 0 }
+      const ack = await this.exchange(captured, 'selection', token)
+      const acknowledged = this.validate(token, ack)
+      this.routes.set(key, acknowledged)
+      this.selected = { owner: captured, token: acknowledged, generation }
+    })
+    // Observe background switch failures without turning the rejected chain green.
+    void this.tail.catch(() => undefined)
+  }
+
+  private validate(token: SelectionToken, ack: Acknowledgment): SelectionToken {
+    if (!ack || !/^[a-f0-9]{32}$/.test(ack.scope_id) || !Number.isSafeInteger(ack.epoch) || ack.epoch <= token.epoch) {
+      throw new Error('STALE_SCOPE')
+    }
+    return { client: token.client, scope: ack.scope_id, epoch: ack.epoch }
+  }
+
+  async acquire(): Promise<SelectionLease> {
+    const generation = this.generation
+    await this.tail
+    if (!this.selected || generation !== this.generation || this.selected.generation !== generation) {
+      throw new Error('STALE_SCOPE')
+    }
+    return this.selected
+  }
+
+  current(lease: SelectionLease): boolean {
+    return lease.generation === this.generation && lease === this.selected
+  }
+}
