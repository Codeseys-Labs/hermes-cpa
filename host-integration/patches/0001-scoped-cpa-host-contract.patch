+      while (!last) {
+        if (++steps % 1024 === 0) { await yieldDecode(); checkCurrent() }
+        const block = read(3)
+        const type = (block >> 1) & 3
+        if (type === 3) throw new Error('RESOURCE_RESPONSE_INVALID')
+        last = (block & 1) !== 0
+        skip(type === 1 ? 1 : block >> 3)
+      }
+      if (descriptor & 4) skip(4)
+    }
