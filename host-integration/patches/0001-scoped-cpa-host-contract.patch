+    return chunks
+  } catch {
+    throw new Error(lifetime.signal.aborted ? 'RESOURCE_REVOKED' : 'RESOURCE_RESPONSE_INVALID')
+  } finally {
+    clearTimeout(timer)
+    signal?.removeEventListener('abort', abort)
+  }
+}
