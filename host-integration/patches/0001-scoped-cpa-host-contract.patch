diff --git a/hermes_cli/plugin_operation_authority.py b/hermes_cli/plugin_operation_authority.py
new file mode 100644
index 0000000..5f44850
--- /dev/null
+++ b/hermes_cli/plugin_operation_authority.py
@@ -0,0 +1,111 @@
+"""Private hosted request capabilities; never serialize these to a renderer.
+
+The child can request acceptance only through a capability created for the
+current authenticated request. Home, principal and policy are parent-owned.
+Plugin-specific operation policy remains an additional mandatory check.
+"""
+import hashlib
+import secrets
+import threading
+from dataclasses import asdict
+
+from hermes_cli.plugin_selection_authority import Selection
+
+
+class RequestOperations:
+    def __init__(self, authority):
+        self.authority = authority
+        self.lock = threading.RLock()
+        self.requests = {}
+        self.operations = {}
+        self.operation_plugins = {}
+        self.request_acceptances = {}
+
+    def open(self, context, plugin, method, path, body, policy):
+        selection = context.get('selection') if context else None
+        if selection is None:
+            return None
+        with self.lock:
+            if len(self.requests) >= 64:
+                raise ValueError('BUSY')
+            token = secrets.token_hex(32)
+            self.requests[token] = (Selection(**selection), plugin,
+                method.upper() + ':' + path, hashlib.sha256(body).hexdigest(), policy)
+            return token
+
+    def close(self, token, *, failed=False):
+        with self.lock:
+            self.requests.pop(token, None)
+            acceptances = self.request_acceptances.pop(token, set())
+            if failed:
+                for cap in acceptances:
+                    accepted = self.operations.pop(cap, None)
+                    self.operation_plugins.pop(cap, None)
+                    if accepted is not None:
+                        self.authority.retire(accepted[0])
+
+    def shutdown(self, plugin=None):
+        with self.lock:
+            for token, (record, _) in list(self.operations.items()):
+                if plugin is None or self.operation_plugins.get(token) == plugin:
+                    self.authority.retire(record)
+                    del self.operations[token]
+                    self.operation_plugins.pop(token, None)
+            for token, request in list(self.requests.items()):
+                if plugin is None or request[1] == plugin:
+                    del self.requests[token]
+                    self.request_acceptances.pop(token, None)
+
+    def call(self, params):
+        token = params.get('capability')
+        verb = params.get('verb')
+        # Policy may touch the filesystem or block. Never run it holding the
+        # capability lock (or the shared selection authority lock). Shutdown
+        # removes these exact entries while the callback is still in flight.
+        with self.lock:
+            request = self.requests.get(token) if verb == 'accept' else None
+            accepted = self.operations.get(token) if verb == 'revalidate' else None
+        policy = request[4] if request is not None else accepted[1] if accepted is not None else None
+        allowed = self.authority._allowed(policy) if policy is not None else False
+        with self.lock:
+            if verb == 'accept' and (request is None or self.requests.get(token) is not request):
+                raise ValueError('STALE_SCOPE')
+            if verb == 'revalidate' and (accepted is None or self.operations.get(token) is not accepted):
+                return False
+            if params.get('verb') == 'accept':
+                request = self.requests.get(token)
+                if request is None:
+                    raise ValueError('STALE_SCOPE')
+                selection, plugin, action, digest, policy = request
+                if action.split(':', 1)[0] not in {'POST', 'PUT', 'PATCH', 'DELETE'}:
+                    raise ValueError('INVALID_INPUT')
+                # Namespace IDs so two plugins cannot collide or query each other.
+                operation_id = params.get('operation_id')
+                if not isinstance(operation_id, str) or not 1 <= len(operation_id) <= 128:
+                    raise ValueError('INVALID_INPUT')
+                internal_id = hashlib.sha256((plugin + '\0' + operation_id).encode()).hexdigest()
+                record = self.authority.accept(selection, internal_id, params.get('revision'),
+                    lambda: allowed, action=action, payload_digest=digest)
+                key = (record.selection.principal, record.operation_id)
+                for capability, (existing, _) in self.operations.items():
+                    if (existing.selection.principal, existing.operation_id) == key:
+                        # An idempotent lookup does not own the original grant.
+                        # Failure of this response must not cancel accepted work.
+                        return {'capability': capability, 'record': asdict(existing)}
+                if len(self.operations) >= 100:
+                    raise ValueError('BUSY')
+                capability = secrets.token_hex(32)
+                self.operations[capability] = (record, policy)
+                self.operation_plugins[capability] = plugin
+                self.request_acceptances.setdefault(token, set()).add(capability)
+                return {'capability': capability, 'record': asdict(record)}
+            if params.get('verb') == 'retire':
+                accepted = self.operations.pop(token, None)
+                self.operation_plugins.pop(token, None)
+                for req_caps in self.request_acceptances.values():
+                    req_caps.discard(token)
+                return bool(accepted and self.authority.retire(accepted[0]))
+            if params.get('verb') == 'revalidate':
+                accepted = self.operations.get(token)
+                return bool(accepted and self.authority.revalidate(accepted[0], lambda: allowed))
+            raise ValueError('INVALID_INPUT')
diff --git a/hermes_cli/plugin_policy_epoch.py b/hermes_cli/plugin_policy_epoch.py
new file mode 100644
index 0000000..bee0c6c
--- /dev/null
+++ b/hermes_cli/plugin_policy_epoch.py
@@ -0,0 +1,131 @@
+"""Durable per-plugin revocation epochs for Hermes-mediated config writes.
+
+Epoch publication precedes config publication. A failed write may revoke an old
+owner conservatively; it cannot restore authority. External writers that bypass
+these APIs do not provide an unobserved disable/re-enable history.
+"""
+from collections.abc import Mapping
+from contextlib import contextmanager
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+
+from pm.filesystem import durable_write_bytes, lock_fd
+
+
+_LIMIT = 1024 * 1024
+_NAME = '.plugin-policy-epochs.json'
+_TOKEN = re.compile(r'[a-f0-9]{64}')
+
+
+def _home(home):
+    path = Path(home)
+    if not path.is_absolute() or path.resolve() != path:
+        raise ValueError('Invalid plugin policy home')
+    return path
+
+
+def _read(home):
+    path = home / _NAME
+    try:
+        fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    except FileNotFoundError:
+        return {}
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > _LIMIT or path.is_symlink():
+            raise ValueError('Invalid plugin policy epoch file')
+        if os.name != 'nt' and (info.st_uid != os.getuid() or info.st_mode & 0o077):
+            raise ValueError('Plugin policy epochs must be private')
+        raw = stream.read(_LIMIT + 1)
+    if len(raw) > _LIMIT:
+        raise ValueError('Plugin policy epoch file is too large')
+    record = json.loads(raw)
+    epochs = record.get('epochs') if isinstance(record, dict) else None
+    if (not isinstance(record, dict) or record.get('version') != 1 or
+            not isinstance(epochs, dict) or
+            any(not isinstance(key, str) or not isinstance(token, str) or
+                not _TOKEN.fullmatch(token) for key, token in epochs.items())):
+        raise ValueError('Invalid plugin policy epochs')
+    return epochs
+
+
+def read_policy_epoch(home, plugin_key):
+    """Return an opaque epoch without creating or repairing policy state."""
+    try:
+        return _read(_home(home)).get(plugin_key)
+    except (OSError, ValueError, TypeError):
+        return None
+
+
+def _section(config):
+    if not isinstance(config, Mapping):
+        raise ValueError('Plugin policy config must be a mapping')
+    plugins = config.get('plugins') or {}
+    if not isinstance(plugins, Mapping):
+        raise ValueError('Plugin policy must be a mapping')
+    enabled, disabled = plugins.get('enabled', []), plugins.get('disabled', [])
+    entries = plugins.get('entries') or {}
+    if (not isinstance(enabled, list) or not isinstance(disabled, list) or
+            not isinstance(entries, Mapping) or
+            any(not isinstance(key, str) for key in [*enabled, *disabled, *entries])):
+        raise ValueError('Invalid plugin policy selection')
+    return plugins, set(enabled), set(disabled), entries
+
+
+def _projection(section, key):
+    plugins, enabled, disabled, entries = section
+    return (key in enabled, key in disabled, key in entries, entries.get(key),
+            plugins.get('isolation'), plugins.get('host'))
+
+
+@contextmanager
+def _locked(home):
+    path = home / '.plugin-policy-epochs.lock'
+    fd = os.open(path, os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0), 0o600)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or path.is_symlink():
+            raise ValueError('Invalid plugin policy lock')
+        if os.name != 'nt' and (info.st_uid != os.getuid() or info.st_mode & 0o077):
+            raise ValueError('Plugin policy lock must be private')
+        if info.st_size == 0:
+            os.write(fd, b'\0')
+        if not lock_fd(fd, wait=True, timeout=2):
+            raise TimeoutError('Plugin policy epoch publication timed out')
+        yield
+    finally:
+        os.close(fd)
+
+
+def record_policy_write(home, previous, proposed):
+    """Initialize epochs and revoke only plugins whose policy changes."""
+    home = _home(home)
+    before, after = _section(previous), _section(proposed)
+    keys = before[1] | before[2] | set(before[3]) | after[1] | after[2] | set(after[3])
+    if not keys and not (home / _NAME).exists():
+        return
+    home.mkdir(parents=True, exist_ok=True)
+    with _locked(home):
+        epochs = _read(home)
+        changed = False
+        for key in keys | set(epochs):
+            if key not in epochs or _projection(before, key) != _projection(after, key):
+                epochs[key] = secrets.token_hex(32)
+                changed = True
+        if changed:
+            raw = (json.dumps({'version': 1, 'epochs': epochs}, sort_keys=True) + '\n').encode()
+            if len(raw) > _LIMIT:
+                raise ValueError('Plugin policy epoch file is too large')
+            durable_write_bytes(home / _NAME, raw)
+
+
+def record_policy_bytes(home, previous, proposed):
+    """Apply the same write contract to PM's serialized config publication."""
+    from hermes_yaml import safe_load
+    before = safe_load(previous.decode('utf-8-sig')) if previous else {}
+    after = safe_load(proposed.decode('utf-8-sig')) if proposed else {}
+    record_policy_write(home, before or {}, after or {})
diff --git a/hermes_cli/plugin_policy_incarnation.py b/hermes_cli/plugin_policy_incarnation.py
new file mode 100644
index 0000000..f7a43ce
--- /dev/null
+++ b/hermes_cli/plugin_policy_incarnation.py
@@ -0,0 +1,36 @@
+"""Pin private operation authority to the policy/package filesystem incarnation.
+
+Boolean enablement sampling misses disable/re-enable between checks. Until a
+policy-specific durable revision exists, any policy rewrite conservatively
+invalidates accepted work, even when the final bytes equal the original bytes.
+Selection changes do not write these files and therefore do not revoke work.
+"""
+from pathlib import Path
+import stat as stat_module
+
+
+def policy_incarnation(home, dashboard_dir, api_file):
+    from hermes_cli.managed_scope import get_managed_dir
+
+    dashboard = Path(dashboard_dir)
+    paths = [Path(home), Path(home) / 'config.yaml', dashboard.parent,
+             dashboard / 'manifest.json', dashboard / api_file]
+    managed = get_managed_dir()
+    if managed is not None:
+        paths.extend((Path(managed), Path(managed) / 'config.yaml'))
+    result: list[object] = [str(managed) if managed is not None else None]
+    for path in paths:
+        try:
+            stat = path.lstat()
+        except FileNotFoundError:
+            result.append(None)
+        else:
+            # ctime catches in-place ABA even if mtime and contents are restored;
+            # inode/device catch atomic replacements and package reincarnations.
+            if stat_module.S_ISDIR(stat.st_mode):
+                # Creating unrelated state beneath a home is not policy revocation.
+                result.append((stat.st_dev, stat.st_ino, stat.st_mode))
+            else:
+                result.append((stat.st_dev, stat.st_ino, stat.st_mode, stat.st_size,
+                               stat.st_mtime_ns, stat.st_ctime_ns))
+    return tuple(result)
diff --git a/hermes_cli/plugin_request_context.py b/hermes_cli/plugin_request_context.py
new file mode 100644
index 0000000..9173aa5
--- /dev/null
+++ b/hermes_cli/plugin_request_context.py
@@ -0,0 +1,65 @@
+"""Safe authenticated identity projection for hosted dashboard plugins.
+
+Only the server may construct this metadata. It travels on the private host
+channel, not in HTTP headers, and deliberately contains no bearer credentials.
+Selection authorization is separate; this projection alone cannot authorize a
+selection-sensitive mutation.
+"""
+import hashlib
+import secrets
+import re
+from dataclasses import asdict
+
+from hermes_cli.plugin_selection_authority import SelectionAuthority
+
+from fastapi import HTTPException
+
+from hermes_constants import get_hermes_home
+
+_PROCESS_INCARNATION = secrets.token_hex(16)
+_AUTHORITY = SelectionAuthority()
+
+
+def bind_selection(request, context, *, select_current=False, deselect=False):
+    """Host authenticates and resolves home first; HTTP cannot supply either."""
+    client = request.headers.get('X-Hermes-Plugin-Client', '')
+    if not re.fullmatch(r'[a-zA-Z0-9_-]{16,128}', client):
+        raise HTTPException(status_code=409, detail='STALE_SCOPE')
+    try:
+        if deselect:
+            selected = _AUTHORITY.deselect(context['principal'], client,
+                request.headers.get('X-Hermes-Plugin-Scope'),
+                request.headers.get('X-Hermes-Plugin-Epoch'))
+        elif select_current:
+            selected = _AUTHORITY.select(context['principal'], client,
+                                         context['host_incarnation'], context['home'],
+                                         expected_epoch=request.headers.get('X-Hermes-Plugin-Epoch', '0'))
+        else:
+            selected = _AUTHORITY.resolve(context['principal'], client,
+                request.headers.get('X-Hermes-Plugin-Scope'),
+                request.headers.get('X-Hermes-Plugin-Epoch'))
+            if selected.home != context['home'] or selected.connection != context['host_incarnation']:
+                raise ValueError('STALE_SCOPE')
+    except ValueError as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from None
+    return {**context, 'selection': asdict(selected)}
+
+
+
+def authenticated_context(request):
+    from hermes_cli.web_server import _has_valid_session_token
+
+    principal = getattr(request.state, 'token_principal', None)
+    session = getattr(request.state, 'session', None)
+    if getattr(request.state, 'token_authenticated', False) and principal is not None:
+        identity = (principal.provider, principal.principal)
+    elif session is not None:
+        identity = (session.provider, session.user_id)
+    elif _has_valid_session_token(request):
+        identity = ('local-session', _PROCESS_INCARNATION)
+    else:
+        raise HTTPException(status_code=401, detail='Unauthorized')
+    home = str(get_hermes_home().resolve())
+    digest = hashlib.sha256(('\0'.join(identity)).encode()).hexdigest()
+    return {'version': 1, 'principal': digest, 'home': home,
+            'host_incarnation': _PROCESS_INCARNATION}
