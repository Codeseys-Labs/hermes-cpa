+def test_native_query_budget_preserves_controls_large_values_and_256_pairs(harness):
+    query = 'value=' + 'x' * 9000 + '&empty=&control=%00%0A%0D&' + '&'.join('x=' for _ in range(253))
+    assert fetch(harness, query=query).status_code == 200
