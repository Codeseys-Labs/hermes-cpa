+func TestHermesConfigCommitAndRevisionHeaders(t *testing.T) {
+	path := writeFixture(t, prepareFixtureYAML)
+	h, router := newConfigV8Router(t, path)
+	reloads := make(chan *config.Config, 4)
+	h.SetConfigReloadHook(func(_ context.Context, cfg *config.Config) { reloads <- cfg })
+	base, _ := os.ReadFile(path)
+	revision := ConfigRevision(base)
+
+	controlRequest := func(method, url string, body string) *http.Request {
+		req := httptest.NewRequest(method, url, strings.NewReader(body))
+		return req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))
+	}
+	publicGet := httptest.NewRecorder()
+	router.ServeHTTP(publicGet, httptest.NewRequest(http.MethodGet, "/v8/management/config", nil))
+	if publicGet.Code != http.StatusOK || publicGet.Header().Get(hermesowner.ConfigRevisionHeader) != "" {
+		t.Fatalf("public GET must stay native: status=%d revision=%q", publicGet.Code, publicGet.Header().Get(hermesowner.ConfigRevisionHeader))
+	}
+	for _, url := range []string{"/v8/management/config", "/v8/management/config.yaml", "/v8/management/config/server"} {
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, controlRequest(http.MethodGet, url, ""))
+		if recorder.Code != http.StatusOK || recorder.Header().Get(hermesowner.ConfigRevisionHeader) != revision {
+			t.Fatalf("%s: status=%d revision=%q want %s", url, recorder.Code, recorder.Header().Get(hermesowner.ConfigRevisionHeader), revision)
+		}
+	}
+	// An absent wildcard path still reports the snapshot revision so a client can
+	// read-modify-write a default without a second snapshot.
+	missing := httptest.NewRecorder()
+	router.ServeHTTP(missing, controlRequest(http.MethodGet, "/v8/management/config/plugins/configs/absent", ""))
+	if missing.Code != http.StatusNotFound || missing.Header().Get(hermesowner.ConfigRevisionHeader) != revision {
+		t.Fatalf("not_found: status=%d revision=%q want %s", missing.Code, missing.Header().Get(hermesowner.ConfigRevisionHeader), revision)
+	}
+
+	prepareBody, _ := json.Marshal(ConfigV8PrepareRequest{ExpectedRevision: revision, Requests: []ConfigV8Request{
+		{Method: "PUT", Path: "/v8/management/config/routing/retry/request-retry", BodyBase64: b64(`7`)},
+	}})
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, controlRequest(http.MethodPost, "/hermes/config/prepare", string(prepareBody)))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("prepare: status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+	var candidate ConfigV8Candidate
+	if err := json.Unmarshal(recorder.Body.Bytes(), &candidate); err != nil {
+		t.Fatal(err)
+	}
+	if after, _ := os.ReadFile(path); !bytes.Equal(after, base) {
+		t.Fatal("prepare endpoint wrote to the configuration file")
+	}
+
+	commit := func(expected, candidateRevision, candidateBase64 string) *httptest.ResponseRecorder {
+		body, _ := json.Marshal(ConfigV8CommitRequest{ExpectedRevision: expected, CandidateRevision: candidateRevision, CandidateBase64: candidateBase64})
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, controlRequest(http.MethodPost, "/hermes/config/commit", string(body)))
+		return recorder
+	}
+	if resp := commit("stale", candidate.CandidateRevision, candidate.CandidateBase64); resp.Code != http.StatusConflict || !strings.Contains(resp.Body.String(), ConfigV8CodeStaleRevision) {
+		t.Fatalf("stale commit: status=%d body=%s", resp.Code, resp.Body.String())
+	}
+	if resp := commit(revision, "0000", candidate.CandidateBase64); resp.Code != http.StatusBadRequest || !strings.Contains(resp.Body.String(), ConfigV8CodeCandidateMismatch) {
+		t.Fatalf("mismatched commit: status=%d body=%s", resp.Code, resp.Body.String())
+	}
+	restart, problem := PrepareConfigV8(base, ConfigV8PrepareRequest{ExpectedRevision: revision, Requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/server/port", BodyBase64: b64(`9000`)}}})
+	if problem != nil {
+		t.Fatalf("restart candidate: %+v", problem)
+	}
+	if resp := commit(revision, restart.CandidateRevision, restart.CandidateBase64); resp.Code != http.StatusConflict || !strings.Contains(resp.Body.String(), ConfigV8CodeRestartRequired) {
+		t.Fatalf("restart-required commit must be refused: status=%d body=%s", resp.Code, resp.Body.String())
+	}
+	if after, _ := os.ReadFile(path); !bytes.Equal(after, base) {
+		t.Fatal("refused commits must not write")
+	}
+	originalFile, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp := commit(revision, candidate.CandidateRevision, candidate.CandidateBase64)
+	if resp.Code != http.StatusOK || !strings.Contains(resp.Body.String(), candidate.CandidateRevision) {
+		t.Fatalf("commit: status=%d body=%s", resp.Code, resp.Body.String())
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(after, decodeCandidate(t, &candidate)) {
+		t.Fatalf("commit must persist the exact candidate bytes:\n%s", after)
+	}
+	updatedFile, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !os.SameFile(originalFile, updatedFile) {
+		t.Fatal("commit replaced the configuration inode")
+	}
+	select {
+	case cfg := <-reloads:
+		if cfg.RequestRetry != 7 {
+			t.Fatalf("reload received stale config: %+v", cfg)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("commit did not trigger the native reload hook")
+	}
+	if resp := commit(revision, candidate.CandidateRevision, candidate.CandidateBase64); resp.Code != http.StatusConflict {
+		t.Fatalf("replaying a commit against the old revision must conflict: status=%d", resp.Code)
+	}
+}
