+// routePatternMatches mirrors router matching for a registered pattern:
+// a :param segment matches one non-empty segment, a *wildcard segment
+// matches the rest, every other segment must be identical.
+func routePatternMatches(pattern, path string) bool {
+	patternSegments := strings.Split(strings.Trim(pattern, "/"), "/")
