+func TestPrepareConfigV8ReportsNativeFailuresAndNeverWrites(t *testing.T) {
+	path := writeFixture(t, prepareFixtureYAML)
+	base, _ := os.ReadFile(path)
+	revision := ConfigRevision(base)
+	for name, tc := range map[string]struct {
+		expected string
+		requests []ConfigV8Request
+		status   int
+		code     string
+		native   string
+		index    int
+	}{
+		"stale revision": {expected: "deadbeef", requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/requests/proxy-url", BodyBase64: b64(`"direct"`)}}, status: 409, code: ConfigV8CodeStaleRevision, native: "stale_revision", index: -1},
+		"no requests":    {expected: revision, status: 400, code: ConfigV8CodeInvalidRequest, native: "invalid_body", index: -1},
+		"foreign path":   {expected: revision, requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/credentials", BodyBase64: b64(`{}`)}}, status: 400, code: ConfigV8CodeInvalidRequest, native: "invalid_path", index: 0},
+		"get method":     {expected: revision, requests: []ConfigV8Request{{Method: "GET", Path: "/v8/management/config"}}, status: 400, code: ConfigV8CodeInvalidRequest, native: "invalid_method", index: 0},
+		"delete root":    {expected: revision, requests: []ConfigV8Request{{Method: "DELETE", Path: "/v8/management/config"}}, status: 400, code: ConfigV8CodeInvalidRequest, native: "invalid_method", index: 0},
+		"invalid value in second request": {expected: revision, requests: []ConfigV8Request{
+			{Method: "PUT", Path: "/v8/management/config/requests/proxy-url", BodyBase64: b64(`"direct"`)},
+			{Method: "PATCH", Path: "/v8/management/config", BodyBase64: b64(`{"server":{"port":"invalid"}}`)},
+		}, status: 422, code: ConfigV8CodeInvalidConfig, native: "invalid_config", index: 1},
+		"unknown field":   {expected: revision, requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/server/unknown-option", BodyBase64: b64(`true`)}}, status: 400, code: ConfigV8CodeInvalidConfig, native: "invalid_config", index: 0},
+		"read only field": {expected: revision, requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/credentials/concurrency/lifecycle-config-revision", BodyBase64: b64(`999`)}}, status: 400, code: ConfigV8CodeReadOnlyField, native: "read_only_field", index: 0},
+		"delete missing":  {expected: revision, requests: []ConfigV8Request{{Method: "DELETE", Path: "/v8/management/config/requests/nothing-here"}}, status: 404, code: ConfigV8CodeNotFound, native: "not_found", index: 0},
+		"invalid json":    {expected: revision, requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/requests/proxy-url", BodyBase64: b64(`{not json`)}}, status: 400, code: ConfigV8CodeInvalidConfig, native: "invalid_json", index: 0},
+		"bad base64":      {expected: revision, requests: []ConfigV8Request{{Method: "PUT", Path: "/v8/management/config/requests/proxy-url", BodyBase64: "!!!"}}, status: 400, code: ConfigV8CodeInvalidRequest, native: "invalid_body", index: 0},
+	} {
+		t.Run(name, func(t *testing.T) {
+			candidate, problem := PrepareConfigV8(base, ConfigV8PrepareRequest{ExpectedRevision: tc.expected, Requests: tc.requests})
+			if candidate != nil || problem == nil {
+				t.Fatalf("expected a problem, got candidate=%+v", candidate)
+			}
+			if problem.Status != tc.status || problem.Code != tc.code || problem.Native != tc.native {
+				t.Fatalf("problem=%+v want status=%d code=%s error=%s", problem, tc.status, tc.code, tc.native)
+			}
+			if tc.index >= 0 && (problem.RequestIndex == nil || *problem.RequestIndex != tc.index) {
+				t.Fatalf("request_index=%v want %d", problem.RequestIndex, tc.index)
+			}
+			if tc.code == ConfigV8CodeStaleRevision && problem.BaseRevision != revision {
+				t.Fatalf("stale revision must report base_revision, got %+v", problem)
+			}
+			if tc.code == ConfigV8CodeReadOnlyField && problem.Field != "credentials/concurrency/lifecycle-config-revision" {
+				t.Fatalf("read only field must name the field, got %+v", problem)
+			}
+			if problem.Message != "" && strings.Contains(problem.Message, "sk-") {
+				t.Fatalf("problem message reflects secret input: %s", problem.Message)
+			}
+			if after, _ := os.ReadFile(path); string(after) != prepareFixtureYAML {
+				t.Fatal("failed prepare wrote to the configuration file")
+			}
+		})
+	}
+}
