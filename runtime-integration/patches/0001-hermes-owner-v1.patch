diff --git a/cmd/server/hermes_prepare.go b/cmd/server/hermes_prepare.go
new file mode 100644
index 0000000000000000000000000000000000000000..98507c1cfa9410755997d3e4311c553627a14c36
--- /dev/null
+++ b/cmd/server/hermes_prepare.go
@@ -0,0 +1,62 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/api/handlers/management"
+)
+
+// Exit codes of --hermes-prepare-config.
+const (
+	hermesPrepareExitOK       = 0
+	hermesPrepareExitInternal = 1
+	hermesPrepareExitInvalid  = 2
+	hermesPrepareExitStale    = 3
+)
+
+// runHermesPrepareConfig validates a Hermes config transaction from stdin against
+// the persisted file using the same native preparation the live control channel
+// uses. It never writes; a stopped instance can be configured through it.
+func runHermesPrepareConfig(configPath string, stdin io.Reader, stdout io.Writer) int {
+	encoder := json.NewEncoder(stdout)
+	var req management.ConfigV8PrepareRequest
+	if err := json.NewDecoder(stdin).Decode(&req); err != nil {
+		_ = encoder.Encode(management.ConfigV8Problem{
+			Status:  http.StatusBadRequest,
+			Code:    management.ConfigV8CodeInvalidRequest,
+			Native:  "invalid_body",
+			Message: "prepare request must be a JSON object on stdin",
+		})
+		return hermesPrepareExitInvalid
+	}
+	base, err := os.ReadFile(configPath)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		_ = encoder.Encode(management.ConfigV8Problem{
+			Status:  http.StatusInternalServerError,
+			Code:    management.ConfigV8CodeReadFailed,
+			Native:  "read_failed",
+			Message: "failed to read the configuration file",
+		})
+		return hermesPrepareExitInternal
+	}
+	candidate, problem := management.PrepareConfigV8(base, req)
+	if problem != nil {
+		_ = encoder.Encode(problem)
+		switch problem.Code {
+		case management.ConfigV8CodeStaleRevision:
+			return hermesPrepareExitStale
+		case management.ConfigV8CodeReadFailed, management.ConfigV8CodeWriteFailed:
+			return hermesPrepareExitInternal
+		default:
+			return hermesPrepareExitInvalid
+		}
+	}
+	if err = encoder.Encode(candidate); err != nil {
+		return hermesPrepareExitInternal
+	}
+	return hermesPrepareExitOK
+}
diff --git a/cmd/server/hermes_prepare_test.go b/cmd/server/hermes_prepare_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4eb02865c47230386e2e999ba5429d1f0925995d
--- /dev/null
+++ b/cmd/server/hermes_prepare_test.go
@@ -0,0 +1,77 @@
+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/api/handlers/management"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func TestRunHermesPrepareConfigOffline(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.yaml")
+	raw := "port: 8317\napi-keys: [client]\n"
+	if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	revision := management.ConfigRevision([]byte(raw))
+	request := func(expected string, requests ...management.ConfigV8Request) string {
+		body, _ := json.Marshal(management.ConfigV8PrepareRequest{ExpectedRevision: expected, Requests: requests})
+		return string(body)
+	}
+	put := management.ConfigV8Request{Method: "PUT", Path: "/v8/management/config/routing/retry/request-retry", BodyBase64: base64.StdEncoding.EncodeToString([]byte("4"))}
+
+	var stdout bytes.Buffer
+	if code := runHermesPrepareConfig(path, strings.NewReader(request(revision, put)), &stdout); code != hermesPrepareExitOK {
+		t.Fatalf("exit=%d stdout=%s", code, stdout.String())
+	}
+	var candidate management.ConfigV8Candidate
+	if err := json.Unmarshal(stdout.Bytes(), &candidate); err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := base64.StdEncoding.DecodeString(candidate.CandidateBase64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := config.ParseConfigBytes(decoded)
+	if err != nil || loaded.RequestRetry != 4 || loaded.Port != 8317 {
+		t.Fatalf("candidate=%s err=%v", decoded, err)
+	}
+	if candidate.BaseRevision != revision || candidate.CandidateRevision != management.ConfigRevision(decoded) {
+		t.Fatalf("revisions: %+v", candidate)
+	}
+	if after, _ := os.ReadFile(path); string(after) != raw {
+		t.Fatal("offline prepare wrote to the configuration file")
+	}
+
+	stdout.Reset()
+	if code := runHermesPrepareConfig(path, strings.NewReader(request("stale", put)), &stdout); code != hermesPrepareExitStale || !strings.Contains(stdout.String(), management.ConfigV8CodeStaleRevision) {
+		t.Fatalf("stale: exit=%d stdout=%s", code, stdout.String())
+	}
+	stdout.Reset()
+	invalid := management.ConfigV8Request{Method: "PUT", Path: "/v8/management/config/server/port", BodyBase64: base64.StdEncoding.EncodeToString([]byte(`"nope"`))}
+	if code := runHermesPrepareConfig(path, strings.NewReader(request(revision, invalid)), &stdout); code != hermesPrepareExitInvalid || !strings.Contains(stdout.String(), management.ConfigV8CodeInvalidConfig) {
+		t.Fatalf("invalid: exit=%d stdout=%s", code, stdout.String())
+	}
+	stdout.Reset()
+	if code := runHermesPrepareConfig(path, strings.NewReader("not json"), &stdout); code != hermesPrepareExitInvalid || !strings.Contains(stdout.String(), management.ConfigV8CodeInvalidRequest) {
+		t.Fatalf("malformed stdin: exit=%d stdout=%s", code, stdout.String())
+	}
+
+	// A missing file is a first configuration against the empty revision.
+	stdout.Reset()
+	missing := filepath.Join(dir, "missing.yaml")
+	first := management.ConfigV8Request{Method: "PUT", Path: "/v8/management/config", BodyBase64: base64.StdEncoding.EncodeToString([]byte(`{"server":{"port":9000}}`))}
+	if code := runHermesPrepareConfig(missing, strings.NewReader(request(management.ConfigRevision(nil), first)), &stdout); code != hermesPrepareExitOK {
+		t.Fatalf("first configuration: exit=%d stdout=%s", code, stdout.String())
+	}
+	if _, err = os.Stat(missing); !os.IsNotExist(err) {
+		t.Fatal("offline prepare created the configuration file")
+	}
+}
