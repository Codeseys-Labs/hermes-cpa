+// startPluginCallbackListener binds an ephemeral loopback port and serves the
+// native callback for provider at callbackPath only.
+func startPluginCallbackListener(provider, authDir, callbackPath string) (*pluginCallbackListener, error) {
+	if strings.TrimSpace(authDir) == "" {
+		return nil, fmt.Errorf("auth dir is not configured")
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, fmt.Errorf("failed to listen on loopback: %w", err)
+	}
+	addr, okAddr := ln.Addr().(*net.TCPAddr)
+	if !okAddr {
+		_ = ln.Close()
+		return nil, fmt.Errorf("unexpected callback listener address %v", ln.Addr())
+	}
+	native := NativeOAuthCallbackHandler(authDir, provider)
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != callbackPath {
+			w.Header().Set("Cache-Control", "no-store")
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		native.ServeHTTP(w, r)
+	})
+	listener := &pluginCallbackListener{
+		provider:      provider,
+		port:          addr.Port,
+		baseURL:       fmt.Sprintf("http://127.0.0.1:%d%s", addr.Port, callbackPath),
+		watchInterval: pluginCallbackWatchInterval,
+		forwarder:     serveCallbackListener(ln, provider, handler),
+	}
+	log.Infof("plugin callback listener for %s listening on 127.0.0.1:%d", provider, addr.Port)
+	return listener, nil
+}
+
+// stop shuts the listener down; it is safe on nil and repeated calls.
+func (l *pluginCallbackListener) stop() {
+	if l == nil {
+		return
+	}
+	l.stopOnce.Do(func() { stopForwarderInstance(l.port, l.forwarder) })
+}
