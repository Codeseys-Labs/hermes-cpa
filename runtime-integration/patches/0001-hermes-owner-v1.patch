+func TestHermesOwnerAPICallEnforcesEgressPolicy(t *testing.T) {
+	var seenMu sync.Mutex
+	var seen []string
+	record := func(hop string) {
+		seenMu.Lock()
+		seen = append(seen, hop)
+		seenMu.Unlock()
+	}
+	outside := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		record("outside" + r.URL.Path)
+		_, _ = w.Write([]byte("leaked"))
+	}))
+	defer outside.Close()
+	approved := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		record("approved" + r.URL.Path + "|" + r.Host)
+		switch r.URL.Path {
+		case "/redirect-out":
+			http.Redirect(w, r, outside.URL+"/steal", http.StatusFound)
+		case "/redirect-in":
+			http.Redirect(w, r, "/final", http.StatusFound)
+		default:
+			_, _ = w.Write([]byte("approved-body"))
+		}
+	}))
+	defer approved.Close()
+	approvedURL, _ := url.Parse(approved.URL)
+	destination := `{"scheme":"http","host":"` + approvedURL.Hostname() + `","port":` + approvedURL.Port() + `}`
+	s, _ := newHermesOwnerServer(t, "port: 8317\nremote-management: {secret-key: test-password}\n")
+
+	call := func(channel hermesowner.Channel, headers map[string]string, body string) *httptest.ResponseRecorder {
+		return serve(s, channelRequest(channel, http.MethodPost, "/v8/management/requests/api-call", body, headers))
+	}
+	callBody := func(target string, extra string) string {
+		return `{"method":"GET","url":"` + target + `"` + extra + `}`
+	}
+	upstreamStatus := func(t *testing.T, recorder *httptest.ResponseRecorder) (int, string) {
+		t.Helper()
+		if recorder.Code != http.StatusOK {
+			t.Fatalf("api-call status=%d body=%s", recorder.Code, recorder.Body.String())
+		}
+		var resp struct {
+			StatusCode int    `json:"status_code"`
+			Body       string `json:"body"`
+		}
+		if err := json.Unmarshal(recorder.Body.Bytes(), &resp); err != nil {
+			t.Fatal(err)
+		}
+		return resp.StatusCode, resp.Body
+	}
+
+	// Public listener keeps native semantics: the owner header is ignored entirely.
+	denyAll := egressHeader(t, `{"version":1,"destinations":[{"scheme":"https","host":"nowhere.invalid"}]}`)
+	publicHeaders := map[string]string{"Authorization": "Bearer test-password", hermesowner.EgressPolicyHeader: denyAll}
+	if status, body := upstreamStatus(t, call(hermesowner.ChannelNone, publicHeaders, callBody(approved.URL+"/public", ""))); status != http.StatusOK || body != "approved-body" {
+		t.Fatalf("public api-call must ignore the owner header: %d %q", status, body)
+	}
+
+	// Control channel: no policy, invalid policy and unapproved destinations are all denied.
+	if got := call(hermesowner.ChannelControl, nil, callBody(approved.URL+"/x", "")); got.Code != http.StatusForbidden || !strings.Contains(got.Body.String(), "egress_policy_required") {
+		t.Fatalf("missing policy: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := call(hermesowner.ChannelControl, map[string]string{hermesowner.EgressPolicyHeader: "not-a-policy"}, callBody(approved.URL+"/x", "")); got.Code != http.StatusForbidden || !strings.Contains(got.Body.String(), "egress_policy_invalid") {
+		t.Fatalf("invalid policy: status=%d body=%s", got.Code, got.Body.String())
+	}
+	approvedOnly := map[string]string{hermesowner.EgressPolicyHeader: egressHeader(t, `{"version":1,"destinations":[`+destination+`],"methods":["GET"]}`)}
+	if got := call(hermesowner.ChannelControl, approvedOnly, callBody(outside.URL+"/x", "")); got.Code != http.StatusForbidden || !strings.Contains(got.Body.String(), "egress_policy_violation") {
+		t.Fatalf("unapproved destination: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := call(hermesowner.ChannelControl, approvedOnly, `{"method":"DELETE","url":"`+approved.URL+`/x"}`); got.Code != http.StatusForbidden {
+		t.Fatalf("unapproved method: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := call(hermesowner.ChannelControl, approvedOnly, callBody(approved.URL+"/x", `,"proxy_url":"socks5://127.0.0.1:1080"`)); got.Code != http.StatusForbidden {
+		t.Fatalf("request proxy without approval: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := call(hermesowner.ChannelControl, approvedOnly, callBody(approved.URL+"/x", `,"header":{"Authorization":"Bearer $TOKEN$"}`)); got.Code != http.StatusForbidden || !strings.Contains(got.Body.String(), "egress_policy_token_denied") {
+		t.Fatalf("token substitution without approval: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := call(hermesowner.ChannelControl, approvedOnly, callBody(approved.URL+"/x", `,"header":{"Host":"other.example"}`)); got.Code != http.StatusForbidden {
+		t.Fatalf("Host override without approval: status=%d body=%s", got.Code, got.Body.String())
+	}
+
+	// Approved call succeeds; redirects are returned, not followed, by default.
+	if status, body := upstreamStatus(t, call(hermesowner.ChannelControl, approvedOnly, callBody(approved.URL+"/plain", ""))); status != http.StatusOK || body != "approved-body" {
+		t.Fatalf("approved call: %d %q", status, body)
+	}
+	if status, _ := upstreamStatus(t, call(hermesowner.ChannelControl, approvedOnly, callBody(approved.URL+"/redirect-out", ""))); status != http.StatusFound {
+		t.Fatalf("redirect must be returned unfollowed in deny mode: %d", status)
+	}
+
+	// Following redirects stays inside the approved destinations at the transport.
+	follow := map[string]string{hermesowner.EgressPolicyHeader: egressHeader(t, `{"version":1,"destinations":[`+destination+`],"redirects":"allowed","host_header":["quota.example"]}`)}
+	if got := call(hermesowner.ChannelControl, follow, callBody(approved.URL+"/redirect-out", "")); got.Code != http.StatusForbidden || !strings.Contains(got.Body.String(), "egress_policy_violation") {
+		t.Fatalf("redirect to an unapproved host: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if status, body := upstreamStatus(t, call(hermesowner.ChannelControl, follow, callBody(approved.URL+"/redirect-in", ""))); status != http.StatusOK || body != "approved-body" {
+		t.Fatalf("approved redirect: %d %q", status, body)
+	}
+	if status, _ := upstreamStatus(t, call(hermesowner.ChannelControl, follow, callBody(approved.URL+"/host", `,"header":{"Host":"quota.example"}`))); status != http.StatusOK {
+		t.Fatalf("listed Host override: %d", status)
+	}
+	seenMu.Lock()
+	hops := append([]string(nil), seen...)
+	seenMu.Unlock()
+	for _, hop := range hops {
+		if strings.HasPrefix(hop, "outside") {
+			t.Fatalf("an unapproved host was contacted: %v", hops)
+		}
+	}
+	if !strings.Contains(strings.Join(hops, ","), "approved/host|quota.example") {
+		t.Fatalf("approved Host override not applied: %v", hops)
+	}
+}
