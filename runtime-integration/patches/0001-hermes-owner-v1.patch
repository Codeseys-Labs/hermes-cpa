diff --git a/internal/pluginhost/dispatch_identity.go b/internal/pluginhost/dispatch_identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..31048c29430ecb113ec874274cbb26d0afbc7552
--- /dev/null
+++ b/internal/pluginhost/dispatch_identity.go
@@ -0,0 +1,303 @@
+package pluginhost
+
+import (
+	"context"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// dispatchIdentity is one plugin instance an owner review can reach: by
+// declared route (ManagementAPI registrar), by provider name (OAuth login
+// start) or by plugin id (fixed quota fetch/reset). Replacing the instance
+// behind the same id, path and version changes the registry incarnation as
+// soon as the snapshot moves, before any route table is rebuilt.
+type dispatchIdentity struct {
+	path       string
+	version    string
+	management pluginapi.ManagementAPI
+	auth       pluginapi.AuthProvider
+	quota      pluginapi.QuotaProvider
+}
+
+func (d dispatchIdentity) selectable() bool {
+	return d.auth != nil || d.quota != nil
+}
+
+func dispatchIdentitiesFromRecords(records []capabilityRecord) map[string]dispatchIdentity {
+	out := make(map[string]dispatchIdentity)
+	for _, record := range records {
+		capabilities := record.plugin.Capabilities
+		if capabilities.ManagementAPI == nil && capabilities.AuthProvider == nil && capabilities.QuotaProvider == nil {
+			continue
+		}
+		id := strings.TrimSpace(record.id)
+		if id == "" {
+			continue
+		}
+		out[id] = dispatchIdentity{
+			path:       cleanPluginPath(record.path),
+			version:    strings.TrimSpace(record.version),
+			management: capabilities.ManagementAPI,
+			auth:       capabilities.AuthProvider,
+			quota:      capabilities.QuotaProvider,
+		}
+	}
+	return out
+}
+
+// matches compares two identities with the given instance comparator.
+func (d dispatchIdentity) matches(other dispatchIdentity, same func(a, b any) bool) bool {
+	return d.path == other.path && d.version == other.version &&
+		same(d.management, other.management) &&
+		same(d.auth, other.auth) &&
+		same(d.quota, other.quota)
+}
+
+func dispatchIdentitiesEqual(a, b map[string]dispatchIdentity) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for id, left := range a {
+		right, ok := b[id]
+		if !ok || !left.matches(right, sameCapabilityInstance) {
+			return false
+		}
+	}
+	return true
+}
+
+// setDispatchIdentitiesLocked installs the dispatch-capable instance set and
+// advances the registry revision when it actually changed. Callers hold h.mu.
+func (h *Host) setDispatchIdentitiesLocked(records []capabilityRecord) {
+	next := dispatchIdentitiesFromRecords(records)
+	if !dispatchIdentitiesEqual(h.dispatchIdentities, next) {
+		h.routeRegistryRevision++
+	}
+	h.dispatchIdentities = next
+}
+
+// dispatchInstanceCurrent reports whether the capability instances of a
+// captured record are still the active ones for its plugin id, so a captured
+// call refuses once the plugin was replaced behind the same id, path and
+// version instead of running retired code.
+func (h *Host) dispatchInstanceCurrent(record capabilityRecord) bool {
+	if h == nil {
+		return false
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if _, fused := h.fused[record.id]; fused || !h.pluginIdentityCurrentLocked(record.id, record.path, record.version) {
+		return false
+	}
+	identity, ok := h.dispatchIdentities[strings.TrimSpace(record.id)]
+	if !ok {
+		return false
+	}
+	capabilities := record.plugin.Capabilities
+	return identity.matches(dispatchIdentity{
+		path:       cleanPluginPath(record.path),
+		version:    strings.TrimSpace(record.version),
+		management: capabilities.ManagementAPI,
+		auth:       capabilities.AuthProvider,
+		quota:      capabilities.QuotaProvider,
+	}, capabilityInstanceActive)
+}
+
+// sameCapabilityInstance reports whether two capability values are provably
+// the same instance. RPC plugins register adapter pointers (or small structs
+// embedding one), so a reloaded plugin behind the same id is a different
+// value. Values whose identity cannot be proven (func values, other
+// non-comparable kinds) are treated as changed, which only ever advances the
+// incarnation.
+func sameCapabilityInstance(a, b any) bool {
+	same, provable := compareCapabilityInstances(a, b)
+	return provable && same
+}
+
+// capabilityInstanceActive reports whether a captured capability value is the
+// active one. Identity that cannot be proven is assumed unchanged: such values
+// never come from RPC plugins, and refusing them would stop dispatch entirely.
+func capabilityInstanceActive(active, captured any) bool {
+	same, provable := compareCapabilityInstances(active, captured)
+	return same || !provable
+}
+
+// compareCapabilityInstances reports whether a and b are the same instance
+// and whether that could be decided at all.
+func compareCapabilityInstances(a, b any) (same bool, provable bool) {
+	if a == nil || b == nil {
+		return a == nil && b == nil, true
+	}
+	valueA, valueB := reflect.ValueOf(a), reflect.ValueOf(b)
+	if valueA.Type() != valueB.Type() {
+		return false, true
+	}
+	if valueA.Kind() == reflect.Pointer {
+		return valueA.Pointer() == valueB.Pointer(), true
+	}
+	if !valueA.Comparable() || !valueB.Comparable() {
+		return false, false
+	}
+	return valueA.Equal(valueB), true
+}
+
+// RegisteredPluginDispatch describes one plugin instance an owner may select
+// outside the route tables. OAuthProvider is the canonical provider name the
+// login routes accept and is set only on the plugin native resolution picks
+// for that name; Quota reports a quota provider reachable by plugin id.
+type RegisteredPluginDispatch struct {
+	PluginID      string `json:"plugin_id"`
+	OAuthProvider string `json:"oauth_provider,omitempty"`
+	Quota         bool   `json:"quota"`
+}
+
+type dispatchCandidate struct {
+	id       string
+	identity dispatchIdentity
+}
+
+// dispatchCandidatesLocked lists the instances an owner can select by id or
+// provider name that are current and not fused, in native resolution order
+// (priority descending, then id). Callers hold h.mu.
+func (h *Host) dispatchCandidatesLocked() []dispatchCandidate {
+	snap, _ := h.snapshot.Load().(*Snapshot)
+	if snap == nil {
+		return nil
+	}
+	out := make([]dispatchCandidate, 0, len(h.dispatchIdentities))
+	for _, record := range snap.records {
+		identity, ok := h.dispatchIdentities[record.id]
+		if !ok || !identity.selectable() || !h.routeRecordDispatchableLocked(record.id, record.path, record.version) {
+			continue
+		}
+		out = append(out, dispatchCandidate{id: record.id, identity: identity})
+	}
+	return out
+}
+
+// registeredDispatches resolves provider names for candidates outside the
+// registry lock. The result belongs to the revision the candidates were
+// captured under; the caller re-checks it.
+func (h *Host) registeredDispatches(candidates []dispatchCandidate) []RegisteredPluginDispatch {
+	out := make([]RegisteredPluginDispatch, 0, len(candidates))
+	claimed := make(map[string]struct{}, len(candidates))
+	for _, candidate := range candidates {
+		entry := RegisteredPluginDispatch{PluginID: candidate.id, Quota: candidate.identity.quota != nil}
+		if candidate.identity.auth != nil {
+			if identifier, ok := h.callAuthProviderIdentifier(candidate.id, candidate.identity.auth); ok && identifier != "" {
+				if _, taken := claimed[identifier]; !taken {
+					claimed[identifier] = struct{}{}
+					entry.OAuthProvider = identifier
+				}
+			}
+		}
+		out = append(out, entry)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].PluginID < out[j].PluginID })
+	return out
+}
+
+// PluginDispatch is a plugin instance captured under the registry lock for an
+// owner-reviewed call. Only that instance can run; once it is no longer
+// current the call reports no invocation instead of switching implementation.
+type PluginDispatch struct {
+	record capabilityRecord
+}
+
+// PluginID names the captured instance.
+func (d PluginDispatch) PluginID() string { return d.record.id }
+
+// DispatchOutcome is the host-owned truth about one captured plugin call.
+type DispatchOutcome struct {
+	// Invoked reports whether plugin code ran; a panic counts because the
+	// plugin's effects may already have happened.
+	Invoked bool
+	// Handled mirrors the native result: false when the instance was no
+	// longer current or the plugin panicked.
+	Handled bool
+}
+
+// RegistryRevision reads the current incarnation under the registry lock.
+func (h *Host) RegistryRevision() string {
+	if h == nil {
+		return "none-0"
+	}
+	return h.currentRouteRegistryRevision()
+}
+
+// CaptureQuotaProvider resolves the quota provider instance for pluginID
+// together with the incarnation, under one lock hold.
+func (h *Host) CaptureQuotaProvider(pluginID string) (dispatch PluginDispatch, revision string, ok bool) {
+	if h == nil {
+		return PluginDispatch{}, "none-0", false
+	}
+	pluginID = strings.TrimSpace(pluginID)
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	revision = h.routeRegistryRevisionLocked()
+	if pluginID == "" {
+		return PluginDispatch{}, revision, false
+	}
+	snap, _ := h.snapshot.Load().(*Snapshot)
+	if snap == nil {
+		return PluginDispatch{}, revision, false
+	}
+	for _, record := range snap.records {
+		if record.id != pluginID || record.plugin.Capabilities.QuotaProvider == nil {
+			continue
+		}
+		if !h.routeRecordDispatchableLocked(record.id, record.path, record.version) {
+			continue
+		}
+		return PluginDispatch{record: record}, revision, true
+	}
+	return PluginDispatch{}, revision, false
+}
+
+// CaptureAuthProvider resolves the plugin auth provider for provider together
+// with the incarnation. The candidate instances are taken under one lock hold
+// in native resolution order; their identifiers are read afterwards, and the
+// first match is the captured instance, exactly as native resolution picks it.
+func (h *Host) CaptureAuthProvider(provider string) (dispatch PluginDispatch, revision string, ok bool) {
+	if h == nil {
+		return PluginDispatch{}, "none-0", false
+	}
+	provider = normalizeProviderID(provider)
+	h.mu.Lock()
+	revision = h.routeRegistryRevisionLocked()
+	var candidates []capabilityRecord
+	if snap, _ := h.snapshot.Load().(*Snapshot); snap != nil && provider != "" {
+		for _, record := range snap.records {
+			if record.plugin.Capabilities.AuthProvider == nil || !h.routeRecordDispatchableLocked(record.id, record.path, record.version) {
+				continue
+			}
+			candidates = append(candidates, record)
+		}
+	}
+	h.mu.Unlock()
+	for _, record := range candidates {
+		identifier, okIdentifier := h.callAuthProviderIdentifier(record.id, record.plugin.Capabilities.AuthProvider)
+		if okIdentifier && identifier == provider {
+			return PluginDispatch{record: record}, revision, true
+		}
+	}
+	return PluginDispatch{}, revision, false
+}
+
+// StartLoginCaptured runs StartLogin on the captured instance only.
+func (h *Host) StartLoginCaptured(ctx context.Context, dispatch PluginDispatch, provider, baseURL string, metadata map[string]any) (pluginapi.AuthLoginStartResponse, DispatchOutcome, error) {
+	return h.startLoginForRecord(ctx, dispatch.record, provider, baseURL, metadata)
+}
+
+// FetchQuotaCaptured runs FetchQuota on the captured instance only.
+func (h *Host) FetchQuotaCaptured(ctx context.Context, dispatch PluginDispatch, req pluginapi.QuotaFetchRequest) (pluginapi.QuotaFetchResponse, DispatchOutcome, error) {
+	return h.fetchQuotaForRecord(ctx, dispatch.record, req)
+}
+
+// ResetQuotaCaptured runs ResetQuota on the captured instance only.
+func (h *Host) ResetQuotaCaptured(ctx context.Context, dispatch PluginDispatch, req pluginapi.QuotaResetRequest) (pluginapi.QuotaResetResponse, DispatchOutcome, error) {
+	return h.resetQuotaForRecord(ctx, dispatch.record, req)
+}
diff --git a/internal/pluginhost/dispatch_identity_test.go b/internal/pluginhost/dispatch_identity_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1695585f8a7944f397497978d55fcef0cf953f95
--- /dev/null
+++ b/internal/pluginhost/dispatch_identity_test.go
@@ -0,0 +1,232 @@
+package pluginhost
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func quotaOnlyRecord(id string, priority int, provider pluginapi.QuotaProvider) capabilityRecord {
+	return capabilityRecord{
+		id:       id,
+		priority: priority,
+		meta:     pluginapi.Metadata{Name: id, Version: "1.0.0", Author: "test"},
+		plugin:   pluginapi.Plugin{Capabilities: pluginapi.Capabilities{QuotaProvider: provider}},
+	}
+}
+
+func authOnlyRecord(id string, priority int, provider pluginapi.AuthProvider) capabilityRecord {
+	return capabilityRecord{
+		id:       id,
+		priority: priority,
+		meta:     pluginapi.Metadata{Name: id, Version: "1.0.0", Author: "test"},
+		plugin:   pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: provider}},
+	}
+}
+
+// A plugin that owns no route but exposes a quota or auth provider is part of
+// the registry incarnation: replacing it behind the same id, path and version
+// changes the revision, and the catalog lists it under that revision.
+func TestRegistryRevisionTracksRouteLessPluginIdentity(t *testing.T) {
+	quotaA := &testQuotaProvider{identifier: "metered"}
+	host := newHostWithRecords(quotaOnlyRecord("meter", 1, quotaA))
+	listed := host.RegisteredManagementRoutes()
+	if !registryRevisionPattern.MatchString(listed.Revision) || len(listed.Management) != 0 || len(listed.Resources) != 0 {
+		t.Fatalf("registry = %+v", listed)
+	}
+	if want := []RegisteredPluginDispatch{{PluginID: "meter", Quota: true}}; !reflect.DeepEqual(listed.Dispatches, want) {
+		t.Fatalf("dispatches = %+v want %+v", listed.Dispatches, want)
+	}
+
+	// Re-installing the identical instance set is not a change.
+	setHostSnapshotForTest(host, true, quotaOnlyRecord("meter", 1, quotaA))
+	if again := host.RegisteredManagementRoutes(); again.Revision != listed.Revision {
+		t.Fatalf("identical snapshot changed the revision: %s -> %s", listed.Revision, again.Revision)
+	}
+
+	// Same id, path, version and shape, but replacement code: a new incarnation.
+	quotaB := &testQuotaProvider{identifier: "metered"}
+	setHostSnapshotForTest(host, true, quotaOnlyRecord("meter", 1, quotaB))
+	replaced := host.RegisteredManagementRoutes()
+	if replaced.Revision == listed.Revision {
+		t.Fatal("route-less same-id replacement must advance the revision")
+	}
+	if !reflect.DeepEqual(replaced.Dispatches, listed.Dispatches) {
+		t.Fatalf("dispatch shape changed on replacement: %+v", replaced.Dispatches)
+	}
+
+	// Fusing and unfusing a route-less plugin are changes; the fused plugin is
+	// not listed.
+	host.fusePlugin("meter", "QuotaProvider.FetchQuota", "boom")
+	fused := host.RegisteredManagementRoutes()
+	if fused.Revision == replaced.Revision || len(fused.Dispatches) != 0 {
+		t.Fatalf("fused registry = %+v (previous %s)", fused, replaced.Revision)
+	}
+	host.mu.Lock()
+	host.clearPluginFusedLocked("meter")
+	host.mu.Unlock()
+	restored := host.RegisteredManagementRoutes()
+	if restored.Revision == fused.Revision || len(restored.Dispatches) != 1 {
+		t.Fatalf("restored registry = %+v (previous %s)", restored, fused.Revision)
+	}
+
+	// Adding an auth provider plugin and removing the quota plugin are changes.
+	sso := &fakeAuthProvider{identifier: " Custom-SSO "}
+	setHostSnapshotForTest(host, true, quotaOnlyRecord("meter", 1, quotaB), authOnlyRecord("login", 1, sso))
+	both := host.RegisteredManagementRoutes()
+	if both.Revision == restored.Revision {
+		t.Fatal("adding a provider plugin must advance the revision")
+	}
+	if want := []RegisteredPluginDispatch{{PluginID: "login", OAuthProvider: "custom-sso"}, {PluginID: "meter", Quota: true}}; !reflect.DeepEqual(both.Dispatches, want) {
+		t.Fatalf("dispatches = %+v want %+v", both.Dispatches, want)
+	}
+	setHostSnapshotForTest(host, true, authOnlyRecord("login", 1, sso))
+	removed := host.RegisteredManagementRoutes()
+	if removed.Revision == both.Revision || len(removed.Dispatches) != 1 || removed.Dispatches[0].PluginID != "login" {
+		t.Fatalf("removed registry = %+v (previous %s)", removed, both.Revision)
+	}
+
+	// Plugins without any dispatchable capability never influence the revision.
+	setHostSnapshotForTest(host, true, authOnlyRecord("login", 1, sso), capabilityRecord{id: "silent", meta: pluginapi.Metadata{Name: "silent", Version: "1.0.0"}, plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{UsagePlugin: testUsageCapability{}}}})
+	if silent := host.RegisteredManagementRoutes(); silent.Revision != removed.Revision || len(silent.Dispatches) != 1 {
+		t.Fatalf("silent plugin changed the registry: %+v (previous %s)", silent, removed.Revision)
+	}
+}
+
+// The catalog names the OAuth provider only on the plugin native resolution
+// picks for that name, so a canonical name maps to exactly one plugin.
+func TestRegisteredDispatchesNameEffectiveOAuthOwnerOnly(t *testing.T) {
+	high := &fakeAuthProvider{identifier: "shared-sso"}
+	low := &fakeAuthProvider{identifier: "SHARED-SSO"}
+	host := newHostWithRecords(authOnlyRecord("zeta", 10, high), authOnlyRecord("alpha", 1, low))
+	listed := host.RegisteredManagementRoutes()
+	want := []RegisteredPluginDispatch{{PluginID: "alpha"}, {PluginID: "zeta", OAuthProvider: "shared-sso"}}
+	if !reflect.DeepEqual(listed.Dispatches, want) {
+		t.Fatalf("dispatches = %+v want %+v", listed.Dispatches, want)
+	}
