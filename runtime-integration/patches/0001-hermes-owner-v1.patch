+}
+
+func ownerPluginRoutes(t *testing.T, s *Server) ownerRegistry {
+	t.Helper()
+	routes := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/hermes/plugin-routes", "", nil))
+	var registry ownerRegistry
+	if err := json.Unmarshal(routes.Body.Bytes(), &registry); err != nil || routes.Code != http.StatusOK {
+		t.Fatalf("plugin routes: status=%d body=%s err=%v", routes.Code, routes.Body.String(), err)
+	}
+	if !ownerRegistryRevisionPattern.MatchString(registry.Revision) {
+		t.Fatalf("registry revision %q", registry.Revision)
+	}
