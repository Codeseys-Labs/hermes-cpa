diff --git a/internal/hermesowner/channel.go b/internal/hermesowner/channel.go
new file mode 100644
index 0000000000000000000000000000000000000000..31a7890dbc18dceb6d9ad71ffa9bec7db7cd6599
--- /dev/null
+++ b/internal/hermesowner/channel.go
@@ -0,0 +1,85 @@
+// Package hermesowner implements the private owner-only control and inference
+// channels used by the Hermes supervisor. Authority on these channels comes from
+// the Unix listener the connection arrived on and the verified peer process, never
+// from request headers or editable configuration keys.
+package hermesowner
+
+import "context"
+
+// Channel identifies the listener a request arrived on.
+type Channel int
+
+const (
+	// ChannelNone is the public TCP listener (native behaviour).
+	ChannelNone Channel = iota
+	// ChannelControl is the private management channel.
+	ChannelControl
+	// ChannelInference is the private inference-only channel.
+	ChannelInference
+)
+
+// String returns a stable identifier for logs and responses.
+func (c Channel) String() string {
+	switch c {
+	case ChannelControl:
+		return "control"
+	case ChannelInference:
+		return "inference"
+	default:
+		return "public"
+	}
+}
+
+const (
+	// Protocol is the owner protocol version reported by /hermes/health.
+	Protocol = 1
+	// Integration is the integration identifier reported by /hermes/health.
+	Integration = "hermes-owner-v1"
+	// EgressPolicyHeader carries the owner-only egress policy for api-call.
+	EgressPolicyHeader = "X-Hermes-Egress-Policy"
+	// ConfigRevisionHeader carries the SHA-256 of the exact on-disk config bytes.
+	ConfigRevisionHeader = "X-Hermes-Config-Revision"
+	// HeaderPrefix names the host-owned header namespace: plugins never receive
+	// or emit headers under it.
+	HeaderPrefix = "X-Hermes-"
+	// ResourceRevisionHeader asserts the reviewed plugin registry incarnation on
+	// a control-channel resource request; it is checked atomically with the
+	// route lookup and echoed with the incarnation that served the request.
+	ResourceRevisionHeader = "X-Hermes-Resource-Revision"
+	// ResourceInvokedHeader is the host-owned truth ("0" or "1") about whether a
+	// plugin resource handler was actually invoked for a control-channel request.
+	ResourceInvokedHeader = "X-Hermes-Resource-Invoked"
+	// PluginRevisionHeader asserts the reviewed plugin registry incarnation on a
+	// control-channel request for a declared plugin management route; it is
+	// checked atomically with the route lookup and echoed with the incarnation
+	// that served the request. It is distinct from ResourceRevisionHeader so a
+	// resource grant can never satisfy a management review or vice versa.
+	PluginRevisionHeader = "X-Hermes-Plugin-Revision"
+	// PluginInvokedHeader is the host-owned truth ("0" or "1") about whether a
+	// plugin management handler was actually invoked for a control-channel request.
+	PluginInvokedHeader = "X-Hermes-Plugin-Invoked"
+	// Principal is recorded as the API key principal for private inference requests.
+	Principal = "hermes-owner"
+)
+
+type channelContextKey struct{}
+
+// WithChannel marks ctx as belonging to the given private channel. Only the
+// private listeners' ConnContext attaches this value.
+func WithChannel(ctx context.Context, channel Channel) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, channelContextKey{}, channel)
+}
+
+// ChannelFromContext returns the channel recorded by WithChannel.
+func ChannelFromContext(ctx context.Context) Channel {
+	if ctx == nil {
+		return ChannelNone
+	}
+	if channel, ok := ctx.Value(channelContextKey{}).(Channel); ok {
+		return channel
+	}
+	return ChannelNone
+}
diff --git a/internal/hermesowner/egress.go b/internal/hermesowner/egress.go
new file mode 100644
index 0000000000000000000000000000000000000000..234e1ce69462b9d722bcb4bb657919fedc360143
--- /dev/null
+++ b/internal/hermesowner/egress.go
@@ -0,0 +1,321 @@
+package hermesowner
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// Egress policy schema v1 (owner-only, carried in EgressPolicyHeader as
+// base64url JSON). The owner computes it from an explicit approval; this package
+// only enforces it at the executing transport.
+
+const (
+	EgressPolicyVersion = 1
+
+	EgressRedirectsDeny    = "deny"
+	EgressRedirectsAllowed = "allowed"
+
+	EgressProxyConfigured = "configured"
+	EgressProxyDirect     = "direct"
+	EgressProxyExplicit   = "explicit"
+
+	egressDefaultMaxRedirects = 5
+	egressMaxRedirectsLimit   = 10
+)
+
+// ErrEgressDenied is returned by the transport when a hop violates the policy.
+var ErrEgressDenied = errors.New("egress denied by hermes owner policy")
+
+// EgressDestination is one approved upstream endpoint.
+type EgressDestination struct {
+	Scheme     string `json:"scheme"`
+	Host       string `json:"host"`
+	Port       int    `json:"port,omitempty"`
+	PathPrefix string `json:"path_prefix,omitempty"`
+}
+
+// EgressProxy constrains proxy selection for the call.
+type EgressProxy struct {
+	Mode string `json:"mode"`
+	URL  string `json:"url,omitempty"`
+}
+
+// EgressPolicy is the decoded policy. Zero values mean the most restrictive
+// interpretation.
+type EgressPolicy struct {
+	Version      int                 `json:"version"`
+	Destinations []EgressDestination `json:"destinations"`
+	Methods      []string            `json:"methods,omitempty"`
+	Redirects    string              `json:"redirects,omitempty"`
+	MaxRedirects int                 `json:"max_redirects,omitempty"`
+	HostHeader   []string            `json:"host_header,omitempty"`
+	Proxy        *EgressProxy        `json:"proxy,omitempty"`
+	AuthIndex    string              `json:"auth_index,omitempty"`
+	AllowToken   bool                `json:"allow_token,omitempty"`
+}
+
+// ParseEgressPolicy decodes and validates the header value.
+func ParseEgressPolicy(header string) (*EgressPolicy, error) {
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return nil, errors.New("empty egress policy")
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(header, "="))
+	if err != nil {
+		return nil, fmt.Errorf("egress policy is not base64url: %w", err)
+	}
+	var policy EgressPolicy
+	decoder := json.NewDecoder(strings.NewReader(string(raw)))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&policy); err != nil {
+		return nil, fmt.Errorf("egress policy is not valid JSON: %w", err)
+	}
+	if err = policy.normalize(); err != nil {
+		return nil, err
+	}
+	return &policy, nil
+}
+
+func (p *EgressPolicy) normalize() error {
+	if p.Version != EgressPolicyVersion {
+		return fmt.Errorf("unsupported egress policy version %d", p.Version)
+	}
+	if len(p.Destinations) == 0 {
+		return errors.New("egress policy has no destinations")
+	}
+	for i := range p.Destinations {
+		dest := &p.Destinations[i]
+		dest.Scheme = strings.ToLower(strings.TrimSpace(dest.Scheme))
+		dest.Host = strings.ToLower(strings.TrimSpace(dest.Host))
+		if dest.Scheme != "http" && dest.Scheme != "https" {
+			return fmt.Errorf("destination %d: scheme must be http or https", i)
+		}
+		if dest.Host == "" || strings.ContainsAny(dest.Host, "/:*?#@ ") {
+			return fmt.Errorf("destination %d: host must be an exact host name", i)
+		}
+		if dest.Port < 0 || dest.Port > 65535 {
+			return fmt.Errorf("destination %d: invalid port", i)
+		}
+		if dest.PathPrefix != "" && !strings.HasPrefix(dest.PathPrefix, "/") {
+			return fmt.Errorf("destination %d: path_prefix must start with /", i)
+		}
+	}
+	for i := range p.Methods {
+		p.Methods[i] = strings.ToUpper(strings.TrimSpace(p.Methods[i]))
+		if p.Methods[i] == "" {
+			return fmt.Errorf("methods[%d] is empty", i)
+		}
+	}
+	switch strings.ToLower(strings.TrimSpace(p.Redirects)) {
+	case "", EgressRedirectsDeny:
+		p.Redirects = EgressRedirectsDeny
+	case EgressRedirectsAllowed:
+		p.Redirects = EgressRedirectsAllowed
+	default:
+		return fmt.Errorf("redirects must be %q or %q", EgressRedirectsDeny, EgressRedirectsAllowed)
+	}
+	if p.MaxRedirects < 0 || p.MaxRedirects > egressMaxRedirectsLimit {
+		return fmt.Errorf("max_redirects must be between 0 and %d", egressMaxRedirectsLimit)
+	}
+	if p.MaxRedirects == 0 {
+		p.MaxRedirects = egressDefaultMaxRedirects
+	}
+	for i := range p.HostHeader {
+		p.HostHeader[i] = strings.ToLower(strings.TrimSpace(p.HostHeader[i]))
+		if p.HostHeader[i] == "" {
+			return fmt.Errorf("host_header[%d] is empty", i)
+		}
+	}
+	if p.Proxy == nil {
+		p.Proxy = &EgressProxy{Mode: EgressProxyConfigured}
+	}
+	p.Proxy.Mode = strings.ToLower(strings.TrimSpace(p.Proxy.Mode))
+	p.Proxy.URL = strings.TrimSpace(p.Proxy.URL)
+	switch p.Proxy.Mode {
+	case "":
+		p.Proxy.Mode = EgressProxyConfigured
+	case EgressProxyConfigured, EgressProxyDirect:
+	case EgressProxyExplicit:
+		if p.Proxy.URL == "" {
+			return errors.New("proxy.url is required for explicit proxy mode")
+		}
+	default:
+		return fmt.Errorf("proxy.mode must be %q, %q or %q", EgressProxyConfigured, EgressProxyDirect, EgressProxyExplicit)
+	}
+	p.AuthIndex = strings.TrimSpace(p.AuthIndex)
+	return nil
+}
+
+// AllowsMethod reports whether the HTTP method is permitted.
+func (p *EgressPolicy) AllowsMethod(method string) bool {
+	if len(p.Methods) == 0 {
+		return true
+	}
+	method = strings.ToUpper(strings.TrimSpace(method))
+	for _, allowed := range p.Methods {
+		if allowed == method {
+			return true
+		}
+	}
+	return false
+}
+
+// AllowsURL reports whether u matches one approved destination.
+func (p *EgressPolicy) AllowsURL(u *url.URL) bool {
+	if u == nil {
+		return false
+	}
+	scheme := strings.ToLower(u.Scheme)
+	host, port := splitHostPort(u.Host, scheme)
+	if host == "" || port == 0 {
+		return false
+	}
+	path := u.EscapedPath()
+	if path == "" {
+		path = "/"
+	}
+	for _, dest := range p.Destinations {
+		if dest.Scheme != scheme || dest.Host != host {
+			continue
+		}
+		destPort := dest.Port
+		if destPort == 0 {
+			destPort = defaultPort(dest.Scheme)
+		}
+		if destPort != port {
+			continue
+		}
+		if dest.PathPrefix != "" && !strings.HasPrefix(path, dest.PathPrefix) {
+			continue
+		}
+		return true
+	}
+	return false
+}
+
+// AllowsHostOverride reports whether a Host header differing from the URL host
+// is permitted.
+func (p *EgressPolicy) AllowsHostOverride(host string) bool {
+	host = strings.ToLower(strings.TrimSpace(host))
+	if host == "" {
+		return true
+	}
+	for _, allowed := range p.HostHeader {
+		if allowed == host {
+			return true
+		}
+	}
+	return false
+}
+
+// AllowsAuthIndex reports whether the requested credential may be used.
+func (p *EgressPolicy) AllowsAuthIndex(authIndex string) bool {
+	if p.AuthIndex == "" {
+		return true
+	}
+	return strings.TrimSpace(authIndex) == p.AuthIndex
+}
+
+// ResolveProxy validates the request proxy against the policy and returns the
+// proxy URL to use ("" = native configured selection) and whether the call must
+// bypass every proxy.
+func (p *EgressPolicy) ResolveProxy(requestProxyURL string) (proxyURL string, direct bool, err error) {
+	requested := strings.TrimSpace(requestProxyURL)
+	switch p.Proxy.Mode {
+	case EgressProxyDirect:
+		switch strings.ToLower(requested) {
+		case "", "direct", "none":
+			return "", true, nil
+		}
+		return "", false, fmt.Errorf("%w: proxy_url is not permitted in direct mode", ErrEgressDenied)
+	case EgressProxyExplicit:
+		if requested != p.Proxy.URL {
+			return "", false, fmt.Errorf("%w: proxy_url must equal the approved proxy", ErrEgressDenied)
+		}
+		return requested, false, nil
+	default:
+		if requested != "" {
+			return "", false, fmt.Errorf("%w: proxy_url is not permitted with configured proxies", ErrEgressDenied)
+		}
+		return "", false, nil
+	}
+}
+
+// CheckHop validates one outgoing request (initial or redirect) against the policy.
+func (p *EgressPolicy) CheckHop(req *http.Request) error {
+	if req == nil || req.URL == nil {
+		return fmt.Errorf("%w: missing request", ErrEgressDenied)
+	}
+	if !p.AllowsMethod(req.Method) {
+		return fmt.Errorf("%w: method %s not approved", ErrEgressDenied, req.Method)
+	}
+	if !p.AllowsURL(req.URL) {
+		return fmt.Errorf("%w: destination not approved", ErrEgressDenied)
+	}
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) && !p.AllowsHostOverride(req.Host) {
+		return fmt.Errorf("%w: host header override not approved", ErrEgressDenied)
+	}
+	return nil
+}
+
+// CheckRedirect is the http.Client redirect hook enforcing the redirect mode.
+func (p *EgressPolicy) CheckRedirect(req *http.Request, via []*http.Request) error {
+	if p.Redirects != EgressRedirectsAllowed {
+		return http.ErrUseLastResponse
+	}
+	if len(via) > p.MaxRedirects {
+		return fmt.Errorf("%w: too many redirects", ErrEgressDenied)
+	}
+	return p.CheckHop(req)
+}
+
+type egressTransport struct {
+	policy *EgressPolicy
+	next   http.RoundTripper
+}
+
+// Transport wraps next so every hop, including redirects, is re-checked at the
+// executing transport.
+func (p *EgressPolicy) Transport(next http.RoundTripper) http.RoundTripper {
+	if next == nil {
+		next = http.DefaultTransport
+	}
+	return &egressTransport{policy: p, next: next}
+}
+
+func (t *egressTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if err := t.policy.CheckHop(req); err != nil {
+		return nil, err
+	}
+	return t.next.RoundTrip(req)
+}
+
+func splitHostPort(hostport, scheme string) (string, int) {
+	host, portText, err := net.SplitHostPort(hostport)
+	if err != nil {
+		return strings.ToLower(strings.TrimSuffix(strings.TrimPrefix(hostport, "["), "]")), defaultPort(scheme)
+	}
+	port, errPort := strconv.Atoi(portText)
+	if errPort != nil || port <= 0 || port > 65535 {
+		return "", 0
+	}
+	return strings.ToLower(host), port
+}
+
+func defaultPort(scheme string) int {
+	switch scheme {
+	case "https":
+		return 443
+	case "http":
+		return 80
+	default:
+		return 0
+	}
+}
diff --git a/internal/hermesowner/egress_test.go b/internal/hermesowner/egress_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d98e786177385840ab4c366f2a055d5659c340b6
--- /dev/null
+++ b/internal/hermesowner/egress_test.go
@@ -0,0 +1,212 @@
+package hermesowner
+
+import (
+	"encoding/base64"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func encodePolicy(t *testing.T, raw string) string {
+	t.Helper()
+	return base64.RawURLEncoding.EncodeToString([]byte(raw))
+}
+
+func TestParseEgressPolicyRejectsUnusableInput(t *testing.T) {
+	for name, header := range map[string]string{
+		"empty":                 "",
+		"not base64":            "%%%",
+		"not json":              encodePolicy(t, "nope"),
+		"wrong version":         encodePolicy(t, `{"version":2,"destinations":[{"scheme":"https","host":"a"}]}`),
+		"no destinations":       encodePolicy(t, `{"version":1,"destinations":[]}`),
+		"bad scheme":            encodePolicy(t, `{"version":1,"destinations":[{"scheme":"ftp","host":"a"}]}`),
+		"wildcard host":         encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"*.a"}]}`),
+		"bad redirects":         encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"redirects":"follow"}`),
+		"too many redirects":    encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"max_redirects":11}`),
+		"explicit proxy no url": encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"proxy":{"mode":"explicit"}}`),
+		"unknown field":         encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"allow_everything":true}`),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := ParseEgressPolicy(header); err == nil {
+				t.Fatalf("expected %s to be rejected", name)
+			}
+		})
+	}
+}
+
+func TestParseEgressPolicyDefaultsAreRestrictive(t *testing.T) {
+	policy, err := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":[{"scheme":"HTTPS","host":"API.Example.com"}]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if policy.Redirects != EgressRedirectsDeny || policy.MaxRedirects != 5 || policy.Proxy.Mode != EgressProxyConfigured || policy.AllowToken {
+		t.Fatalf("unexpected defaults: %+v proxy=%+v", policy, policy.Proxy)
+	}
+	for rawURL, want := range map[string]bool{
+		"https://api.example.com/v1":    true,
+		"https://api.example.com:443/":  true,
+		"HTTPS://api.example.com/x?y=z": true,
+		"http://api.example.com/":       false,
+		"https://api.example.com:8443/": false,
+		"https://evil.example.com/":     false,
+		"https://api.example.com.evil/": false,
+		"https://user@api.example.com/": true,
+		"https://api.example.com@evil/": false,
+		"https://[::1]/":                false,
+	} {
+		u, errParse := url.Parse(rawURL)
+		if errParse != nil {
+			t.Fatal(errParse)
+		}
+		if got := policy.AllowsURL(u); got != want {
+			t.Errorf("AllowsURL(%s)=%v want %v", rawURL, got, want)
+		}
+	}
+	if policy.AllowsHostOverride("api.example.com") {
+		t.Fatal("host override must be denied unless listed")
+	}
+	if !policy.AllowsMethod("DELETE") {
+		t.Fatal("absent methods must allow any method")
+	}
+}
+
+func TestEgressPolicyPathPrefixPortAndMethods(t *testing.T) {
+	policy, err := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":[{"scheme":"http","host":"localhost","port":8080,"path_prefix":"/v1/"}],"methods":["get"],"host_header":["Quota.Example"]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	allowed, _ := url.Parse("http://localhost:8080/v1/quota")
+	denied, _ := url.Parse("http://localhost:8080/v2/quota")
+	otherPort, _ := url.Parse("http://localhost:8081/v1/quota")
+	if !policy.AllowsURL(allowed) || policy.AllowsURL(denied) || policy.AllowsURL(otherPort) {
+		t.Fatal("path prefix or port enforcement failed")
+	}
+	if !policy.AllowsMethod("GET") || policy.AllowsMethod("POST") {
+		t.Fatal("method allowlist not enforced")
+	}
+	if !policy.AllowsHostOverride("quota.example") || policy.AllowsHostOverride("other.example") {
+		t.Fatal("host header allowlist not enforced")
+	}
+}
+
+func TestEgressPolicyResolveProxy(t *testing.T) {
+	configured, _ := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}]}`))
+	direct, _ := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"proxy":{"mode":"direct"}}`))
+	explicit, _ := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":[{"scheme":"https","host":"a"}],"proxy":{"mode":"explicit","url":"socks5://127.0.0.1:1080"}}`))
+
+	if proxy, isDirect, err := configured.ResolveProxy(""); err != nil || proxy != "" || isDirect {
+		t.Fatalf("configured mode default: %q %v %v", proxy, isDirect, err)
+	}
+	if _, _, err := configured.ResolveProxy("http://proxy.example"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatal("configured mode must reject a request proxy")
+	}
+	for _, value := range []string{"", "direct", "NONE"} {
+		if _, isDirect, err := direct.ResolveProxy(value); err != nil || !isDirect {
+			t.Fatalf("direct mode %q: %v %v", value, isDirect, err)
+		}
+	}
+	if _, _, err := direct.ResolveProxy("socks5://127.0.0.1:1080"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatal("direct mode must reject a proxy url")
+	}
+	if proxy, _, err := explicit.ResolveProxy("socks5://127.0.0.1:1080"); err != nil || proxy != "socks5://127.0.0.1:1080" {
+		t.Fatalf("explicit mode: %q %v", proxy, err)
+	}
+	if _, _, err := explicit.ResolveProxy("socks5://127.0.0.1:1081"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatal("explicit mode must require the exact proxy")
+	}
+	if _, _, err := explicit.ResolveProxy(""); !errors.Is(err, ErrEgressDenied) {
+		t.Fatal("explicit mode must require the proxy to be supplied")
+	}
+}
+
+func TestEgressTransportEnforcesEveryHop(t *testing.T) {
+	outside := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte("outside"))
+	}))
+	defer outside.Close()
+	var hops []string
+	approved := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hops = append(hops, r.URL.Path+"|"+r.Host)
+		switch r.URL.Path {
+		case "/to-outside":
+			http.Redirect(w, r, outside.URL+"/leak", http.StatusFound)
+		case "/to-inside":
+			http.Redirect(w, r, "/final", http.StatusFound)
+		case "/loop":
+			http.Redirect(w, r, "/loop", http.StatusFound)
+		default:
+			_, _ = w.Write([]byte("inside"))
+		}
+	}))
+	defer approved.Close()
+	approvedURL, _ := url.Parse(approved.URL)
+	destinations := `[{"scheme":"http","host":"` + approvedURL.Hostname() + `","port":` + approvedURL.Port() + `}]`
+
+	denyPolicy, err := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":`+destinations+`}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	allowPolicy, err := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":`+destinations+`,"redirects":"allowed","max_redirects":2}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := func(policy *EgressPolicy) *http.Client {
+		return &http.Client{Transport: policy.Transport(http.DefaultTransport), CheckRedirect: policy.CheckRedirect}
+	}
+
+	resp, err := client(denyPolicy).Get(approved.URL + "/to-outside")
+	if err != nil {
+		t.Fatalf("deny mode must return the redirect itself: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusFound || !strings.Contains(resp.Header.Get("Location"), "/leak") {
+		t.Fatalf("deny mode: status=%d location=%q", resp.StatusCode, resp.Header.Get("Location"))
+	}
+
+	if _, err = client(allowPolicy).Get(approved.URL + "/to-outside"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatalf("redirect to an unapproved host must be denied, got %v", err)
+	}
+	for _, hop := range hops {
+		if strings.Contains(hop, "/leak") {
+			t.Fatal("unapproved redirect target was contacted")
+		}
+	}
+
+	resp, err = client(allowPolicy).Get(approved.URL + "/to-inside")
+	if err != nil {
+		t.Fatalf("approved redirect must be followed: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK || resp.Request.URL.Path != "/final" {
+		t.Fatalf("approved redirect: status=%d path=%s", resp.StatusCode, resp.Request.URL.Path)
+	}
+
+	if _, err = client(allowPolicy).Get(approved.URL + "/loop"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatalf("redirect loop must stop at max_redirects, got %v", err)
+	}
+
+	if _, err = client(allowPolicy).Get(outside.URL + "/direct"); !errors.Is(err, ErrEgressDenied) {
+		t.Fatalf("initial hop to an unapproved host must be denied, got %v", err)
+	}
+
+	req, _ := http.NewRequest(http.MethodGet, approved.URL+"/final", nil)
+	req.Host = "spoofed.example"
+	if _, err = client(allowPolicy).Do(req); !errors.Is(err, ErrEgressDenied) {
+		t.Fatalf("unlisted Host override must be denied, got %v", err)
+	}
+	hostPolicy, err := ParseEgressPolicy(encodePolicy(t, `{"version":1,"destinations":`+destinations+`,"host_header":["spoofed.example"]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err = client(hostPolicy).Do(req)
+	if err != nil {
+		t.Fatalf("listed Host override must pass: %v", err)
+	}
+	_ = resp.Body.Close()
+	if hops[len(hops)-1] != "/final|spoofed.example" {
+		t.Fatalf("Host override not applied: %v", hops)
+	}
+}
diff --git a/internal/hermesowner/markers.go b/internal/hermesowner/markers.go
new file mode 100644
index 0000000000000000000000000000000000000000..fe3bc34f74b3d6d61484a9ed77dee203da6ffa33
--- /dev/null
+++ b/internal/hermesowner/markers.go
@@ -0,0 +1,67 @@
+package hermesowner
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+)
+
+// SetPluginDispatchMarkers writes the host-owned truth for an owner-selected
+// plugin call on the control channel: whether plugin code ran and the registry
+// incarnation the lookup was bound to. Callers set them after any plugin
+// headers so a plugin can never override them; nothing is written on other
+// listeners.
+func SetPluginDispatchMarkers(header http.Header, ownerChannel bool, revision string, invoked bool) {
+	if !ownerChannel || header == nil {
+		return
+	}
+	invokedValue := "0"
+	if invoked {
+		invokedValue = "1"
+	}
+	header.Set(PluginInvokedHeader, invokedValue)
+	header.Set(PluginRevisionHeader, revision)
+}
+
+// WriteStalePluginRevision answers a control-channel request whose reviewed
+// registry incarnation no longer matches, or whose reviewed plugin instance
+// could no longer run: 412 with the current incarnation, no plugin code ran.
+func WriteStalePluginRevision(w http.ResponseWriter, revision string) error {
+	body, _ := json.Marshal(map[string]string{"error": "stale_plugin_revision", "registry_revision": revision})
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Type", "application/json; charset=utf-8")
+	SetPluginDispatchMarkers(w.Header(), true, revision, false)
+	w.WriteHeader(http.StatusPreconditionFailed)
+	_, err := w.Write(body)
+	return err
+}
+
+// PluginReview is a control-channel request's plugin registry assertion.
+type PluginReview struct {
+	// OwnerChannel reports whether the request arrived on the control channel;
+	// markers are written only then.
+	OwnerChannel bool
+	// Asserted reports whether PluginRevisionHeader was present.
+	Asserted bool
+	// Revision is the asserted incarnation; compared exactly by the host.
+	Revision string
+}
+
+// PluginReviewFromRequest reads the assertion. Other listeners drop the header
+// before routing, so it can only be asserted on the control channel.
+func PluginReviewFromRequest(r *http.Request) PluginReview {
+	if r == nil || ChannelFromContext(r.Context()) != ChannelControl {
+		return PluginReview{}
+	}
+	review := PluginReview{OwnerChannel: true}
+	if values, ok := r.Header[PluginRevisionHeader]; ok {
+		review.Asserted = true
+		review.Revision = strings.TrimSpace(strings.Join(values, ","))
+	}
+	return review
+}
+
+// Stale reports whether an asserted incarnation differs from the live one.
+func (p PluginReview) Stale(revision string) bool {
+	return p.Asserted && p.Revision != revision
+}
diff --git a/internal/hermesowner/options.go b/internal/hermesowner/options.go
new file mode 100644
index 0000000000000000000000000000000000000000..e69ef50d9e2534a9c725b6fef478220523fbfe89
--- /dev/null
+++ b/internal/hermesowner/options.go
@@ -0,0 +1,56 @@
+package hermesowner
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+)
+
+// ErrUnsupported is returned on platforms without Unix peer credential support.
+var ErrUnsupported = errors.New("hermes owner channels are only supported on linux")
+
+// Options are the command line settings for the private channels.
+type Options struct {
+	ControlSocket   string
+	InferenceSocket string
+	OwnerPID        int
+}
+
+// Requested reports whether any of the owner flags was supplied.
+func (o Options) Requested() bool {
+	return strings.TrimSpace(o.ControlSocket) != "" || strings.TrimSpace(o.InferenceSocket) != "" || o.OwnerPID != 0
+}
+
+// Validate requires the complete flag set so a partial configuration can never
+// start a half-private instance.
+func (o Options) Validate() error {
+	control := strings.TrimSpace(o.ControlSocket)
+	inference := strings.TrimSpace(o.InferenceSocket)
+	if control == "" || inference == "" || o.OwnerPID <= 0 {
+		return errors.New("--hermes-control-socket, --hermes-inference-socket and --hermes-owner-pid must be supplied together")
+	}
+	if control == inference {
+		return errors.New("--hermes-control-socket and --hermes-inference-socket must differ")
+	}
+	return nil
+}
+
+// Identity is the verified supervisor process identity every peer must match.
+type Identity struct {
+	PID       int
+	UID       uint32
+	StartTime uint64
+}
+
+// String never includes anything secret; it is safe for logs.
+func (id Identity) String() string {
+	return fmt.Sprintf("pid=%d uid=%d start=%d", id.PID, id.UID, id.StartTime)
+}
+
+// Listener yields only connections whose peer is the verified owner process.
+type Listener interface {
+	net.Listener
+	// Path returns the socket path requested at Listen time.
+	Path() string
+}
diff --git a/internal/hermesowner/peer_linux.go b/internal/hermesowner/peer_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..1a209d102c04f2bfa8584e1f17128c13f7e6f3c0
--- /dev/null
+++ b/internal/hermesowner/peer_linux.go
@@ -0,0 +1,220 @@
+//go:build linux
+
+package hermesowner
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+)
+
+// ResolveOwner verifies that pid is the direct parent of this process and
+// captures its identity. A supervisor that did not launch this process cannot be
+// named as the owner.
+func ResolveOwner(pid int) (Identity, error) {
+	if pid <= 0 {
+		return Identity{}, errors.New("owner pid must be positive")
+	}
+	if ppid := os.Getppid(); ppid != pid {
+		return Identity{}, fmt.Errorf("owner pid %d is not the parent process (ppid=%d)", pid, ppid)
+	}
+	return NewIdentity(pid)
+}
+
+// NewIdentity captures the start time of pid so a later PID reuse is detected.
+// The UID is this process's effective UID: the supervisor launched us, so it
+// shares it.
+func NewIdentity(pid int) (Identity, error) {
+	start, err := processStartTime(pid)
+	if err != nil {
+		return Identity{}, err
+	}
+	return Identity{PID: pid, UID: uint32(os.Geteuid()), StartTime: start}, nil
+}
+
+// Alive reports whether the owner is still the live parent of this process.
+func (id Identity) Alive() bool {
+	if os.Getppid() != id.PID {
+		return false
+	}
+	start, err := processStartTime(id.PID)
+	return err == nil && start == id.StartTime
+}
+
+// matchPeer compares SO_PEERCRED values with the owner identity.
+func (id Identity) matchPeer(pid int, uid uint32) error {
+	if uid != id.UID {
+		return fmt.Errorf("peer uid %d is not the owner uid %d", uid, id.UID)
+	}
+	if pid != id.PID {
+		return fmt.Errorf("peer pid %d is not the owner pid %d", pid, id.PID)
+	}
+	start, err := processStartTime(pid)
+	if err != nil {
+		return fmt.Errorf("peer pid %d start time: %w", pid, err)
+	}
+	if start != id.StartTime {
+		return fmt.Errorf("peer pid %d was reused (start %d, owner start %d)", pid, start, id.StartTime)
+	}
+	return nil
+}
+
+// processStartTime reads field 22 (starttime) of /proc/<pid>/stat.
+func processStartTime(pid int) (uint64, error) {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return 0, err
+	}
+	// The command name is wrapped in parentheses and may contain spaces; the
+	// remaining fields start after the final ')'.
+	end := bytes.LastIndexByte(data, ')')
+	if end < 0 {
+		return 0, fmt.Errorf("malformed /proc/%d/stat", pid)
+	}
+	fields := strings.Fields(string(data[end+1:]))
+	// fields[0] is field 3 (state); starttime is field 22.
+	const startTimeIndex = 22 - 3
+	if len(fields) <= startTimeIndex {
+		return 0, fmt.Errorf("malformed /proc/%d/stat", pid)
+	}
+	return strconv.ParseUint(fields[startTimeIndex], 10, 64)
+}
+
+type unixListener struct {
+	path  string
+	base  string
+	dirFD int
+	ln    *net.UnixListener
+	owner Identity
+	dev   uint64
+	ino   uint64
+
+	closeOnce sync.Once
+	closeErr  error
+}
+
+// Listen binds a fresh Unix socket at path with mode 0600 and only accepts peers
+// matching owner. The socket is created through an O_PATH directory descriptor so
+// long absolute paths do not hit the sun_path limit. An existing path is an
+// error: this process never unlinks something it did not create.
+func Listen(path string, owner Identity) (Listener, error) {
+	path = strings.TrimSpace(path)
+	if path == "" {
+		return nil, errors.New("socket path is empty")
+	}
+	dir, base := filepath.Split(path)
+	if base == "" || base == "." || base == ".." {
+		return nil, fmt.Errorf("socket path %s has no file name", path)
+	}
+	if dir == "" {
+		dir = "."
+	}
+	dirFD, err := unix.Open(dir, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open socket directory %s: %w", dir, err)
+	}
+	var st unix.Stat_t
+	switch errStat := unix.Fstatat(dirFD, base, &st, unix.AT_SYMLINK_NOFOLLOW); {
+	case errStat == nil:
+		_ = unix.Close(dirFD)
+		return nil, fmt.Errorf("socket path %s already exists", path)
+	case !errors.Is(errStat, unix.ENOENT):
+		_ = unix.Close(dirFD)
+		return nil, fmt.Errorf("stat socket path %s: %w", path, errStat)
+	}
+	procPath := fmt.Sprintf("/proc/self/fd/%d/%s", dirFD, base)
+	ln, err := net.ListenUnix("unix", &net.UnixAddr{Name: procPath, Net: "unix"})
+	if err != nil {
+		_ = unix.Close(dirFD)
+		return nil, fmt.Errorf("listen on %s: %w", path, err)
+	}
+	ln.SetUnlinkOnClose(false)
+	l := &unixListener{path: path, base: base, dirFD: dirFD, ln: ln, owner: owner}
+	if err = unix.Fchmodat(dirFD, base, 0o600, 0); err != nil {
+		l.destroy(true)
+		return nil, fmt.Errorf("chmod socket %s: %w", path, err)
+	}
+	if err = unix.Fstatat(dirFD, base, &st, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		l.destroy(true)
+		return nil, fmt.Errorf("stat socket %s: %w", path, err)
+	}
+	l.dev, l.ino = uint64(st.Dev), uint64(st.Ino)
+	return l, nil
+}
+
+func (l *unixListener) Accept() (net.Conn, error) {
+	for {
+		conn, err := l.ln.AcceptUnix()
+		if err != nil {
+			return nil, err
+		}
+		if errPeer := verifyPeer(conn, l.owner); errPeer != nil {
+			log.WithError(errPeer).Warnf("hermes owner channel %s rejected a connection", l.base)
+			_ = conn.Close()
+			continue
+		}
+		return conn, nil
+	}
+}
+
+func (l *unixListener) Close() error {
+	l.closeOnce.Do(func() { l.closeErr = l.destroy(false) })
+	return l.closeErr
+}
+
+// destroy closes the listener and unlinks the socket only when the path still
+// refers to the inode this process created.
+func (l *unixListener) destroy(force bool) error {
+	errClose := l.ln.Close()
+	var st unix.Stat_t
+	if errStat := unix.Fstatat(l.dirFD, l.base, &st, unix.AT_SYMLINK_NOFOLLOW); errStat == nil {
+		if force || (uint64(st.Dev) == l.dev && uint64(st.Ino) == l.ino) {
+			if errUnlink := unix.Unlinkat(l.dirFD, l.base, 0); errUnlink != nil && !errors.Is(errUnlink, unix.ENOENT) {
+				log.WithError(errUnlink).Warnf("failed to remove hermes owner socket %s", l.base)
+			}
+		} else {
+			log.Warnf("hermes owner socket %s was replaced by another inode; leaving it in place", l.base)
+		}
+	}
+	_ = unix.Close(l.dirFD)
+	if errClose != nil && !errors.Is(errClose, net.ErrClosed) {
+		return errClose
+	}
+	return nil
+}
+
+func (l *unixListener) Addr() net.Addr { return &net.UnixAddr{Name: l.path, Net: "unix"} }
+
+func (l *unixListener) Path() string { return l.path }
+
+func verifyPeer(conn *net.UnixConn, owner Identity) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var (
+		cred    *unix.Ucred
+		errCred error
+	)
+	if errControl := raw.Control(func(fd uintptr) {
+		cred, errCred = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); errControl != nil {
+		return errControl
+	}
+	if errCred != nil {
+		return fmt.Errorf("SO_PEERCRED: %w", errCred)
+	}
+	if cred == nil {
+		return errors.New("SO_PEERCRED unavailable")
+	}
+	return owner.matchPeer(int(cred.Pid), cred.Uid)
+}
diff --git a/internal/hermesowner/peer_linux_test.go b/internal/hermesowner/peer_linux_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2a2d84f87627e29d193d999255ec2b6989837fe0
--- /dev/null
+++ b/internal/hermesowner/peer_linux_test.go
@@ -0,0 +1,208 @@
+//go:build linux
+
+package hermesowner
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func selfIdentity(t *testing.T) Identity {
+	t.Helper()
+	identity, err := NewIdentity(os.Getpid())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return identity
+}
+
+// dialThroughDir connects the way the supervisor does: via an O_PATH directory
+// descriptor so the socket path length never matters.
+func dialThroughDir(t *testing.T, path string) (net.Conn, error) {
+	t.Helper()
+	dir, base := filepath.Split(path)
+	fd, err := unix.Open(dir, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = unix.Close(fd) }()
+	return net.DialTimeout("unix", fmt.Sprintf("/proc/self/fd/%d/%s", fd, base), time.Second)
+}
+
+func acceptOne(listener Listener) <-chan error {
+	done := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			done <- err
+			return
+		}
+		_, _ = conn.Write([]byte("ok"))
+		_ = conn.Close()
+		done <- nil
+	}()
+	return done
+}
+
+func TestResolveOwnerRequiresTheParentProcess(t *testing.T) {
+	if _, err := ResolveOwner(os.Getpid()); err == nil {
+		t.Fatal("own pid must not be accepted as owner")
+	}
+	if _, err := ResolveOwner(0); err == nil {
+		t.Fatal("zero pid must not be accepted")
+	}
+	identity, err := ResolveOwner(os.Getppid())
+	if err != nil {
+		t.Fatalf("parent must be accepted: %v", err)
+	}
+	if identity.PID != os.Getppid() || identity.UID != uint32(os.Geteuid()) || identity.StartTime == 0 {
+		t.Fatalf("unexpected identity %s", identity)
+	}
+	if !identity.Alive() {
+		t.Fatal("parent identity must be alive")
+	}
+	stale := identity
+	stale.StartTime++
+	if stale.Alive() {
+		t.Fatal("start time mismatch must not be alive")
+	}
+}
+
+func TestListenCreatesPrivateSocketAndVerifiesPeer(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "control.sock")
+	listener, err := Listen(path, selfIdentity(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = listener.Close() }()
+	info, err := os.Lstat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode()&os.ModeSocket == 0 || info.Mode().Perm() != 0o600 {
+		t.Fatalf("socket mode = %v, want 0600 socket", info.Mode())
+	}
+	if _, err = Listen(path, selfIdentity(t)); err == nil {
+		t.Fatal("an existing socket path must be refused")
+	}
+	if listener.Path() != path || listener.Addr().String() != path {
+		t.Fatalf("listener reports %q / %q", listener.Path(), listener.Addr())
+	}
+
+	done := acceptOne(listener)
+	conn, err := dialThroughDir(t, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 2)
+	if _, err = conn.Read(buf); err != nil || string(buf) != "ok" {
+		t.Fatalf("read %q %v", buf, err)
+	}
+	_ = conn.Close()
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestListenRejectsPeersThatAreNotTheOwner(t *testing.T) {
+	for name, mutate := range map[string]func(Identity) Identity{
+		"different pid":         func(id Identity) Identity { id.PID = 1; return id },
+		"different uid":         func(id Identity) Identity { id.UID++; return id },
+		"reused pid start time": func(id Identity) Identity { id.StartTime++; return id },
+	} {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "control.sock")
+			listener, err := Listen(path, mutate(selfIdentity(t)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = listener.Close() }()
+			accepted := make(chan struct{})
+			go func() {
+				if conn, errAccept := listener.Accept(); errAccept == nil {
+					_ = conn.Close()
+					close(accepted)
+				}
+			}()
+			conn, err := dialThroughDir(t, path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+			if _, err = conn.Read(make([]byte, 1)); err == nil {
+				t.Fatal("rejected peer must not receive data")
+			}
+			_ = conn.Close()
+			select {
+			case <-accepted:
+				t.Fatal("rejected peer was handed to the server")
+			case <-time.After(200 * time.Millisecond):
+			}
+		})
+	}
+}
+
+func TestListenSupportsPathsLongerThanSunPath(t *testing.T) {
+	dir := t.TempDir()
+	for len(dir) < 120 {
+		dir = filepath.Join(dir, strings.Repeat("segment", 4))
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "inference.sock")
+	if _, err := net.Listen("unix", path); err == nil {
+		t.Skip("platform accepts long unix paths; nothing to prove")
+	}
+	listener, err := Listen(path, selfIdentity(t))
+	if err != nil {
+		t.Fatalf("long path must bind through the directory descriptor: %v", err)
+	}
+	done := acceptOne(listener)
+	conn, err := dialThroughDir(t, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.Close()
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+	if err = listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket must be unlinked on close, stat err=%v", err)
+	}
+}
+
+func TestCloseUnlinksOnlyTheSocketItCreated(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "control.sock")
+	listener, err := Listen(path, selfIdentity(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, []byte("someone else"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err = listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil || string(data) != "someone else" {
+		t.Fatalf("foreign file at the socket path must survive close: %q %v", data, err)
+	}
+	if err = listener.Close(); err != nil {
+		t.Fatalf("close must be idempotent: %v", err)
+	}
+}
