+
+// newHermesOwnerServer builds a real server with owner channels configured but
+// not bound; channel identity is injected per request exactly as ConnContext does.
+func newHermesOwnerServer(t *testing.T, yamlText string, extra ...ServerOption) (*Server, string) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.yaml")
+	if err := os.WriteFile(path, []byte(yamlText), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := proxyconfig.LoadConfig(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.Port = 0
+	cfg.Debug = true
+	cfg.LoggingToFile = false
+	cfg.UsageStatisticsEnabled = false
+	cfg.AuthDir = filepath.Join(dir, "auth")
+	if err = os.MkdirAll(cfg.AuthDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	opts := append([]ServerOption{WithHermesOwnerChannels(hermesowner.Options{
+		ControlSocket:   filepath.Join(dir, "control.sock"),
+		InferenceSocket: filepath.Join(dir, "inference.sock"),
+		OwnerPID:        1,
+	})}, extra...)
+	s := NewServer(cfg, auth.NewManager(nil, nil, nil), sdkaccess.NewManager(), path, opts...)
+	s.hermesOwner.ready.Store(true)
+	return s, path
+}
+
+func channelRequest(channel hermesowner.Channel, method, target, body string, headers map[string]string) *http.Request {
+	req := httptest.NewRequest(method, target, strings.NewReader(body))
+	req.RemoteAddr = "127.0.0.1:1234"
+	for key, value := range headers {
+		req.Header.Set(key, value)
+	}
+	if channel != hermesowner.ChannelNone {
+		req = req.WithContext(hermesowner.WithChannel(req.Context(), channel))
+	}
+	return req
+}
+
+func serve(s *Server, req *http.Request) *httptest.ResponseRecorder {
+	recorder := httptest.NewRecorder()
+	s.engine.ServeHTTP(recorder, req)
+	return recorder
+}
+
+func TestHermesOwnerChannelsHaveDisjointAuthority(t *testing.T) {
+	s, path := newHermesOwnerServer(t, "port: 8317\napi-keys: [test-key]\n")
+	fileBytes, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	revision := managementHandlers.ConfigRevision(fileBytes)
+	spoof := map[string]string{
+		"Authorization":                "Bearer anything",
+		"X-Management-Key":             "anything",
+		"X-Hermes-Channel":             "control",
+		hermesowner.EgressPolicyHeader: "e30",
+	}
+
+	// Public listener: native behaviour, owner routes do not exist, headers cannot promote.
+	for _, tc := range []struct {
+		method, target string
+		want           int
+	}{
+		{http.MethodGet, "/v8/management/config", http.StatusNotFound},
+		{http.MethodGet, "/hermes/health", http.StatusNotFound},
+		{http.MethodPost, "/hermes/config/prepare", http.StatusNotFound},
+		{http.MethodGet, "/v1/models", http.StatusUnauthorized},
+	} {
+		if got := serve(s, channelRequest(hermesowner.ChannelNone, tc.method, tc.target, "", spoof)); got.Code != tc.want {
+			t.Fatalf("public %s %s: status=%d want %d body=%s", tc.method, tc.target, got.Code, tc.want, got.Body.String())
+		}
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, "/v1/models", "", map[string]string{"Authorization": "Bearer test-key"})); got.Code != http.StatusOK {
+		t.Fatalf("public inference with the configured key must stay native: status=%d body=%s", got.Code, got.Body.String())
+	}
+
+	// Control channel: management without any key, owner routes, no inference.
+	health := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/hermes/health", "", nil))
+	if health.Code != http.StatusOK {
+		t.Fatalf("control health: status=%d body=%s", health.Code, health.Body.String())
+	}
+	var healthBody struct {
+		Protocol       int    `json:"protocol"`
+		Integration    string `json:"integration"`
+		CPAVersion     string `json:"cpa_version"`
+		ConfigRevision string `json:"config_revision"`
+	}
+	if err = json.Unmarshal(health.Body.Bytes(), &healthBody); err != nil {
+		t.Fatal(err)
+	}
+	if healthBody.Protocol != hermesowner.Protocol || healthBody.Integration != hermesowner.Integration || healthBody.ConfigRevision != revision || healthBody.CPAVersion == "" {
+		t.Fatalf("health body=%+v want revision %s", healthBody, revision)
+	}
+	configView := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/v8/management/config", "", nil))
+	if configView.Code != http.StatusOK || configView.Header().Get(hermesowner.ConfigRevisionHeader) != revision {
+		t.Fatalf("control config: status=%d revision=%q body=%s", configView.Code, configView.Header().Get(hermesowner.ConfigRevisionHeader), configView.Body.String())
+	}
+	if routes := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/hermes/plugin-routes", "", nil)); routes.Code != http.StatusOK || !strings.Contains(routes.Body.String(), `"management":[]`) || !strings.Contains(routes.Body.String(), `"registry_revision":"none-0"`) {
+		t.Fatalf("plugin routes: status=%d body=%s", routes.Code, routes.Body.String())
+	}
+	for _, target := range []string{"/v1/models", "/v1/chat/completions", "/management.html", "/healthz", "/"} {
+		if got := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, target, "", nil)); got.Code != http.StatusNotFound {
+			t.Fatalf("control must not serve %s: status=%d", target, got.Code)
+		}
+	}
+
+	// Inference channel: only the broker allowlist, no key, no management.
+	if got := serve(s, channelRequest(hermesowner.ChannelInference, http.MethodGet, "/v1/models", "", nil)); got.Code != http.StatusOK {
+		t.Fatalf("inference models: status=%d body=%s", got.Code, got.Body.String())
+	}
+	for _, tc := range []struct{ method, target string }{
+		{http.MethodGet, "/v8/management/config"},
+		{http.MethodGet, "/hermes/health"},
+		{http.MethodPost, "/v1/completions"},
+		{http.MethodPost, "/v1/messages"},
+		{http.MethodGet, "/v1/responses"},
+		{http.MethodPost, "/v8/management/requests/api-call"},
+	} {
+		if got := serve(s, channelRequest(hermesowner.ChannelInference, tc.method, tc.target, "{}", spoof)); got.Code != http.StatusNotFound {
+			t.Fatalf("inference must not serve %s %s: status=%d", tc.method, tc.target, got.Code)
+		}
+	}
+}
