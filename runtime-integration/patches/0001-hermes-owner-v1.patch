+func TestHermesOwnerControlSurvivesPublicManagementAndKeyChanges(t *testing.T) {
+	s, _ := newHermesOwnerServer(t, "port: 8317\napi-keys: [test-key]\nremote-management: {secret-key: test-password}\n")
+	publicKey := map[string]string{"Authorization": "Bearer test-password"}
+	if got := serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, "/v8/management/config", "", publicKey)); got.Code != http.StatusOK {
+		t.Fatalf("public management with the configured secret: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/v8/management/config", "", nil)); got.Code != http.StatusOK {
+		t.Fatalf("control management: status=%d body=%s", got.Code, got.Body.String())
+	}
+
+	// The user clears the public management key and rotates the access keys.
+	rotated := s.cfg.CloneForRuntime()
+	rotated.RemoteManagement.SecretKey = ""
+	rotated.APIKeys = []string{"rotated-key"}
+	s.UpdateClients(rotated)
+
+	if got := serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, "/v8/management/config", "", publicKey)); got.Code != http.StatusNotFound {
+		t.Fatalf("public management must be disabled after clearing the secret: status=%d", got.Code)
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, "/v1/models", "", map[string]string{"Authorization": "Bearer test-key"})); got.Code != http.StatusUnauthorized {
+		t.Fatalf("public inference with the old key must fail: status=%d", got.Code)
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/v8/management/config", "", nil)); got.Code != http.StatusOK {
+		t.Fatalf("control management must survive clearing the public secret: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelControl, http.MethodGet, "/hermes/health", "", nil)); got.Code != http.StatusOK {
+		t.Fatalf("control health must survive: status=%d", got.Code)
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelInference, http.MethodGet, "/v1/models", "", nil)); got.Code != http.StatusOK {
+		t.Fatalf("private inference must survive key rotation: status=%d body=%s", got.Code, got.Body.String())
+	}
+	if got := serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, "/v1/models", "", map[string]string{"Authorization": "Bearer rotated-key"})); got.Code != http.StatusOK {
+		t.Fatalf("public inference with the rotated key must work: status=%d", got.Code)
+	}
+}
