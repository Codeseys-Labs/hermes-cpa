+	}
+
+	// The same race under an assertion is answered as stale, never as success.
+	stuck := &countingManagementHandler{body: "stuck"}
+	stuck.onInvoke = func() {
+		// Replacing the plugin while its handler runs makes the captured record
+		// stale for the next call; this call still completes on the reviewed code.
+		setHostSnapshotForTest(host, true, registryRecord("acct", registryPlugin(&countingManagementHandler{body: "newer"})))
+		host.RegisterManagementRoutes(context.Background(), nil)
+	}
+	setHostSnapshotForTest(host, true, registryRecord("acct", registryPlugin(stuck)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	stuckRevision := host.RegisteredManagementRoutes().Revision
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, stuckRevision, true))
+	if rec.Code != http.StatusOK || rec.Body.String() != "stuck" || rec.Header().Get(hermesowner.PluginInvokedHeader) != "1" || rec.Header().Get(hermesowner.PluginRevisionHeader) != stuckRevision {
+		t.Fatalf("in-flight replacement: status=%d body=%q headers=%v", rec.Code, rec.Body.String(), rec.Header())
+	}
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, stuckRevision, true))
+	if rec.Code != http.StatusPreconditionFailed || rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || stuck.calls.Load() != 1 {
+		t.Fatalf("post-replacement assertion: status=%d calls=%d headers=%v", rec.Code, stuck.calls.Load(), rec.Header())
+	}
+}
+
+func TestPluginRevisionPreconditionMarkersAndPublicBehaviour(t *testing.T) {
+	handler := &countingManagementHandler{body: "ok", status: http.StatusNotFound, forgeHost: true}
+	host := managementHost(t, handler)
+	listed := host.RegisteredManagementRoutes()
+
+	// Public listener: the private header is ignored, no markers are emitted,
+	// forged plugin markers are dropped, the plugin never sees the header.
+	rec := httptest.NewRecorder()
+	if !host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelNone, "definitely-not-the-revision", true)) {
+		t.Fatal("public request was not served")
+	}
+	if rec.Code != http.StatusNotFound || rec.Body.String() != "ok" || handler.calls.Load() != 1 {
+		t.Fatalf("public: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), handler.calls.Load())
+	}
+	for _, name := range []string{hermesowner.PluginInvokedHeader, hermesowner.PluginRevisionHeader, hermesowner.ResourceInvokedHeader, "X-Hermes-Plugin-Rejected"} {
+		if rec.Header().Get(name) != "" {
+			t.Fatalf("public response leaked %s=%q", name, rec.Header().Get(name))
+		}
+	}
+	if seen := handler.seen.Load(); seen == nil || seen.Headers.Get(hermesowner.PluginRevisionHeader) != "" {
+		t.Fatalf("plugin saw private header: %v", seen)
+	}
+
+	// Inference channel is not the control channel either.
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelInference, "x", true))
+	if rec.Code != http.StatusNotFound || handler.calls.Load() != 2 || rec.Header().Get(hermesowner.PluginInvokedHeader) != "" {
+		t.Fatalf("inference: status=%d calls=%d headers=%v", rec.Code, handler.calls.Load(), rec.Header())
+	}
+
+	// Control channel without an assertion: native dispatch plus host truth; a
+	// plugin 404 is still Invoked:1.
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, "", false))
+	if rec.Code != http.StatusNotFound || handler.calls.Load() != 3 {
+		t.Fatalf("control no-assert: status=%d calls=%d", rec.Code, handler.calls.Load())
+	}
+	if got := rec.Header().Values(hermesowner.PluginInvokedHeader); len(got) != 1 || got[0] != "1" {
+		t.Fatalf("control no-assert markers = %v", rec.Header())
+	}
+	if rec.Header().Get(hermesowner.PluginRevisionHeader) != listed.Revision || rec.Header().Get("X-Hermes-Plugin-Rejected") != "" {
+		t.Fatalf("control no-assert markers = %v", rec.Header())
+	}
+
+	// Undeclared path or method at the reviewed revision: native not-found with
+	// host Invoked:0, so an owner asserting a route the registry never listed
+	// gets proof that nothing ran.
+	for _, tc := range []struct{ method, path string }{
+		{http.MethodPost, "/v0/management/plugins/acct/missing"},
+		{http.MethodGet, managementRoutePath},
+		{http.MethodGet, "/v0/management/acct-auth-url"},
+	} {
+		rec = httptest.NewRecorder()
+		req := httptest.NewRequest(tc.method, tc.path, nil)
+		req.Header.Set(hermesowner.PluginRevisionHeader, listed.Revision)
+		if host.ServeManagementHTTP(rec, req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))) {
+			t.Fatalf("%s %s must fall through to native not-found", tc.method, tc.path)
+		}
+		if rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || rec.Header().Get(hermesowner.PluginRevisionHeader) != listed.Revision {
+			t.Fatalf("%s %s markers = %v", tc.method, tc.path, rec.Header())
+		}
+	}
+	if handler.calls.Load() != 3 {
+		t.Fatal("undeclared route invoked a handler")
+	}
+
+	// A fused plugin at the reviewed revision is stale: nothing runs.
+	host.fusePlugin("acct", "ManagementHandler.HandleManagement", "boom")
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, listed.Revision, true))
+	if rec.Code != http.StatusPreconditionFailed || rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || handler.calls.Load() != 3 {
+		t.Fatalf("fused: status=%d calls=%d headers=%v", rec.Code, handler.calls.Load(), rec.Header())
+	}
+}
+
+func TestPluginManagementHandlerFailureStillReportsInvoked(t *testing.T) {
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(managementHandlerFunc(func(context.Context, pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+		panic("management exploded")
+	}))))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	listed := host.RegisteredManagementRoutes()
+
+	rec := httptest.NewRecorder()
+	if !host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("failing handler was not served")
+	}
+	if rec.Code != http.StatusBadGateway || rec.Header().Get(hermesowner.PluginInvokedHeader) != "1" || rec.Header().Get(hermesowner.PluginRevisionHeader) != listed.Revision {
+		t.Fatalf("failure: status=%d headers=%v", rec.Code, rec.Header())
+	}
+	if after := host.RegisteredManagementRoutes(); after.Revision == listed.Revision {
+		t.Fatal("a panicking plugin is fused and must change the registry revision")
+	}
+}
+
+type failingBody struct{}
+
+func (failingBody) Read([]byte) (int, error) { return 0, errors.New("broken pipe") }
+
+func TestPluginManagementBodyReadFailureReportsNotInvoked(t *testing.T) {
+	handler := &countingManagementHandler{body: "never"}
+	host := managementHost(t, handler)
+	listed := host.RegisteredManagementRoutes()
+
+	req := httptest.NewRequest(http.MethodPost, managementRoutePath, io.NopCloser(failingBody{}))
+	req.Header.Set(hermesowner.PluginRevisionHeader, listed.Revision)
+	rec := httptest.NewRecorder()
+	if !host.ServeManagementHTTP(rec, req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))) {
+		t.Fatal("unreadable body must be answered by the host")
+	}
+	if rec.Code != http.StatusBadRequest || rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || rec.Header().Get(hermesowner.PluginRevisionHeader) != listed.Revision || handler.calls.Load() != 0 {
+		t.Fatalf("unreadable body: status=%d calls=%d headers=%v", rec.Code, handler.calls.Load(), rec.Header())
+	}
+}
+
+// A declaration a fixed native route would serve first, exactly or through a
+// :param or *wildcard pattern, is dropped at registration so it is never
+// advertised to an owner review that could then only reach the fixed handler.
+func TestRegisterManagementRoutesDropsDeclarationsShadowedByFixedPatterns(t *testing.T) {
+	handler := managementHandlerFunc(func(context.Context, pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+		return pluginapi.ManagementResponse{Body: []byte("declared")}, nil
+	})
+	plugin := &managementPluginDouble{routes: []pluginapi.ManagementRoute{
+		{Method: http.MethodGet, Path: "/plugins/acct/quota", Handler: handler},
+		{Method: http.MethodDelete, Path: "/plugins/acct", Handler: handler},
+		{Method: http.MethodPost, Path: "/quota/fetch", Handler: handler},
+		{Method: http.MethodGet, Path: "/logs/archive/deep", Handler: handler},
+		{Method: http.MethodGet, Path: "/plugins/acct/status", Handler: handler},
+		{Method: http.MethodPost, Path: "/plugins/acct/quota/extra", Handler: handler},
+		{Method: http.MethodPost, Path: "/plugins/acct/quota", Handler: handler},
+	}}
+	host := newHostWithRecords(registryRecord("acct", plugin))
+	host.RegisterManagementRoutes(context.Background(), map[string]struct{}{
+		"GET /v0/management/plugins/:id/quota":        {},
+		"DELETE /v0/management/plugins/:id":           {},
+		"POST /v0/management/quota/fetch":             {},
+		"POST /v0/management/plugins/:id/quota/reset": {},
+		"GET /v0/management/logs/*path":               {},
+	})
+	listed := host.RegisteredManagementRoutes()
+	got := make([]string, 0, len(listed.Management))
+	for _, route := range listed.Management {
+		got = append(got, route.Method+" "+route.Path)
+	}
+	want := []string{"POST /v0/management/plugins/acct/quota", "POST /v0/management/plugins/acct/quota/extra", "GET /v0/management/plugins/acct/status"}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Fatalf("registered = %v want %v", got, want)
+	}
+	for _, dropped := range []string{"GET /v0/management/plugins/acct/quota", "DELETE /v0/management/plugins/acct", "POST /v0/management/quota/fetch", "GET /v0/management/logs/archive/deep"} {
+		method, path, _ := strings.Cut(dropped, " ")
+		rec := httptest.NewRecorder()
+		if host.ServeManagementHTTP(rec, httptest.NewRequest(method, path, nil)) {
+			t.Fatalf("shadowed declaration %s was served", dropped)
+		}
+	}
+}
diff --git a/internal/pluginhost/management_registry_test.go b/internal/pluginhost/management_registry_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..13d23ff15bf6bbc1dea513b9bf5efdef6e1ce3d9
--- /dev/null
+++ b/internal/pluginhost/management_registry_test.go
@@ -0,0 +1,152 @@
+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// registryHandlerInstance stands in for an RPC plugin adapter: identity is the
+// pointer, so reloaded plugin code behind the same paths is a new instance.
+type registryHandlerInstance struct{ body string }
+
+func (h *registryHandlerInstance) HandleManagement(context.Context, pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+	return pluginapi.ManagementResponse{Body: []byte(h.body)}, nil
+}
+
+var registryRevisionPattern = regexp.MustCompile(`^[0-9a-f]{16}-[1-9][0-9]*$`)
+
+func registryPlugin(handler pluginapi.ManagementHandler) *managementPluginDouble {
+	return &managementPluginDouble{
+		routes:    []pluginapi.ManagementRoute{{Method: http.MethodPost, Path: "/plugins/acct/sync", Handler: handler}},
+		resources: []pluginapi.ResourceRoute{{Path: "/panel", Menu: "Account", Description: "Account panel.", Handler: handler}},
+	}
+}
+
+func registryRecord(id string, plugin *managementPluginDouble) capabilityRecord {
+	return capabilityRecord{
+		id:     id,
+		meta:   pluginapi.Metadata{Name: id, Version: "1.0.0", Author: "test", GitHubRepository: "https://github.com/router-for-me/CLIProxyAPI"},
+		plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{ManagementAPI: plugin}},
+	}
+}
+
+func serveResource(t *testing.T, host *Host, path string) string {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	if !host.ServeResourceHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil)) {
+		t.Fatalf("resource %s was not served", path)
+	}
+	return rec.Body.String()
+}
+
+func TestRouteRegistryRevisionTracksRealChangesOnly(t *testing.T) {
+	first := &registryHandlerInstance{body: "first"}
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(first)))
+
+	initial := host.RegisteredManagementRoutes()
+	if !registryRevisionPattern.MatchString(initial.Revision) || len(initial.Management) != 0 || len(initial.Resources) != 0 {
+		t.Fatalf("empty registry = %+v", initial)
+	}
+	if other := New().RegisteredManagementRoutes(); other.Revision == initial.Revision {
+		t.Fatal("revisions from different hosts must not collide")
+	}
+
+	host.RegisterManagementRoutes(context.Background(), nil)
+	registered := host.RegisteredManagementRoutes()
+	if registered.Revision == initial.Revision {
+		t.Fatal("registering routes must advance the revision")
+	}
+	if len(registered.Management) != 1 || registered.Management[0].Path != "/v0/management/plugins/acct/sync" || registered.Management[0].PluginID != "acct" {
+		t.Fatalf("management = %+v", registered.Management)
+	}
+	if len(registered.Resources) != 1 || registered.Resources[0].Path != "/v0/resource/plugins/acct/panel" || registered.Resources[0].Menu != "Account" {
+		t.Fatalf("resources = %+v", registered.Resources)
+	}
+	if body := serveResource(t, host, "/v0/resource/plugins/acct/panel"); body != "first" {
+		t.Fatalf("resource body = %q", body)
+	}
+
+	// An unrelated refresh that rebuilds identical tables is not a change.
+	host.RegisterManagementRoutes(context.Background(), nil)
+	if again := host.RegisteredManagementRoutes(); again.Revision != registered.Revision {
+		t.Fatalf("identical re-registration changed the revision: %s -> %s", registered.Revision, again.Revision)
+	}
+
+	// The same plugin id, path, version and routes, but replacement code.
+	second := &registryHandlerInstance{body: "second"}
+	setHostSnapshotForTest(host, true, registryRecord("acct", registryPlugin(second)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	replaced := host.RegisteredManagementRoutes()
+	if replaced.Revision == registered.Revision {
+		t.Fatal("replacing plugin code behind identical paths must advance the revision")
+	}
+	if len(replaced.Management) != 1 || len(replaced.Resources) != 1 || replaced.Resources[0].Path != registered.Resources[0].Path {
+		t.Fatalf("route shape changed on replacement: %+v", replaced)
+	}
+	if body := serveResource(t, host, "/v0/resource/plugins/acct/panel"); body != "second" {
+		t.Fatalf("replacement code not dispatched: %q", body)
+	}
+
+	// Unloading everything is a change; the empty registry still has a distinct revision.
+	setHostSnapshotForTest(host, true)
+	host.RegisterManagementRoutes(context.Background(), nil)
+	unloaded := host.RegisteredManagementRoutes()
+	if unloaded.Revision == replaced.Revision || len(unloaded.Management) != 0 || len(unloaded.Resources) != 0 {
+		t.Fatalf("unload = %+v (previous %s)", unloaded, replaced.Revision)
+	}
+	if !strings.HasPrefix(unloaded.Revision, strings.SplitN(initial.Revision, "-", 2)[0]+"-") {
+		t.Fatalf("process nonce changed within one host: %s vs %s", initial.Revision, unloaded.Revision)
+	}
+}
+
+func TestRouteRegistryRevisionTracksFusedAndStalePlugins(t *testing.T) {
+	handler := &registryHandlerInstance{body: "ok"}
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(handler)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	live := host.RegisteredManagementRoutes()
+	if len(live.Resources) != 1 {
+		t.Fatalf("resources = %+v", live.Resources)
+	}
+
+	host.fusePlugin("acct", "ResourceHandler.HandleManagement", "boom")
+	fused := host.RegisteredManagementRoutes()
+	if fused.Revision == live.Revision || len(fused.Management) != 0 || len(fused.Resources) != 0 {
+		t.Fatalf("fused plugin must drop out of the registry with a new revision: %+v", fused)
+	}
+	rec := httptest.NewRecorder()
+	if host.ServeResourceHTTP(rec, httptest.NewRequest(http.MethodGet, "/v0/resource/plugins/acct/panel", nil)) {
+		t.Fatal("fused plugin resource must not be served")
+	}
+	host.fusePlugin("acct", "ResourceHandler.HandleManagement", "boom again")
+	if repeat := host.RegisteredManagementRoutes(); repeat.Revision != fused.Revision {
+		t.Fatal("re-fusing an already fused plugin is not a change")
+	}
+
+	host.mu.Lock()
+	host.clearPluginFusedLocked("acct")
+	host.mu.Unlock()
+	restored := host.RegisteredManagementRoutes()
+	if restored.Revision == fused.Revision || len(restored.Resources) != 1 {
+		t.Fatalf("clearing a fuse must advance the revision and restore routes: %+v", restored)
+	}
+
+	// Identity maps moved on (plugin file replaced) but tables not yet rebuilt: the
+	// listing must not advertise routes the dispatcher would refuse.
+	stale := registryRecord("acct", registryPlugin(handler))
+	stale.version = "2.0.0"
+	setHostSnapshotForTest(host, true, stale)
+	if pending := host.RegisteredManagementRoutes(); len(pending.Management) != 0 || len(pending.Resources) != 0 {
+		t.Fatalf("stale routes advertised: %+v", pending)
+	}
+	host.RegisterManagementRoutes(context.Background(), nil)
+	current := host.RegisteredManagementRoutes()
+	if current.Revision == restored.Revision || len(current.Resources) != 1 {
+		t.Fatalf("rebuilt registry = %+v (previous %s)", current, restored.Revision)
+	}
+}
diff --git a/internal/pluginhost/management_resource_precondition_test.go b/internal/pluginhost/management_resource_precondition_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f412e0f1bcabaec27d67f4b274bca0697a849de7
--- /dev/null
+++ b/internal/pluginhost/management_resource_precondition_test.go
@@ -0,0 +1,253 @@
+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/hermesowner"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// countingResourceHandler records invocations and the headers the plugin saw,
+// and tries to counterfeit the host-owned markers in its response.
+type countingResourceHandler struct {
+	body      string
+	calls     atomic.Int32
+	seen      atomic.Pointer[http.Header]
+	status    int
+	onInvoke  func()
+	forgeHost bool
+}
+
+func (h *countingResourceHandler) HandleManagement(_ context.Context, req pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+	h.calls.Add(1)
+	headers := cloneHeader(req.Headers)
+	h.seen.Store(&headers)
+	if h.onInvoke != nil {
+		h.onInvoke()
+	}
+	resp := pluginapi.ManagementResponse{StatusCode: h.status, Body: []byte(h.body), Headers: http.Header{"Content-Type": []string{"text/plain"}}}
+	if h.forgeHost {
+		resp.Headers.Set(hermesowner.ResourceInvokedHeader, "0")
+		resp.Headers.Set(hermesowner.ResourceRevisionHeader, "forged")
+		resp.Headers.Set("X-Hermes-Resource-Rejected", "forged")
+	}
+	return resp, nil
+}
+
+func resourceHost(t *testing.T, handler pluginapi.ManagementHandler) *Host {
+	t.Helper()
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(handler)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	return host
+}
+
+func resourceRequest(channel hermesowner.Channel, revision string, assert bool) *http.Request {
+	req := httptest.NewRequest(http.MethodGet, "/v0/resource/plugins/acct/panel?op=save", nil)
+	req.Header.Set("Authorization", "Bearer public")
+	if assert {
+		req.Header.Set(hermesowner.ResourceRevisionHeader, revision)
+	}
+	if channel != hermesowner.ChannelNone {
+		req = req.WithContext(hermesowner.WithChannel(req.Context(), channel))
+	}
+	return req
+}
+
+func TestResourceRevisionPreconditionDeniesReplacementBeforeHandler(t *testing.T) {
+	reviewed := &countingResourceHandler{body: "reviewed", forgeHost: true}
+	host := resourceHost(t, reviewed)
+	listed := host.RegisteredManagementRoutes()
+
+	// Matching assertion: the reviewed handler runs, never sees the private
+	// header, and cannot counterfeit the host markers.
+	rec := httptest.NewRecorder()
+	if !host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("matching assertion was not served")
+	}
+	if rec.Code != http.StatusOK || rec.Body.String() != "reviewed" || reviewed.calls.Load() != 1 {
+		t.Fatalf("matching dispatch: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), reviewed.calls.Load())
+	}
+	if got := rec.Header().Values(hermesowner.ResourceInvokedHeader); len(got) != 1 || got[0] != "1" {
+		t.Fatalf("%s = %v want exactly [1]", hermesowner.ResourceInvokedHeader, got)
+	}
+	if got := rec.Header().Values(hermesowner.ResourceRevisionHeader); len(got) != 1 || got[0] != listed.Revision {
+		t.Fatalf("%s = %v want exactly [%s]", hermesowner.ResourceRevisionHeader, got, listed.Revision)
+	}
+	if rec.Header().Get("X-Hermes-Resource-Rejected") != "" || rec.Header().Get("Content-Type") != "text/plain" {
+		t.Fatalf("plugin headers = %v", rec.Header())
+	}
+	seen := reviewed.seen.Load()
+	if seen == nil || (*seen).Get(hermesowner.ResourceRevisionHeader) != "" || (*seen).Get("Authorization") != "Bearer public" {
+		t.Fatalf("plugin saw headers %v", seen)
+	}
+
+	// Same id, path, version and routes, but replacement code between listing and dispatch.
+	replacement := &countingResourceHandler{body: "replacement"}
+	setHostSnapshotForTest(host, true, registryRecord("acct", registryPlugin(replacement)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	current := host.RegisteredManagementRoutes()
+	if current.Revision == listed.Revision {
+		t.Fatal("replacement did not change the revision")
+	}
+
+	rec = httptest.NewRecorder()
+	if !host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("stale assertion must be answered by the host")
+	}
+	if rec.Code != http.StatusPreconditionFailed || !strings.Contains(rec.Body.String(), `"error":"stale_resource_revision"`) || !strings.Contains(rec.Body.String(), current.Revision) {
+		t.Fatalf("stale assertion: status=%d body=%s", rec.Code, rec.Body.String())
+	}
+	if rec.Header().Get(hermesowner.ResourceInvokedHeader) != "0" || rec.Header().Get(hermesowner.ResourceRevisionHeader) != current.Revision || rec.Header().Get("Cache-Control") != "no-store" {
+		t.Fatalf("stale assertion headers = %v", rec.Header())
+	}
+	if reviewed.calls.Load() != 1 || replacement.calls.Load() != 0 {
+		t.Fatalf("stale assertion invoked a handler: reviewed=%d replacement=%d", reviewed.calls.Load(), replacement.calls.Load())
+	}
+
+	// Re-reviewed at the current revision the replacement serves normally.
+	rec = httptest.NewRecorder()
+	host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, current.Revision, true))
+	if rec.Code != http.StatusOK || rec.Body.String() != "replacement" || replacement.calls.Load() != 1 {
+		t.Fatalf("current assertion: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), replacement.calls.Load())
+	}
+
+	// Empty or malformed assertions never match.
+	for _, value := range []string{"", "none-0", strings.ToUpper(current.Revision)} {
+		rec = httptest.NewRecorder()
+		host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, value, true))
+		if rec.Code != http.StatusPreconditionFailed {
+			t.Fatalf("assertion %q: status=%d", value, rec.Code)
+		}
+	}
+	if replacement.calls.Load() != 1 {
+		t.Fatal("malformed assertions invoked the handler")
+	}
+}
+
