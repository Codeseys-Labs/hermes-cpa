 	if errStart != nil {
@@ -215,6 +455,10 @@ func (h *Handler) ServePluginAuthURL(c *gin.Context) bool {
 		c.JSON(http.StatusBadGateway, gin.H{"error": "failed to generate authorization url"})
 		return true
 	}
+	if listener != nil {
+		sessionBound = true
+		go listener.watchSession(state)
+	}
 	c.JSON(http.StatusOK, gin.H{"status": "ok", "url": resp.URL, "state": state})
 	return true
 }
diff --git a/internal/api/handlers/management/auth_files_oauth_callback_owner_test.go b/internal/api/handlers/management/auth_files_oauth_callback_owner_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..510a21472abf8959e18316b7084b916eebae3863
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_oauth_callback_owner_test.go
@@ -0,0 +1,185 @@
+package management
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func freeLoopbackPort(t *testing.T) int {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := ln.Addr().(*net.TCPAddr).Port
+	if err = ln.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return port
+}
+
+func readCallbackPayload(t *testing.T, authDir, provider, state string) (oauthCallbackFilePayload, bool) {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(authDir, ".oauth-"+provider+"-"+state+".oauth"))
+	if errors.Is(err, os.ErrNotExist) {
+		return oauthCallbackFilePayload{}, false
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	var payload oauthCallbackFilePayload
+	if err = json.Unmarshal(data, &payload); err != nil {
+		t.Fatal(err)
+	}
+	return payload, true
+}
+
+// An owner-supervised instance whose public listener is unreachable (non-loopback
+// bind, TLS, dead port) must still complete a browser callback on the fixed
+// loopback provider port with the native pending-session semantics.
+func TestOwnerModeCallbackForwarderCompletesNativelyWithoutPublicListener(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	authDir := filepath.Join(t.TempDir(), "auths")
+	cfg := &config.Config{AuthDir: authDir}
+	cfg.Host = "127.0.0.2"
+	cfg.Port = freeLoopbackPort(t) // nothing listens here
+	cfg.TLS.Enable = true
+	h := NewHandlerWithoutConfigFilePath(cfg, nil)
+	h.SetHermesOwnerMode(true)
+
+	port := freeLoopbackPort(t)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	forwarder, ok := h.startProviderCallbackForwarder(c, port, "anthropic", "/anthropic/callback")
+	if !ok || forwarder == nil {
+		t.Fatal("owner-mode forwarder did not start")
+	}
+	defer stopCallbackForwarderInstance(port, forwarder)
+
+	if ln, err := net.Listen("tcp", "0.0.0.0:"+strconv.Itoa(port)); err == nil {
+		_ = ln.Close()
+		t.Fatal("owner-mode forwarder left the wildcard address free; it must bind loopback only")
+	}
+
+	client := &http.Client{Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	base := "http://127.0.0.1:" + strconv.Itoa(port) + "/callback"
+
+	pending := "owner-anthropic-state"
+	RegisterOAuthSession(pending, "anthropic")
+	defer CompleteOAuthSession(pending)
+	resp, err := client.Get(base + "?code=the-code%23frag&state=" + pending)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK || resp.Header.Get("Location") != "" || !strings.Contains(string(body), "Authentication successful") {
+		t.Fatalf("native completion: status=%d location=%q body=%s", resp.StatusCode, resp.Header.Get("Location"), body)
+	}
+	if ct := resp.Header.Get("Content-Type"); !strings.HasPrefix(ct, "text/html") {
+		t.Fatalf("content-type=%q", ct)
+	}
+	payload, found := readCallbackPayload(t, authDir, "anthropic", pending)
+	if !found || payload.State != pending || payload.Code != "the-code#frag" || payload.Error != "" {
+		t.Fatalf("callback file: found=%v payload=%+v", found, payload)
+	}
+
+	// Provider errors are recorded for the pending session the same way.
+	errored := "owner-anthropic-error-state"
+	RegisterOAuthSession(errored, "anthropic")
+	defer CompleteOAuthSession(errored)
+	resp, err = client.Get(base + "?error_description=denied&state=" + errored)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	payload, found = readCallbackPayload(t, authDir, "anthropic", errored)
+	if !found || payload.Error != "denied" || payload.Code != "" {
+		t.Fatalf("error callback file: found=%v payload=%+v", found, payload)
+	}
+
+	// Unknown, cancelled or wrong-provider states never produce a callback file.
+	unknown := "owner-unknown-state"
+	codexState := "owner-codex-state"
+	RegisterOAuthSession(codexState, "codex")
+	defer CompleteOAuthSession(codexState)
+	cancelled := "owner-cancelled-state"
+	RegisterOAuthSession(cancelled, "anthropic")
+	if !CancelOAuthSession(cancelled) {
+		t.Fatal("cancel must succeed for a pending session")
+	}
+	for _, state := range []string{unknown, codexState, cancelled} {
+		resp, err = client.Get(base + "?code=x&state=" + state)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			t.Fatalf("state %q: status=%d", state, resp.StatusCode)
+		}
+		if _, found = readCallbackPayload(t, authDir, "anthropic", state); found {
+			t.Fatalf("state %q must not be recorded", state)
+		}
+	}
+	if _, found = readCallbackPayload(t, authDir, "codex", codexState); found {
+		t.Fatal("anthropic forwarder must not complete a codex session")
+	}
+
+	resp, err = client.Post(base+"?code=x&state="+pending, "text/plain", strings.NewReader(""))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusMethodNotAllowed {
+		t.Fatalf("POST status=%d want 405", resp.StatusCode)
+	}
+}
+
+// Stock mode keeps redirecting to the public listener's native callback route.
+func TestStockModeCallbackForwarderStillRedirectsToPublicListener(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cfg := &config.Config{AuthDir: t.TempDir()}
+	cfg.Port = 8317
+	cfg.TLS.Enable = true
+	h := NewHandlerWithoutConfigFilePath(cfg, nil)
+
+	port := freeLoopbackPort(t)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	forwarder, ok := h.startProviderCallbackForwarder(c, port, "codex", "/codex/callback")
+	if !ok || forwarder == nil {
+		t.Fatal("stock forwarder did not start")
+	}
+	defer stopCallbackForwarderInstance(port, forwarder)
+
+	client := &http.Client{Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	resp, err := client.Get("http://127.0.0.1:" + strconv.Itoa(port) + "/callback?code=c&state=s")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusFound || resp.Header.Get("Location") != "https://127.0.0.1:8317/codex/callback?code=c&state=s" {
+		t.Fatalf("stock redirect: status=%d location=%q", resp.StatusCode, resp.Header.Get("Location"))
+	}
+
+	cfg.Port = 0
+	recorder := httptest.NewRecorder()
+	c, _ = gin.CreateTestContext(recorder)
+	if _, ok = h.startProviderCallbackForwarder(c, port, "codex", "/codex/callback"); ok {
+		t.Fatal("stock mode must refuse to start without a public port")
+	}
+	if recorder.Code != http.StatusInternalServerError || !strings.Contains(recorder.Body.String(), "callback server unavailable") {
+		t.Fatalf("stock unavailable response: status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+}
diff --git a/internal/api/handlers/management/auth_files_plugin_oauth_owner_test.go b/internal/api/handlers/management/auth_files_plugin_oauth_owner_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..384ab25e880351b34e593897a19f646f619ff3c7
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_plugin_oauth_owner_test.go
@@ -0,0 +1,427 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/hermesowner"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// waitCallbackClosed fails unless target stops accepting connections promptly.
+func waitCallbackClosed(t *testing.T, client *http.Client, target string) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		resp, err := client.Get(target)
+		if err != nil {
+			return
+		}
+		_ = resp.Body.Close()
+		if time.Now().After(deadline) {
+			t.Fatalf("callback listener %s is still accepting connections", target)
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
+
+// callbackReachable reports whether the listener behind target still answers.
+func callbackReachable(client *http.Client, target string) bool {
+	resp, err := client.Get(target)
+	if err != nil {
+		return false
+	}
+	_ = resp.Body.Close()
+	return true
+}
+
+// An owner-supervised instance whose public listener is unreachable (no
+// management secret, non-loopback bind, TLS, dead port) must still complete a
+// plugin-provider browser redirect. The plugin consumes BaseURL exactly as a
+// real OAuth plugin does, as the redirect_uri inside the authorization URL, and
+// the test reaches the callback only through that URL.
+func TestOwnerModePluginOAuthUsesLoopbackCallbackListener(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	prevInterval := pluginCallbackWatchInterval
+	pluginCallbackWatchInterval = 20 * time.Millisecond
+	t.Cleanup(func() { pluginCallbackWatchInterval = prevInterval })
+
+	authDir := filepath.Join(t.TempDir(), "auths")
+	cfg := &config.Config{AuthDir: authDir}
+	cfg.Host = "127.0.0.2"
+	cfg.Port = freeLoopbackPort(t) // nothing listens on the public port
+	cfg.TLS.Enable = true
+
+	var redirects []string
+	starts := 0
+	provider := &testAuthProvider{
+		identifier: "custom-sso",
+		startLogin: func(_ context.Context, req pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+			starts++
+			redirects = append(redirects, req.BaseURL)
+			state := fmt.Sprintf("owner-plugin-state-%d", starts)
+			if duplicate, _ := req.Metadata["duplicate_state"].(string); duplicate != "" {
+				state = duplicate
+			}
+			return pluginapi.AuthLoginStartResponse{
+				Provider: req.Provider,
+				URL:      "https://login.example.com/authorize?response_type=code&redirect_uri=" + url.QueryEscape(req.BaseURL) + "&state=" + state,
+				State:    state,
+			}, nil
+		},
+	}
+	broken := &testAuthProvider{
+		identifier: "broken-sso",
+		startLogin: func(_ context.Context, req pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+			redirects = append(redirects, req.BaseURL)
+			return pluginapi.AuthLoginStartResponse{}, errors.New("provider down")
+		},
+	}
+	host := pluginhost.New()
+	host.RegisterPluginForTest("custom-sso-plugin", pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: provider}})
+	host.RegisterPluginForTest("broken-sso-plugin", pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: broken}})
+
+	newRouter := func(ownerMode bool) *gin.Engine {
+		h := NewHandlerWithoutConfigFilePath(cfg, nil)
+		h.SetHermesOwnerMode(ownerMode)
+		h.SetPluginHost(host)
+		router := gin.New()
+		router.GET("/v8/management/oauth/auth-url", h.StartOAuthV8)
+		router.NoRoute(func(c *gin.Context) {
+			if !h.ServePluginAuthURL(c) {
+				c.AbortWithStatus(http.StatusNotFound)
+			}
+		})
+		return router
+	}
+	start := func(router *gin.Engine, target string) (int, map[string]any) {
+		t.Helper()
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, target, nil))
+		var body map[string]any
+		if rec.Body.Len() > 0 {
+			if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+				t.Fatalf("%s: body=%s err=%v", target, rec.Body.String(), err)
+			}
+		}
+		return rec.Code, body
+	}
+	redirectURI := func(body map[string]any) (string, *url.URL) {
+		t.Helper()
+		authURL, err := url.Parse(body["url"].(string))
+		if err != nil {
+			t.Fatal(err)
+		}
+		raw := authURL.Query().Get("redirect_uri")
+		parsed, err := url.Parse(raw)
+		if err != nil || raw == "" {
+			t.Fatalf("redirect_uri=%q err=%v", raw, err)
+		}
+		return raw, parsed
+	}
+	owner := newRouter(true)
+	client := &http.Client{Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+
+	status, body := start(owner, "/v8/management/oauth/auth-url?provider=custom-sso")
+	if status != http.StatusOK || body["status"] != "ok" {
+		t.Fatalf("owner start: status=%d body=%v", status, body)
+	}
+	state, _ := body["state"].(string)
+	if state != "owner-plugin-state-1" {
+		t.Fatalf("state=%q", state)
+	}
+	t.Cleanup(func() { CancelOAuthSession(state) })
+	callbackRaw, callback := redirectURI(body)
+	if callback.Scheme != "http" || callback.Hostname() != "127.0.0.1" || callback.Path != "/v8/management/oauth/callback" || callback.Port() == "" || callback.Port() == strconv.Itoa(cfg.Port) || callback.RawQuery != "" {
+		t.Fatalf("callback contract: redirect_uri=%q public port=%d", callbackRaw, cfg.Port)
+	}
+	if len(redirects) != 1 || redirects[0] != callbackRaw {
+		t.Fatalf("plugin BaseURL=%v redirect_uri=%q", redirects, callbackRaw)
+	}
+	if ln, err := net.Listen("tcp", "0.0.0.0:"+callback.Port()); err == nil {
+		_ = ln.Close()
+		t.Fatal("plugin callback listener left the wildcard address free; it must bind loopback only")
+	}
+	origin := "http://127.0.0.1:" + callback.Port()
+
+	// Only the callback path is served; nothing else exists on the listener.
+	resp, err := client.Get(origin + "/v8/management/config")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusNotFound {
+		t.Fatalf("foreign path status=%d want 404", resp.StatusCode)
+	}
+	resp, err = client.Post(callbackRaw+"?code=x&state="+state, "text/plain", strings.NewReader(""))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusMethodNotAllowed {
+		t.Fatalf("POST status=%d want 405", resp.StatusCode)
+	}
+
+	// Provider and state are bound: a pending session of another provider, an
+	// unknown state and a cancelled state are never recorded by this listener.
+	otherState := "owner-plugin-other-provider"
+	RegisterOAuthSession(otherState, "anthropic")
+	t.Cleanup(func() { CompleteOAuthSession(otherState) })
+	cancelledState := "owner-plugin-cancelled"
+	if errRegister := RegisterPluginOAuthSession(cancelledState, "custom-sso", nil); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	if !CancelOAuthSession(cancelledState) {
+		t.Fatal("cancel must succeed for a pending session")
+	}
+	for _, wrong := range []string{otherState, "owner-plugin-unknown", cancelledState} {
+		resp, err = client.Get(callbackRaw + "?code=x&state=" + wrong)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			t.Fatalf("state %q: status=%d", wrong, resp.StatusCode)
+		}
+		for _, providerName := range []string{"custom-sso", "anthropic"} {
+			if _, found := readCallbackPayload(t, authDir, providerName, wrong); found {
+				t.Fatalf("state %q must not be recorded for %s", wrong, providerName)
+			}
+		}
+	}
+
+	// The browser redirect completes natively for the pending plugin session.
+	resp, err = client.Get(callbackRaw + "?code=the-code%23frag&state=" + state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	page, _ := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK || resp.Header.Get("Location") != "" || !strings.Contains(string(page), "Authentication successful") {
+		t.Fatalf("native completion: status=%d location=%q body=%s", resp.StatusCode, resp.Header.Get("Location"), page)
+	}
+	payload, found := readCallbackPayload(t, authDir, "custom-sso", state)
+	if !found || payload.State != state || payload.Code != "the-code#frag" || payload.Error != "" {
+		t.Fatalf("callback file: found=%v payload=%+v", found, payload)
+	}
+	if !IsOAuthSessionPending(state, "custom-sso") || !callbackReachable(client, origin+"/") {
+		t.Fatal("listener must stay up while the session is pending")
+	}
+
+	// Terminal completion closes the listener.
+	CompleteOAuthSession(state)
+	waitCallbackClosed(t, client, origin+"/")
+
+	// A login that fails to start never leaves its listener behind.
+	if status, _ = start(owner, "/v8/management/oauth/auth-url?provider=broken-sso"); status != http.StatusInternalServerError {
+		t.Fatalf("broken start status=%d", status)
+	}
+	if len(redirects) != 2 || !strings.HasPrefix(redirects[1], "http://127.0.0.1:") {
+		t.Fatalf("broken provider BaseURL=%v", redirects)
+	}
+	waitCallbackClosed(t, client, redirects[1])
+
+	// A replaced or misbehaving plugin reusing a registered state cannot bind
+	// a second listener to it; the first session and listener are untouched.
+	status, body = start(owner, "/v8/management/oauth/auth-url?provider=custom-sso")
+	if status != http.StatusOK {
+		t.Fatalf("second start status=%d body=%v", status, body)
+	}
+	second, _ := body["state"].(string)
+	t.Cleanup(func() { CancelOAuthSession(second) })
+	secondRaw, _ := redirectURI(body)
+	if status, _ = start(owner, "/v8/management/oauth/auth-url?provider=custom-sso&duplicate_state="+second); status != http.StatusBadGateway {
+		t.Fatalf("duplicate state status=%d", status)
+	}
+	if len(redirects) != 4 || redirects[3] == secondRaw {
+		t.Fatalf("duplicate start BaseURLs=%v", redirects)
+	}
+	waitCallbackClosed(t, client, redirects[3])
+	if !callbackReachable(client, secondRaw) || !IsOAuthSessionPending(second, "custom-sso") {
+		t.Fatal("duplicate state must not disturb the first session's listener")
+	}
+
+	// Cancelling the session closes its listener.
+	if !CancelOAuthSession(second) {
+		t.Fatal("cancel must succeed for a pending session")
+	}
+	waitCallbackClosed(t, client, secondRaw)
+
+	// The legacy route gets the legacy callback path on its own listener.
+	status, body = start(owner, "/v0/management/custom-sso-auth-url")
+	if status != http.StatusOK {
+		t.Fatalf("legacy start status=%d body=%v", status, body)
+	}
+	legacyState, _ := body["state"].(string)
+	legacyRaw, legacy := redirectURI(body)
+	if legacy.Hostname() != "127.0.0.1" || legacy.Scheme != "http" || legacy.Path != "/v0/management/oauth-callback" || legacy.Port() == strconv.Itoa(cfg.Port) {
+		t.Fatalf("legacy callback contract: %q", legacyRaw)
+	}
+	if !CancelOAuthSession(legacyState) {
+		t.Fatal("cancel must succeed for the legacy session")
+	}
+	waitCallbackClosed(t, client, legacyRaw)
+
+	// Stock mode keeps handing plugins the public listener's callback route.
+	status, body = start(newRouter(false), "/v8/management/oauth/auth-url?provider=custom-sso")
+	if status != http.StatusOK {
+		t.Fatalf("stock start status=%d body=%v", status, body)
+	}
+	stockState, _ := body["state"].(string)
+	t.Cleanup(func() { CancelOAuthSession(stockState) })
+	if want := "https://127.0.0.1:" + strconv.Itoa(cfg.Port) + "/v8/management/oauth/callback"; redirects[len(redirects)-1] != want {
+		t.Fatalf("stock BaseURL=%q want %q", redirects[len(redirects)-1], want)
+	}
+}
+
+// The watcher stops a listener whose session is not pending at the default
+// interval and without any registry hook; the TTL deadline is the backstop.
+func TestPluginCallbackListenerStopsForNonPendingSession(t *testing.T) {
+	listener, err := startPluginCallbackListener("custom-sso", t.TempDir(), "/v8/management/oauth/callback")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(listener.baseURL, "http://127.0.0.1:") || !strings.HasSuffix(listener.baseURL, "/v8/management/oauth/callback") {
+		t.Fatalf("baseURL=%q", listener.baseURL)
+	}
+	done := make(chan struct{})
+	go func() {
+		// An unregistered state is never pending, so the watcher stops on its
+		// first tick rather than waiting for the TTL deadline.
+		listener.watchSession("never-registered")
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("watcher did not stop for a non-pending session")
+	}
+	client := &http.Client{Timeout: time.Second}
+	if callbackReachable(client, listener.baseURL) {
+		t.Fatal("listener still reachable after the watcher stopped")
+	}
+	// Stopping again is harmless.
+	listener.stop()
+	var nilListener *pluginCallbackListener
+	nilListener.stop()
+}
+
+// A reviewed login start runs only the plugin instance captured with the
+// registry incarnation: a replacement installed while the reviewed code runs
+// is never started under that review, the old review is refused afterwards
+// with no listener left behind, and a fresh review reaches the replacement.
+func TestOwnerModePluginOAuthReviewBindsCapturedInstance(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	prevInterval := pluginCallbackWatchInterval
+	pluginCallbackWatchInterval = 20 * time.Millisecond
+	t.Cleanup(func() { pluginCallbackWatchInterval = prevInterval })
+
+	cfg := &config.Config{AuthDir: filepath.Join(t.TempDir(), "auths")}
+	cfg.Port = freeLoopbackPort(t)
+	host := pluginhost.New()
+	var redirects []string
+	replacementStarts := 0
+	replacement := &testAuthProvider{
+		identifier: "custom-sso",
+		startLogin: func(_ context.Context, req pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+			replacementStarts++
+			redirects = append(redirects, req.BaseURL)
+			return pluginapi.AuthLoginStartResponse{Provider: req.Provider, URL: "https://login.example.com/?redirect_uri=" + url.QueryEscape(req.BaseURL), State: "owner-review-replacement"}, nil
+		},
+	}
+	reviewed := &testAuthProvider{
+		identifier: "custom-sso",
+		startLogin: func(_ context.Context, req pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+			redirects = append(redirects, req.BaseURL)
+			// The plugin is replaced behind the same id while the reviewed code runs.
+			host.ReplacePluginForTest("custom-sso-plugin", pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: replacement}})
+			return pluginapi.AuthLoginStartResponse{Provider: req.Provider, URL: "https://login.example.com/?redirect_uri=" + url.QueryEscape(req.BaseURL), State: "owner-review-reviewed"}, nil
+		},
+	}
+	host.RegisterPluginForTest("custom-sso-plugin", pluginapi.Plugin{Capabilities: pluginapi.Capabilities{AuthProvider: reviewed}})
+	h := NewHandlerWithoutConfigFilePath(cfg, nil)
+	h.SetHermesOwnerMode(true)
+	h.SetPluginHost(host)
+	router := gin.New()
+	router.GET("/v8/management/oauth/auth-url", h.StartOAuthV8)
+	client := &http.Client{Timeout: 5 * time.Second}
+
+	listed := host.RegisteredManagementRoutes()
+	if len(listed.Dispatches) != 1 || listed.Dispatches[0].PluginID != "custom-sso-plugin" || listed.Dispatches[0].OAuthProvider != "custom-sso" || listed.Dispatches[0].Quota {
+		t.Fatalf("dispatches = %+v", listed.Dispatches)
+	}
+	start := func(revision string) (*httptest.ResponseRecorder, map[string]any) {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodGet, "/v8/management/oauth/auth-url?provider=custom-sso", nil)
+		req.Header.Set(hermesowner.PluginRevisionHeader, revision)
+		req = req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, req)
+		var body map[string]any
+		_ = json.Unmarshal(rec.Body.Bytes(), &body)
+		return rec, body
+	}
+
+	rec, body := start(listed.Revision)
+	if rec.Code != http.StatusOK || body["state"] != "owner-review-reviewed" || replacementStarts != 0 || len(redirects) != 1 {
+		t.Fatalf("reviewed start: status=%d body=%v replacement=%d redirects=%v", rec.Code, body, replacementStarts, redirects)
+	}
+	t.Cleanup(func() { CancelOAuthSession("owner-review-reviewed") })
+	if rec.Header().Get(hermesowner.PluginInvokedHeader) != "1" || rec.Header().Get(hermesowner.PluginRevisionHeader) != listed.Revision {
+		t.Fatalf("reviewed start markers = %v", rec.Header())
+	}
+	if !callbackReachable(client, redirects[0]) || !IsOAuthSessionPending("owner-review-reviewed", "custom-sso") {
+		t.Fatal("reviewed session must stay pending with its listener up")
+	}
+	current := host.RegistryRevision()
+	if current == listed.Revision {
+		t.Fatal("in-flight replacement did not advance the revision")
+	}
+
+	// The old review is refused before any listener or plugin code.
+	rec, body = start(listed.Revision)
+	if rec.Code != http.StatusPreconditionFailed || body["error"] != "stale_plugin_revision" || body["registry_revision"] != current || replacementStarts != 0 || len(redirects) != 1 {
+		t.Fatalf("stale review: status=%d body=%v replacement=%d redirects=%v", rec.Code, body, replacementStarts, redirects)
+	}
+	if rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || rec.Header().Get(hermesowner.PluginRevisionHeader) != current {
+		t.Fatalf("stale review markers = %v", rec.Header())
+	}
+
+	// A fresh review at the current incarnation reaches the replacement.
+	rec, body = start(current)
+	if rec.Code != http.StatusOK || body["state"] != "owner-review-replacement" || replacementStarts != 1 || len(redirects) != 2 {
+		t.Fatalf("re-reviewed start: status=%d body=%v replacement=%d redirects=%v", rec.Code, body, replacementStarts, redirects)
+	}
+	t.Cleanup(func() { CancelOAuthSession("owner-review-replacement") })
+	if rec.Header().Get(hermesowner.PluginInvokedHeader) != "1" || rec.Header().Get(hermesowner.PluginRevisionHeader) != current {
+		t.Fatalf("re-reviewed start markers = %v", rec.Header())
+	}
+
+	// Each session owns its listener; cancelling closes exactly that one.
+	if !CancelOAuthSession("owner-review-reviewed") {
+		t.Fatal("cancel must succeed for the reviewed session")
+	}
+	waitCallbackClosed(t, client, redirects[0])
+	if !callbackReachable(client, redirects[1]) {
+		t.Fatal("cancelling one session closed another session's listener")
+	}
+	if !CancelOAuthSession("owner-review-replacement") {
+		t.Fatal("cancel must succeed for the replacement session")
+	}
+	waitCallbackClosed(t, client, redirects[1])
+}
