+		"port":       {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/server/port", BodyBase64: b64(`9000`)}, []string{ConfigV8EffectRestartRequired, ConfigV8EffectPublicListenerChanged, ConfigV8EffectPendingOAuthInvalidated}},
+		"tls":        {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/server/tls", BodyBase64: b64(`{"enable":false,"cert":"/c","key":"/k"}`)}, []string{ConfigV8EffectRestartRequired, ConfigV8EffectPublicListenerChanged, ConfigV8EffectPendingOAuthInvalidated}},
