+func TestResourceRevisionPreconditionMarkersAndPublicBehaviour(t *testing.T) {
+	handler := &countingResourceHandler{body: "ok", status: http.StatusNotFound, forgeHost: true}
+	host := resourceHost(t, handler)
+	listed := host.RegisteredManagementRoutes()
+
+	// Public listener: the private header is ignored, no markers are emitted,
+	// forged plugin markers are dropped, the plugin never sees the header.
+	rec := httptest.NewRecorder()
+	if !host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelNone, "definitely-not-the-revision", true)) {
+		t.Fatal("public request was not served")
+	}
+	if rec.Code != http.StatusNotFound || rec.Body.String() != "ok" || handler.calls.Load() != 1 {
+		t.Fatalf("public: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), handler.calls.Load())
+	}
+	for _, name := range []string{hermesowner.ResourceInvokedHeader, hermesowner.ResourceRevisionHeader, "X-Hermes-Resource-Rejected"} {
+		if rec.Header().Get(name) != "" {
+			t.Fatalf("public response leaked %s=%q", name, rec.Header().Get(name))
+		}
+	}
+	if seen := handler.seen.Load(); seen == nil || (*seen).Get(hermesowner.ResourceRevisionHeader) != "" {
+		t.Fatalf("plugin saw private header: %v", seen)
+	}
+
+	// Inference channel is not the control channel either.
+	rec = httptest.NewRecorder()
+	host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelInference, "x", true))
+	if rec.Code != http.StatusNotFound || handler.calls.Load() != 2 || rec.Header().Get(hermesowner.ResourceInvokedHeader) != "" {
+		t.Fatalf("inference: status=%d calls=%d headers=%v", rec.Code, handler.calls.Load(), rec.Header())
+	}
+
+	// Control channel without an assertion: native dispatch plus host truth; a
+	// plugin 404 is still Invoked:1.
+	rec = httptest.NewRecorder()
+	host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, "", false))
+	if rec.Code != http.StatusNotFound || handler.calls.Load() != 3 {
+		t.Fatalf("control no-assert: status=%d calls=%d", rec.Code, handler.calls.Load())
+	}
+	if got := rec.Header().Values(hermesowner.ResourceInvokedHeader); len(got) != 1 || got[0] != "1" {
+		t.Fatalf("control no-assert markers = %v", rec.Header())
+	}
+	if rec.Header().Get(hermesowner.ResourceRevisionHeader) != listed.Revision || rec.Header().Get("X-Hermes-Resource-Rejected") != "" {
+		t.Fatalf("control no-assert markers = %v", rec.Header())
+	}
+
+	// Unknown route at the reviewed revision: native not-found with host Invoked:0.
+	rec = httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/v0/resource/plugins/acct/missing", nil)
+	req.Header.Set(hermesowner.ResourceRevisionHeader, listed.Revision)
+	if host.ServeResourceHTTP(rec, req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))) {
+		t.Fatal("unknown route must fall through to native not-found")
+	}
+	if rec.Header().Get(hermesowner.ResourceInvokedHeader) != "0" || rec.Header().Get(hermesowner.ResourceRevisionHeader) != listed.Revision {
+		t.Fatalf("unknown route markers = %v", rec.Header())
+	}
+	if handler.calls.Load() != 3 {
+		t.Fatal("unknown route invoked a handler")
+	}
+
+	// A fused plugin at the reviewed revision is stale: nothing runs.
+	host.fusePlugin("acct", "ResourceHandler.HandleManagement", "boom")
+	rec = httptest.NewRecorder()
+	host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, listed.Revision, true))
+	if rec.Code != http.StatusPreconditionFailed || rec.Header().Get(hermesowner.ResourceInvokedHeader) != "0" || handler.calls.Load() != 3 {
+		t.Fatalf("fused: status=%d calls=%d headers=%v", rec.Code, handler.calls.Load(), rec.Header())
+	}
+}
+
+func TestResourceHandlerFailureStillReportsInvoked(t *testing.T) {
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(managementHandlerFunc(func(context.Context, pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+		panic("resource exploded")
+	}))))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	listed := host.RegisteredManagementRoutes()
+
+	rec := httptest.NewRecorder()
+	if !host.ServeResourceHTTP(rec, resourceRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("failing handler was not served")
+	}
+	if rec.Code != http.StatusBadGateway || rec.Header().Get(hermesowner.ResourceInvokedHeader) != "1" || rec.Header().Get(hermesowner.ResourceRevisionHeader) != listed.Revision {
+		t.Fatalf("failure: status=%d headers=%v", rec.Code, rec.Header())
+	}
+	if after := host.RegisteredManagementRoutes(); after.Revision == listed.Revision {
+		t.Fatal("a panicking plugin is fused and must change the registry revision")
+	}
+}
