+// A captured instance is the only implementation that can run: replacing the
+// plugin after capture reports no invocation instead of running the new code,
+// and a replacement during the call never runs either.
+func TestCapturedQuotaDispatchNeverSwitchesImplementation(t *testing.T) {
+	var host *Host
+	calls := map[string]int{}
+	replacement := &testQuotaProvider{identifier: "metered", fetchFn: func(context.Context, pluginapi.QuotaFetchRequest) (pluginapi.QuotaFetchResponse, error) {
+		calls["replacement"]++
+		return pluginapi.QuotaFetchResponse{}, nil
+	}}
+	reviewed := &testQuotaProvider{identifier: "metered", fetchFn: func(context.Context, pluginapi.QuotaFetchRequest) (pluginapi.QuotaFetchResponse, error) {
+		calls["reviewed"]++
+		// Replace the plugin while the reviewed code runs.
+		setHostSnapshotForTest(host, true, quotaOnlyRecord("meter", 1, replacement))
+		return pluginapi.QuotaFetchResponse{Subscription: &pluginapi.QuotaSubscription{Plan: "reviewed"}}, nil
+	}}
+	host = newHostWithRecords(quotaOnlyRecord("meter", 1, reviewed))
+	listed := host.RegisteredManagementRoutes()
+
+	dispatch, revision, ok := host.CaptureQuotaProvider("meter")
+	if !ok || revision != listed.Revision || dispatch.PluginID() != "meter" {
+		t.Fatalf("capture: ok=%v revision=%s id=%s", ok, revision, dispatch.PluginID())
+	}
+	resp, outcome, err := host.FetchQuotaCaptured(context.Background(), dispatch, pluginapi.QuotaFetchRequest{AuthIndex: "idx"})
+	if err != nil || !outcome.Invoked || !outcome.Handled || resp.Subscription == nil || resp.Subscription.Plan != "reviewed" {
+		t.Fatalf("in-flight replacement: resp=%+v outcome=%+v err=%v", resp, outcome, err)
+	}
+	if calls["reviewed"] != 1 || calls["replacement"] != 0 {
+		t.Fatalf("calls = %v", calls)
+	}
+	if current := host.RegistryRevision(); current == revision {
+		t.Fatal("replacement during the call did not advance the revision")
+	}
+
+	// The stale capture can no longer run; nothing is invoked.
+	if _, outcome, err = host.FetchQuotaCaptured(context.Background(), dispatch, pluginapi.QuotaFetchRequest{}); outcome.Invoked || outcome.Handled || err != nil {
+		t.Fatalf("stale capture: outcome=%+v err=%v", outcome, err)
+	}
+	if _, outcome, err = host.ResetQuotaCaptured(context.Background(), dispatch, pluginapi.QuotaResetRequest{}); outcome.Invoked || err != nil {
+		t.Fatalf("stale reset capture: outcome=%+v err=%v", outcome, err)
+	}
+	if calls["replacement"] != 0 {
+		t.Fatal("stale capture ran the replacement")
+	}
+
+	// A fresh capture at the new revision runs the replacement.
+	dispatch, revision, ok = host.CaptureQuotaProvider("meter")
+	if !ok || revision != host.RegistryRevision() {
+		t.Fatalf("recapture: ok=%v revision=%s", ok, revision)
+	}
+	if _, outcome, err = host.FetchQuotaCaptured(context.Background(), dispatch, pluginapi.QuotaFetchRequest{}); err != nil || !outcome.Invoked || calls["replacement"] != 1 {
+		t.Fatalf("recaptured call: outcome=%+v err=%v calls=%v", outcome, err, calls)
+	}
+
+	// A panicking provider counts as invoked but not handled, and fuses the
+	// plugin so the next capture fails.
+	exploding := &testQuotaProvider{identifier: "metered", fetchFn: func(context.Context, pluginapi.QuotaFetchRequest) (pluginapi.QuotaFetchResponse, error) {
+		panic("quota exploded")
+	}}
+	setHostSnapshotForTest(host, true, quotaOnlyRecord("meter", 1, exploding))
+	dispatch, _, ok = host.CaptureQuotaProvider("meter")
+	if !ok {
+		t.Fatal("exploding plugin was not captured")
+	}
+	if _, outcome, err = host.FetchQuotaCaptured(context.Background(), dispatch, pluginapi.QuotaFetchRequest{}); !outcome.Invoked || outcome.Handled || err == nil {
+		t.Fatalf("panic outcome=%+v err=%v", outcome, err)
+	}
+	if _, _, ok = host.CaptureQuotaProvider("meter"); ok {
+		t.Fatal("a fused plugin must not be captured")
+	}
+}
