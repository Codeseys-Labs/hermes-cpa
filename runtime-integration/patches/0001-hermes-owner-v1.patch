+
+// countingManagementHandler records invocations and the request the plugin saw,
+// and tries to counterfeit every host-owned marker in its response.
+type countingManagementHandler struct {
+	body      string
+	status    int
+	calls     atomic.Int32
+	seen      atomic.Pointer[pluginapi.ManagementRequest]
+	onInvoke  func()
+	forgeHost bool
+}
+
+func (h *countingManagementHandler) HandleManagement(_ context.Context, req pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+	h.calls.Add(1)
+	captured := req
+	captured.Headers = cloneHeader(req.Headers)
+	h.seen.Store(&captured)
+	if h.onInvoke != nil {
+		h.onInvoke()
+	}
+	resp := pluginapi.ManagementResponse{StatusCode: h.status, Body: []byte(h.body), Headers: http.Header{"Content-Type": []string{"text/plain"}}}
+	if h.forgeHost {
+		resp.Headers.Set(hermesowner.PluginInvokedHeader, "0")
+		resp.Headers.Set(hermesowner.PluginRevisionHeader, "forged")
+		resp.Headers.Set(hermesowner.ResourceInvokedHeader, "1")
+		resp.Headers.Set("X-Hermes-Plugin-Rejected", "forged")
+	}
+	return resp, nil
+}
+
+// managementRoutePath is the declared route registryPlugin registers.
+const managementRoutePath = "/v0/management/plugins/acct/sync"
+
+func managementHost(t *testing.T, handler pluginapi.ManagementHandler) *Host {
+	t.Helper()
+	host := newHostWithRecords(registryRecord("acct", registryPlugin(handler)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	return host
+}
+
+func managementRequest(channel hermesowner.Channel, revision string, assert bool) *http.Request {
+	req := httptest.NewRequest(http.MethodPost, managementRoutePath+"?dry_run=1", strings.NewReader("payload"))
+	req.Header.Set("Authorization", "Bearer public")
+	if assert {
+		req.Header.Set(hermesowner.PluginRevisionHeader, revision)
+	}
+	if channel != hermesowner.ChannelNone {
+		req = req.WithContext(hermesowner.WithChannel(req.Context(), channel))
+	}
+	return req
+}
+
+func TestPluginRevisionPreconditionDeniesReplacementBeforeHandler(t *testing.T) {
+	reviewed := &countingManagementHandler{body: "reviewed", forgeHost: true}
+	host := managementHost(t, reviewed)
+	listed := host.RegisteredManagementRoutes()
+	if len(listed.Management) != 1 || listed.Management[0].Method != http.MethodPost || listed.Management[0].Path != managementRoutePath {
+		t.Fatalf("declared routes = %+v", listed.Management)
+	}
+
+	// Matching assertion: the reviewed handler runs with the full request, never
+	// sees the private header, and cannot counterfeit any host marker.
+	rec := httptest.NewRecorder()
+	if !host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("matching assertion was not served")
+	}
+	if rec.Code != http.StatusOK || rec.Body.String() != "reviewed" || reviewed.calls.Load() != 1 {
+		t.Fatalf("matching dispatch: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), reviewed.calls.Load())
+	}
+	if got := rec.Header().Values(hermesowner.PluginInvokedHeader); len(got) != 1 || got[0] != "1" {
+		t.Fatalf("%s = %v want exactly [1]", hermesowner.PluginInvokedHeader, got)
+	}
+	if got := rec.Header().Values(hermesowner.PluginRevisionHeader); len(got) != 1 || got[0] != listed.Revision {
+		t.Fatalf("%s = %v want exactly [%s]", hermesowner.PluginRevisionHeader, got, listed.Revision)
+	}
+	for _, name := range []string{hermesowner.ResourceInvokedHeader, hermesowner.ResourceRevisionHeader, "X-Hermes-Plugin-Rejected"} {
+		if rec.Header().Get(name) != "" {
+			t.Fatalf("management response carried %s=%q", name, rec.Header().Get(name))
+		}
+	}
+	if rec.Header().Get("Content-Type") != "text/plain" {
+		t.Fatalf("plugin headers = %v", rec.Header())
+	}
+	seen := reviewed.seen.Load()
+	if seen == nil || seen.Headers.Get(hermesowner.PluginRevisionHeader) != "" || seen.Headers.Get("Authorization") != "Bearer public" {
+		t.Fatalf("plugin saw headers %v", seen)
+	}
+	if seen.Method != http.MethodPost || seen.Path != managementRoutePath || seen.Query.Get("dry_run") != "1" || string(seen.Body) != "payload" {
+		t.Fatalf("plugin saw request %+v", seen)
+	}
+
+	// Same id, path, version and routes, but replacement code between listing and dispatch.
+	replacement := &countingManagementHandler{body: "replacement"}
+	setHostSnapshotForTest(host, true, registryRecord("acct", registryPlugin(replacement)))
+	host.RegisterManagementRoutes(context.Background(), nil)
+	current := host.RegisteredManagementRoutes()
+	if current.Revision == listed.Revision {
+		t.Fatal("replacement did not change the revision")
+	}
+
+	rec = httptest.NewRecorder()
+	if !host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, listed.Revision, true)) {
+		t.Fatal("stale assertion must be answered by the host")
+	}
+	if rec.Code != http.StatusPreconditionFailed || !strings.Contains(rec.Body.String(), `"error":"stale_plugin_revision"`) || !strings.Contains(rec.Body.String(), current.Revision) {
+		t.Fatalf("stale assertion: status=%d body=%s", rec.Code, rec.Body.String())
+	}
+	if rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" || rec.Header().Get(hermesowner.PluginRevisionHeader) != current.Revision || rec.Header().Get("Cache-Control") != "no-store" {
+		t.Fatalf("stale assertion headers = %v", rec.Header())
+	}
+	if reviewed.calls.Load() != 1 || replacement.calls.Load() != 0 {
+		t.Fatalf("stale assertion invoked a handler: reviewed=%d replacement=%d", reviewed.calls.Load(), replacement.calls.Load())
+	}
+
+	// Re-reviewed at the current revision the replacement serves normally.
+	rec = httptest.NewRecorder()
+	host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, current.Revision, true))
+	if rec.Code != http.StatusOK || rec.Body.String() != "replacement" || replacement.calls.Load() != 1 {
+		t.Fatalf("current assertion: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), replacement.calls.Load())
+	}
+
+	// Empty or malformed assertions never match.
+	for _, value := range []string{"", "none-0", strings.ToUpper(current.Revision), " " + current.Revision + " ,x"} {
+		rec = httptest.NewRecorder()
+		host.ServeManagementHTTP(rec, managementRequest(hermesowner.ChannelControl, value, true))
+		if rec.Code != http.StatusPreconditionFailed || rec.Header().Get(hermesowner.PluginInvokedHeader) != "0" {
+			t.Fatalf("assertion %q: status=%d headers=%v", value, rec.Code, rec.Header())
+		}
+	}
+	if replacement.calls.Load() != 1 {
+		t.Fatal("malformed assertions invoked the handler")
+	}
+
+	// The two assertion namespaces are disjoint: a resource revision on a
+	// management route is not an assertion, and a plugin revision on a resource
+	// route is not one either. Neither can satisfy or fail the other review.
+	rec = httptest.NewRecorder()
+	req := managementRequest(hermesowner.ChannelControl, "", false)
+	req.Header.Set(hermesowner.ResourceRevisionHeader, "definitely-not-the-revision")
+	host.ServeManagementHTTP(rec, req)
+	if rec.Code != http.StatusOK || rec.Body.String() != "replacement" || replacement.calls.Load() != 2 {
+		t.Fatalf("resource header on management route: status=%d body=%q calls=%d", rec.Code, rec.Body.String(), replacement.calls.Load())
+	}
+	if rec.Header().Get(hermesowner.PluginInvokedHeader) != "1" || rec.Header().Get(hermesowner.PluginRevisionHeader) != current.Revision || rec.Header().Get(hermesowner.ResourceInvokedHeader) != "" || rec.Header().Get(hermesowner.ResourceRevisionHeader) != "" {
+		t.Fatalf("resource header on management route markers = %v", rec.Header())
+	}
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/v0/resource/plugins/acct/panel", nil)
+	req.Header.Set(hermesowner.PluginRevisionHeader, "definitely-not-the-revision")
+	if !host.ServeResourceHTTP(rec, req.WithContext(hermesowner.WithChannel(req.Context(), hermesowner.ChannelControl))) {
+		t.Fatal("resource route was not served")
+	}
+	if rec.Code != http.StatusOK || replacement.calls.Load() != 3 {
+		t.Fatalf("plugin header on resource route: status=%d calls=%d", rec.Code, replacement.calls.Load())
+	}
+	if rec.Header().Get(hermesowner.ResourceInvokedHeader) != "1" || rec.Header().Get(hermesowner.ResourceRevisionHeader) != current.Revision || rec.Header().Get(hermesowner.PluginInvokedHeader) != "" || rec.Header().Get(hermesowner.PluginRevisionHeader) != "" {
+		t.Fatalf("plugin header on resource route markers = %v", rec.Header())
+	}
+}
