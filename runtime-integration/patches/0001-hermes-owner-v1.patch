+func newConfigV8Router(t *testing.T, path string) (*Handler, *gin.Engine) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	cfg, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &Handler{cfg: cfg, configFilePath: path}
+	router := gin.New()
+	router.GET("/v8/management/config", h.ConfigV8)
+	router.PUT("/v8/management/config", h.ConfigV8)
+	router.PATCH("/v8/management/config", h.ConfigV8)
+	router.GET("/v8/management/config.yaml", h.ConfigV8)
+	router.PUT("/v8/management/config.yaml", h.ConfigV8)
+	for _, method := range []string{http.MethodGet, http.MethodPut, http.MethodPatch, http.MethodDelete} {
+		router.Handle(method, "/v8/management/config/*path", h.ConfigV8)
+	}
+	router.POST("/hermes/config/prepare", h.HermesConfigPrepare)
+	router.POST("/hermes/config/commit", h.HermesConfigCommit)
+	return h, router
+}
