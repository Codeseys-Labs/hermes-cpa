+	public := map[string]string{"Authorization": "Bearer test-password", hermesowner.PluginRevisionHeader: "0123456789abcdef-999"}
+	for _, target := range []string{"/v0/management/plugins/acct/status", "/v8/management/plugins/meter/quota?auth_index=" + authIndex} {
+		got = serve(s, channelRequest(hermesowner.ChannelNone, http.MethodGet, target, "", public))
+		if got.Code != http.StatusOK || got.Header().Get(hermesowner.PluginInvokedHeader) != "" || got.Header().Get(hermesowner.PluginRevisionHeader) != "" {
+			t.Fatalf("public %s: status=%d headers=%v body=%s", target, got.Code, got.Header(), got.Body.String())
+		}
+	}
+	if statusHandler.calls.Load() != 2 || replacement.fetches.Load() != 3 {
+		t.Fatalf("public dispatch counts: status=%d fetches=%d", statusHandler.calls.Load(), replacement.fetches.Load())
+	}
+	got = serve(s, channelRequest(hermesowner.ChannelInference, http.MethodGet, "/v0/management/plugins/acct/status", "", public))
+	if got.Code != http.StatusNotFound || statusHandler.calls.Load() != 2 {
+		t.Fatalf("inference channel: status=%d calls=%d", got.Code, statusHandler.calls.Load())
+	}
+}
