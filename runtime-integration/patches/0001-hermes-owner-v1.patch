+// watchSession stops the listener once the session for state is no longer
+// pending for this provider, and unconditionally once the native session TTL
+// has passed, so a lost terminal transition can never leak the listener.
+func (l *pluginCallbackListener) watchSession(state string) {
+	defer l.stop()
+	ticker := time.NewTicker(l.watchInterval)
+	defer ticker.Stop()
+	deadline := time.NewTimer(oauthSessionTTL + l.watchInterval)
+	defer deadline.Stop()
+	for {
+		select {
+		case <-deadline.C:
+			return
+		case <-ticker.C:
+			if !IsOAuthSessionPending(state, l.provider) {
+				return
+			}
+		}
+	}
 }
 
