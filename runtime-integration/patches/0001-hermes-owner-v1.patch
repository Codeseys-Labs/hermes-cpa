+// repositoryStorageRefresher is implemented by go-git's filesystem storage, which is what
+// git.PlainOpen and git.PlainClone give every repository this store opens.
+type repositoryStorageRefresher interface {
+	CloseIdleDescriptors() error
+	Reindex() error
+}
+
+// refreshRepositoryStorage drops the open handle's cached view of the object store. Since go-git
+// v6.0.0-alpha.5 a handle keeps the pack inventory it first listed, serves objects of those packs
+// from its object cache without touching the pack files, and keeps pack descriptors open, so a
+// pack deleted after the handle read it stays readable. Re-listing the packs on disk, and
+// releasing the descriptors of the previous listing, makes later reads see the repository as it
+// is now: a missing pack is no longer routed to, and its objects are looked up in the loose store
+// or reported as plumbing.ErrObjectNotFound.
+func refreshRepositoryStorage(repo *git.Repository) error {
+	refresher, ok := repo.Storer.(repositoryStorageRefresher)
+	if !ok {
+		return nil
+	}
+	if errRelease := refresher.CloseIdleDescriptors(); errRelease != nil {
+		return fmt.Errorf("release repository descriptors: %w", errRelease)
+	}
+	if errReindex := refresher.Reindex(); errReindex != nil {
+		return fmt.Errorf("rescan repository packs: %w", errReindex)
+	}
+	return nil
+}
