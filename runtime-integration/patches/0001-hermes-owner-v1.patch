+// startCallbackForwarder listens on all interfaces for the provider's fixed-port
+// browser redirect and forwards it to the management callback.
 func startCallbackForwarder(port int, provider, targetBase string) (*callbackForwarder, error) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		target := targetBase
+		if raw := r.URL.RawQuery; raw != "" {
+			if strings.Contains(target, "?") {
+				target = target + "&" + raw
+			} else {
+				target = target + "?" + raw
+			}
+		}
+		w.Header().Set("Cache-Control", "no-store")
+		http.Redirect(w, r, target, http.StatusFound)
+	})
+	return startCallbackListener(port, provider, fmt.Sprintf("0.0.0.0:%d", port), handler)
+}
+
+// startNativeCallbackForwarder listens on loopback only and completes the
+// provider callback in place for a supervised instance.
+func startNativeCallbackForwarder(port int, provider, authDir string) (*callbackForwarder, error) {
+	if strings.TrimSpace(authDir) == "" {
+		return nil, fmt.Errorf("auth dir is not configured")
+	}
+	return startCallbackListener(port, provider, fmt.Sprintf("127.0.0.1:%d", port), NativeOAuthCallbackHandler(authDir, provider))
+}
+
+// NativeOAuthCallbackHandler serves a provider redirect exactly like the public
+// /<provider>/callback route: the code/state/error query is recorded for the
+// matching pending session only, and the browser always receives the native
+// success page. No credential or management authority is involved.
+func NativeOAuthCallbackHandler(authDir, provider string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			w.Header().Set("Allow", "GET, HEAD")
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		query := r.URL.Query()
+		code := query.Get("code")
+		state := query.Get("state")
+		errStr := query.Get("error")
+		if errStr == "" {
+			errStr = query.Get("error_description")
+		}
+		if state != "" {
+			if _, errWrite := WriteOAuthCallbackFileForPendingSession(authDir, provider, state, code, errStr); errWrite != nil {
+				log.WithError(errWrite).Debugf("native %s callback ignored", provider)
+			}
+		}
+		w.Header().Set("Cache-Control", "no-store")
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		w.WriteHeader(http.StatusOK)
+		if r.Method == http.MethodGet {
+			_, _ = w.Write([]byte(OAuthCallbackSuccessHTML))
+		}
+	})
+}
