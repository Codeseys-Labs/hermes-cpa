index 0000000000000000000000000000000000000000..c65dd7fef9d95e83817a16e2c81bbd6ef2c4dbb8
--- /dev/null
+++ b/internal/api/handlers/management/config_v8_prepare.go
@@ -0,0 +1,615 @@
+package management
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"reflect"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"gopkg.in/yaml.v3"
+)
+
+// Problem codes shared with the Hermes supervisor.
+const (
+	ConfigV8CodeStaleRevision     = "STALE_REVISION"
+	ConfigV8CodeInvalidRequest    = "INVALID_REQUEST"
+	ConfigV8CodeInvalidConfig     = "INVALID_CONFIG"
+	ConfigV8CodeNotFound          = "NOT_FOUND"
+	ConfigV8CodeReadOnlyField     = "READ_ONLY_FIELD"
+	ConfigV8CodeCandidateMismatch = "CANDIDATE_MISMATCH"
+	ConfigV8CodeRestartRequired   = "RESTART_REQUIRED"
+	ConfigV8CodeReadFailed        = "READ_FAILED"
+	ConfigV8CodeWriteFailed       = "WRITE_FAILED"
+)
+
+// Effects reported for a prepared candidate.
+const (
+	ConfigV8EffectRestartRequired         = "restart_required"
+	ConfigV8EffectPublicListenerChanged   = "public_listener_changed"
+	ConfigV8EffectAuthDirChanged          = "auth_dir_changed"
+	ConfigV8EffectPendingOAuthInvalidated = "pending_oauth_invalidated"
+	ConfigV8EffectManagementAccessChanged = "management_access_changed"
+	ConfigV8EffectAccessKeysChanged       = "access_keys_changed"
+	ConfigV8EffectProviderCredsChanged    = "provider_credentials_changed"
+	ConfigV8EffectProxyChanged            = "proxy_changed"
+	ConfigV8EffectPluginsChanged          = "plugins_changed"
+	ConfigV8EffectNoChange                = "no_change"
+)
+
+const configV8RoutePrefix = "/v8/management/config"
+
+// ConfigV8Request is one native config write expressed as a request.
+type ConfigV8Request struct {
+	Method      string            `json:"method"`
+	Path        string            `json:"path"`
+	Query       map[string]string `json:"query,omitempty"`
+	ContentType string            `json:"content_type,omitempty"`
+	BodyBase64  string            `json:"body_base64,omitempty"`
+}
+
+// ConfigV8PrepareRequest is an ordered config transaction to validate.
+type ConfigV8PrepareRequest struct {
+	ExpectedRevision string            `json:"expected_revision"`
+	Requests         []ConfigV8Request `json:"requests"`
+}
+
+// ConfigV8Candidate is the validated, canonical result of a transaction.
+type ConfigV8Candidate struct {
+	BaseRevision      string   `json:"base_revision"`
+	CandidateRevision string   `json:"candidate_revision"`
+	CandidateBase64   string   `json:"candidate_base64"`
+	Effects           []string `json:"effects"`
+	ChangedPaths      []string `json:"changed_paths"`
+}
+
+// ConfigV8CommitRequest persists a previously prepared candidate.
+type ConfigV8CommitRequest struct {
+	ExpectedRevision  string `json:"expected_revision"`
+	CandidateRevision string `json:"candidate_revision"`
+	CandidateBase64   string `json:"candidate_base64"`
+}
+
+// ConfigV8Problem is the structured failure for prepare/commit. Native is the
+// native snake_case error value; Message carries the native validation text.
+type ConfigV8Problem struct {
+	Status       int      `json:"status"`
+	Code         string   `json:"code"`
+	Native       string   `json:"error"`
+	Message      string   `json:"message,omitempty"`
+	Field        string   `json:"field,omitempty"`
+	RequestIndex *int     `json:"request_index,omitempty"`
+	BaseRevision string   `json:"base_revision,omitempty"`
+	Effects      []string `json:"effects,omitempty"`
+}
+
+func newConfigV8Problem(status int, code, native, message string) *ConfigV8Problem {
+	return &ConfigV8Problem{Status: status, Code: code, Native: native, Message: message}
+}
+
+// ConfigRevision is the SHA-256 of the exact persisted bytes.
+func ConfigRevision(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+// readConfigBase returns the persisted bytes; an absent file is an empty document.
+func readConfigBase(path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	return data, err
+}
+
+// CurrentConfigRevision reports the revision of the persisted configuration.
+func (h *Handler) CurrentConfigRevision() (string, error) {
+	if h == nil {
+		return "", errors.New("management handler is nil")
+	}
+	h.mu.Lock()
+	data, err := readConfigBase(h.configFilePath)
+	h.mu.Unlock()
+	if err != nil {
+		return "", err
+	}
+	return ConfigRevision(data), nil
+}
+
+// configV8Mutation is one native config write.
+type configV8Mutation struct {
+	method      string
+	parts       []string
+	yamlRequest bool
+	body        []byte
+}
+
+// configV8Failure mirrors the JSON the native ConfigV8 handler returns.
+type configV8Failure struct {
+	status int
+	body   gin.H
+}
+
+func configV8Fail(status int, body gin.H) *configV8Failure {
+	return &configV8Failure{status: status, body: body}
+}
+
+func (f *configV8Failure) problem(index int) *ConfigV8Problem {
+	native, _ := f.body["error"].(string)
+	message, _ := f.body["message"].(string)
+	field, _ := f.body["field"].(string)
+	code := ConfigV8CodeInvalidConfig
+	switch native {
+	case "not_found":
+		code = ConfigV8CodeNotFound
+	case "read_only_field":
+		code = ConfigV8CodeReadOnlyField
+	case "read_failed":
+		code = ConfigV8CodeReadFailed
+	case "write_failed":
+		code = ConfigV8CodeWriteFailed
+	}
+	problem := newConfigV8Problem(f.status, code, native, message)
+	problem.Field = field
+	if index >= 0 {
+		problem.RequestIndex = new(index)
+	}
+	return problem
+}
+
+// parseConfigV8Document applies the native layout normalization used by every
+// ConfigV8 read. allowEmpty treats an absent/empty document as an empty mapping
+// so a first configuration can be prepared.
+func parseConfigV8Document(data []byte, allowEmpty bool) (*yaml.Node, []byte, *configV8Failure) {
+	if allowEmpty && len(bytes.TrimSpace(data)) == 0 {
+		data = []byte("{}\n")
+	}
+	normalized, _, err := config.NormalizeConfigLayout(data, true)
+	if err != nil {
+		return nil, nil, configV8Fail(http.StatusInternalServerError, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	var doc yaml.Node
+	if err = yaml.Unmarshal(normalized, &doc); err != nil || len(doc.Content) == 0 || doc.Content[0] == nil {
+		return nil, nil, configV8Fail(http.StatusInternalServerError, gin.H{"error": "invalid_config"})
+	}
+	return &doc, normalized, nil
+}
+
+// applyConfigV8Mutation is the native write path without persistence. It returns
+// the exact bytes WriteConfig would persist and the parsed runtime config.
+func applyConfigV8Mutation(doc *yaml.Node, m configV8Mutation) ([]byte, *config.Config, *configV8Failure) {
+	root := doc.Content[0]
+	before := cloneConfigV8Node(root)
+	config.ProjectV8ConfigAliases(root, strings.Join(m.parts, "."))
+	if m.method == http.MethodDelete {
+		if len(m.parts) == 0 {
+			return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "cannot_delete_config"})
+		}
+		if !deleteConfigV8Path(root, m.parts) {
+			return nil, nil, configV8Fail(http.StatusNotFound, gin.H{"error": "not_found"})
+		}
+	} else {
+		body := m.body
+		if !m.yamlRequest && !json.Valid(body) {
+			return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_json"})
+		}
+		var update yaml.Node
+		if err := yaml.Unmarshal(body, &update); err != nil || len(update.Content) == 0 {
+			return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_body"})
+		}
+		stripAPIKeysAuthIndexesFromUpdate(m.parts, &update)
+		if len(m.parts) == 0 && update.Content[0].Kind != yaml.MappingNode {
+			return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "config_must_be_object"})
+		}
+		if len(m.parts) == 0 {
+			if err := config.NormalizeV8ConfigAliases(update.Content[0]); err != nil {
+				return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_config", "message": err.Error()})
+			}
+		}
+		// Paths identify YAML keys, never array indexes. Lists are replaced whole.
+		dst := root
+		for _, part := range m.parts {
+			if part == "" || dst.Kind != yaml.MappingNode {
+				return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_path"})
+			}
+			next := configV8Node(dst, []string{part})
+			if next == nil {
+				next = &yaml.Node{Kind: yaml.MappingNode, Tag: "!!map"}
+				dst.Content = append(dst.Content, &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: part}, next)
+			}
+			dst = next
+		}
+		if m.method == http.MethodPatch {
+			mergeConfigV8Patch(dst, update.Content[0])
+		} else {
+			if dst.Kind == yaml.ScalarNode && update.Content[0].Kind == yaml.ScalarNode {
+				update.Content[0].HeadComment = dst.HeadComment
+				update.Content[0].LineComment = dst.LineComment
+				update.Content[0].FootComment = dst.FootComment
+			}
+			*dst = *update.Content[0]
+		}
+	}
+	if err := config.NormalizeV8ConfigAliases(root); err != nil {
+		return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	if !m.yamlRequest && m.method != http.MethodDelete {
+		preserveV8TURNSecrets(root, before)
+	}
+	// Revisions are owned by Home and must not become ordinary editable settings.
+	for _, field := range []string{"credentials/concurrency/lifecycle-config-revision", "credentials/concurrency/observation-barrier-revision", "plugins/auth-revision"} {
+		old := configV8Node(before, strings.Split(field, "/"))
+		next := configV8Node(root, strings.Split(field, "/"))
+		var a, b any
+		if old != nil {
+			_ = old.Decode(&a)
+		}
+		if next != nil {
+			_ = next.Decode(&b)
+		}
+		if !reflect.DeepEqual(a, b) {
+			return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "read_only_field", "field": field})
+		}
+	}
+	stripAPIKeysAuthIndexesFromRoot(root)
+	config.NormalizeCollectionNodeStyles(root)
+	data, err := yaml.Marshal(doc)
+	if err != nil {
+		return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	next, err := config.ParseConfigBytes(data)
+	if err != nil {
+		return nil, nil, configV8Fail(http.StatusUnprocessableEntity, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	if err = config.ValidateV8Config(data); err != nil {
+		return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	data, _, err = config.NormalizeConfigLayout(data, true)
+	if err != nil {
+		return nil, nil, configV8Fail(http.StatusBadRequest, gin.H{"error": "invalid_config", "message": err.Error()})
+	}
+	// Save the validated canonical tree directly: projecting runtime defaults
+	// back onto it loses explicit nulls, empty maps, and opaque plugin settings.
+	data, err = canonicalConfigBytes(data)
+	if err != nil {
+		return nil, nil, configV8Fail(http.StatusInternalServerError, gin.H{"error": "write_failed", "message": err.Error()})
+	}
+	return data, next, nil
+}
+
+// configV8RouteParts resolves a native config route path to its key path.
+func configV8RouteParts(path string) (parts []string, yamlRequest bool, ok bool) {
+	path = strings.TrimSpace(path)
+	if strings.ContainsAny(path, "?#") {
+		return nil, false, false
+	}
+	switch {
+	case path == configV8RoutePrefix:
+		return nil, false, true
+	case path == configV8RoutePrefix+".yaml":
+		return nil, true, true
+	case strings.HasPrefix(path, configV8RoutePrefix+"/"):
+		rest := strings.Trim(strings.TrimPrefix(path, configV8RoutePrefix), "/")
+		if rest == "" {
+			return nil, false, true
+		}
+		return strings.Split(rest, "/"), false, true
+	}
+	return nil, false, false
+}
+
+func configV8MutationFromRequest(req ConfigV8Request) (configV8Mutation, *ConfigV8Problem) {
+	method := strings.ToUpper(strings.TrimSpace(req.Method))
+	parts, yamlRequest, ok := configV8RouteParts(req.Path)
+	if !ok {
+		return configV8Mutation{}, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_path", "path must be a /v8/management/config route")
+	}
+	wildcard := strings.HasPrefix(strings.TrimSpace(req.Path), configV8RoutePrefix+"/")
+	switch method {
+	case http.MethodPut:
+	case http.MethodPatch:
+		if yamlRequest {
+			return configV8Mutation{}, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_method", "config.yaml only supports PUT")
+		}
+	case http.MethodDelete:
+		if !wildcard {
+			return configV8Mutation{}, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_method", "DELETE requires a config sub-path")
+		}
+	default:
+		return configV8Mutation{}, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_method", "method must be PUT, PATCH or DELETE")
+	}
+	var body []byte
+	if method != http.MethodDelete {
+		decoded, err := decodeBase64Field(req.BodyBase64)
+		if err != nil {
+			return configV8Mutation{}, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_body", "body_base64 is not valid base64")
+		}
+		body = decoded
+	}
+	return configV8Mutation{method: method, parts: parts, yamlRequest: yamlRequest, body: body}, nil
+}
+
+func decodeBase64Field(value string) ([]byte, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil, nil
+	}
+	if decoded, err := base64.StdEncoding.DecodeString(value); err == nil {
+		return decoded, nil
+	}
+	return base64.RawStdEncoding.DecodeString(strings.TrimRight(value, "="))
+}
+
+// PrepareConfigV8 validates an ordered transaction against base with native
+// ConfigV8 semantics and returns the exact canonical candidate. Nothing is written.
+func PrepareConfigV8(base []byte, req ConfigV8PrepareRequest) (*ConfigV8Candidate, *ConfigV8Problem) {
+	baseRevision := ConfigRevision(base)
+	if !strings.EqualFold(strings.TrimSpace(req.ExpectedRevision), baseRevision) {
+		problem := newConfigV8Problem(http.StatusConflict, ConfigV8CodeStaleRevision, "stale_revision", "expected_revision does not match the persisted configuration")
+		problem.BaseRevision = baseRevision
+		return nil, problem
+	}
+	if len(req.Requests) == 0 {
+		return nil, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_body", "requests is empty")
+	}
+	doc, current, failure := parseConfigV8Document(base, true)
+	if failure != nil {
+		return nil, failure.problem(-1)
+	}
+	beforeRoot := cloneConfigV8Node(doc.Content[0])
+	for index, request := range req.Requests {
+		mutation, problem := configV8MutationFromRequest(request)
+		if problem != nil {
+			problem.RequestIndex = new(index)
+			return nil, problem
+		}
+		if index > 0 {
+			doc, _, failure = parseConfigV8Document(current, false)
+			if failure != nil {
+				return nil, failure.problem(index)
+			}
+		}
+		canonical, _, failureApply := applyConfigV8Mutation(doc, mutation)
+		if failureApply != nil {
+			return nil, failureApply.problem(index)
+		}
+		current = canonical
+	}
+	after, _, failure := parseConfigV8Document(current, false)
+	if failure != nil {
+		return nil, failure.problem(-1)
+	}
+	changed := diffConfigV8Paths(beforeRoot, after.Content[0])
+	return &ConfigV8Candidate{
+		BaseRevision:      baseRevision,
+		CandidateRevision: ConfigRevision(current),
+		CandidateBase64:   base64.StdEncoding.EncodeToString(current),
+		Effects:           configV8Effects(changed),
+		ChangedPaths:      changed,
+	}, nil
+}
+
+// validateConfigV8Commit checks a candidate against the live bytes and returns the
+// runtime config to install when the candidate can be applied without a restart.
+func validateConfigV8Commit(live []byte, req ConfigV8CommitRequest, candidate []byte) (*config.Config, []string, *ConfigV8Problem) {
+	liveRevision := ConfigRevision(live)
+	if !strings.EqualFold(strings.TrimSpace(req.ExpectedRevision), liveRevision) {
+		problem := newConfigV8Problem(http.StatusConflict, ConfigV8CodeStaleRevision, "stale_revision", "expected_revision does not match the persisted configuration")
+		problem.BaseRevision = liveRevision
+		return nil, nil, problem
+	}
+	if len(bytes.TrimSpace(candidate)) == 0 {
+		return nil, nil, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeCandidateMismatch, "candidate_mismatch", "candidate is empty")
+	}
+	if !strings.EqualFold(strings.TrimSpace(req.CandidateRevision), ConfigRevision(candidate)) {
+		return nil, nil, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeCandidateMismatch, "candidate_mismatch", "candidate_revision does not match candidate bytes")
+	}
+	next, err := config.ParseConfigBytes(candidate)
+	if err != nil {
+		return nil, nil, newConfigV8Problem(http.StatusUnprocessableEntity, ConfigV8CodeInvalidConfig, "invalid_config", err.Error())
+	}
+	if err = config.ValidateV8Config(candidate); err != nil {
+		return nil, nil, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidConfig, "invalid_config", err.Error())
+	}
+	before, _, failure := parseConfigV8Document(live, true)
+	if failure != nil {
+		return nil, nil, failure.problem(-1)
+	}
+	after, _, failure := parseConfigV8Document(candidate, false)
+	if failure != nil {
+		return nil, nil, failure.problem(-1)
+	}
+	effects := configV8Effects(diffConfigV8Paths(before.Content[0], after.Content[0]))
+	for _, effect := range effects {
+		if effect == ConfigV8EffectRestartRequired {
+			problem := newConfigV8Problem(http.StatusConflict, ConfigV8CodeRestartRequired, "restart_required", "candidate changes settings that require a restart; persist it with the instance stopped")
+			problem.Effects = effects
+			return nil, nil, problem
+		}
+	}
+	return next, effects, nil
+}
+
+// diffConfigV8Paths lists slash-joined key paths whose values differ. Mappings
+// are compared key by key (an absent side counts as an empty mapping so added or
+// removed sections report their leaf keys); scalars and sequences are compared
+// as decoded values.
+func diffConfigV8Paths(before, after *yaml.Node) []string {
+	changed := []string{}
+	isMapping := func(node *yaml.Node) bool { return node != nil && node.Kind == yaml.MappingNode }
+	var walk func(prefix string, a, b *yaml.Node)
+	walk = func(prefix string, a, b *yaml.Node) {
+		if a == nil && b == nil {
+			return
+		}
+		recurse := (isMapping(a) && isMapping(b)) ||
+			(a == nil && isMapping(b) && len(b.Content) > 0) ||
+			(b == nil && isMapping(a) && len(a.Content) > 0)
+		if recurse {
+			var keys []string
+			seen := make(map[string]struct{})
+			for _, node := range []*yaml.Node{a, b} {
+				if node == nil {
+					continue
+				}
+				for i := 0; i+1 < len(node.Content); i += 2 {
+					key := node.Content[i].Value
+					if _, ok := seen[key]; ok {
+						continue
+					}
+					seen[key] = struct{}{}
+					keys = append(keys, key)
+				}
+			}
+			for _, key := range keys {
+				child := key
+				if prefix != "" {
+					child = prefix + "/" + key
+				}
+				walk(child, configV8Node(a, []string{key}), configV8Node(b, []string{key}))
+			}
+			return
+		}
+		if a == nil || b == nil {
+			changed = append(changed, prefix)
+			return
+		}
+		var va, vb any
+		_ = a.Decode(&va)
+		_ = b.Decode(&vb)
+		if !reflect.DeepEqual(va, vb) {
+			changed = append(changed, prefix)
+		}
+	}
+	walk("", before, after)
+	return changed
+}
+
+func configV8PathWithin(path, section string) bool {
+	return path == section || strings.HasPrefix(path, section+"/")
+}
+
+// configV8Effects derives the owner-facing effects from changed paths. Settings
+// the native hot reload cannot apply are reported as restart_required.
+func configV8Effects(changed []string) []string {
+	if len(changed) == 0 {
+		return []string{ConfigV8EffectNoChange}
+	}
+	var restart, listener, authDir, mgmt, access, provider, proxy, plugins bool
+	for _, path := range changed {
+		switch {
+		case path == "server" || configV8PathWithin(path, "server/host") || configV8PathWithin(path, "server/port") || configV8PathWithin(path, "server/tls"):
+			listener, restart = true, true
+		case configV8PathWithin(path, "server/trusted-proxies") || path == "server/commercial-mode":
+			restart = true
+		case path == "oauth" || path == "oauth/auth-dir":
+			authDir, restart = true, true
+		case configV8PathWithin(path, "management"):
+			mgmt = true
+		case configV8PathWithin(path, "access"):
+			access = true
+		case configV8PathWithin(path, "api-keys"):
+			provider = true
+		case path == "requests" || path == "requests/proxy-url":
+			proxy = true
+		case configV8PathWithin(path, "plugins"):
+			plugins = true
+		}
+	}
+	effects := make([]string, 0, 9)
+	if restart {
+		effects = append(effects, ConfigV8EffectRestartRequired)
+	}
+	if listener {
+		effects = append(effects, ConfigV8EffectPublicListenerChanged)
+	}
+	if authDir {
+		effects = append(effects, ConfigV8EffectAuthDirChanged)
+	}
+	if restart || authDir {
+		effects = append(effects, ConfigV8EffectPendingOAuthInvalidated)
+	}
+	if mgmt {
+		effects = append(effects, ConfigV8EffectManagementAccessChanged)
+	}
+	if access {
+		effects = append(effects, ConfigV8EffectAccessKeysChanged)
+	}
+	if provider {
+		effects = append(effects, ConfigV8EffectProviderCredsChanged)
+	}
+	if proxy {
+		effects = append(effects, ConfigV8EffectProxyChanged)
+	}
+	if plugins {
+		effects = append(effects, ConfigV8EffectPluginsChanged)
+	}
+	return effects
+}
+
+// HermesConfigPrepare validates an ordered config transaction without writing.
+func (h *Handler) HermesConfigPrepare(c *gin.Context) {
+	var req ConfigV8PrepareRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_body", "prepare request must be JSON"))
+		return
+	}
+	h.mu.Lock()
+	base, err := readConfigBase(h.configFilePath)
+	h.mu.Unlock()
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, newConfigV8Problem(http.StatusInternalServerError, ConfigV8CodeReadFailed, "read_failed", "failed to read the persisted configuration"))
+		return
+	}
+	candidate, problem := PrepareConfigV8(base, req)
+	if problem != nil {
+		c.JSON(problem.Status, problem)
+		return
+	}
+	c.JSON(http.StatusOK, candidate)
+}
+
+// HermesConfigCommit persists a prepared candidate under the native config lock
+// when it needs no restart; the owner persists restart-required candidates with
+// the instance stopped.
+func (h *Handler) HermesConfigCommit(c *gin.Context) {
+	var req ConfigV8CommitRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_body", "commit request must be JSON"))
+		return
+	}
+	candidate, err := decodeBase64Field(req.CandidateBase64)
+	if err != nil {
+		c.JSON(http.StatusBadRequest, newConfigV8Problem(http.StatusBadRequest, ConfigV8CodeInvalidRequest, "invalid_body", "candidate_base64 is not valid base64"))
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	live, err := readConfigBase(h.configFilePath)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, newConfigV8Problem(http.StatusInternalServerError, ConfigV8CodeReadFailed, "read_failed", "failed to read the persisted configuration"))
+		return
+	}
+	next, _, problem := validateConfigV8Commit(live, req, candidate)
+	if problem != nil {
+		c.JSON(problem.Status, problem)
+		return
+	}
+	if err = writeConfigBytes(h.configFilePath, candidate); err != nil {
+		c.JSON(http.StatusInternalServerError, newConfigV8Problem(http.StatusInternalServerError, ConfigV8CodeWriteFailed, "write_failed", err.Error()))
+		return
+	}
+	// Runtime-only ownership state is never sourced from an uploaded YAML document.
+	next.Home = h.cfg.Home
+	h.cfg = next
+	snapshot := h.reloadSnapshotConfigLocked()
+	h.reloadConfigAfterManagementSaveAsync(c.Request.Context(), snapshot)
+	c.JSON(http.StatusOK, gin.H{"status": "ok", "revision": ConfigRevision(candidate)})
+}
