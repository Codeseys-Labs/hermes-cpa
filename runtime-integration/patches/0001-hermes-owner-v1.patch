+func TestPrepareConfigV8MatchesNativeSequentialWritesWithoutWriting(t *testing.T) {
+	requests := []ConfigV8Request{
+		{Method: "put", Path: "/v8/management/config/requests/proxy-url", BodyBase64: b64(`"direct"`)},
+		{Method: "PATCH", Path: "/v8/management/config", ContentType: "application/json", BodyBase64: b64(`{"routing":{"retry":{"request-retry":0}},"oauth":{"providers":{"aistudio":{"ws-auth":false}}},"api-keys":{"claude":[{"keys":[{"api-key":"sk-claude-test","auth_index":"stale-index"}]}]}}`)},
+		{Method: "PUT", Path: "/v8/management/config/oauth/providers/codex/live-media-relay/ice-servers", BodyBase64: b64(`[{"urls":["turn:example.invalid:3478"]}]`)},
+		{Method: "DELETE", Path: "/v8/management/config/requests/proxy-url"},
+		{Method: "PUT", Path: "/v8/management/config.yaml", BodyBase64: ""},
+	}
+	nativePath := writeFixture(t, prepareFixtureYAML)
+	_, router := newConfigV8Router(t, nativePath)
+	for index, request := range requests[:4] {
+		body, _ := base64.StdEncoding.DecodeString(request.BodyBase64)
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, httptest.NewRequest(strings.ToUpper(request.Method), request.Path, bytes.NewReader(body)))
+		if recorder.Code != http.StatusOK {
+			t.Fatalf("native request %d: status=%d body=%s", index, recorder.Code, recorder.Body.String())
+		}
+	}
+	nativeBytes, err := os.ReadFile(nativePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The final YAML PUT replays the native result so the transaction also covers the YAML route.
+	requests[4].BodyBase64 = base64.StdEncoding.EncodeToString(nativeBytes)
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodPut, "/v8/management/config.yaml", bytes.NewReader(nativeBytes)))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("native yaml put: status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+	nativeBytes, err = os.ReadFile(nativePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	preparedPath := writeFixture(t, prepareFixtureYAML)
+	base, _ := os.ReadFile(preparedPath)
+	candidate, problem := PrepareConfigV8(base, ConfigV8PrepareRequest{ExpectedRevision: strings.ToUpper(ConfigRevision(base)), Requests: requests})
+	if problem != nil {
+		t.Fatalf("prepare failed: %+v", problem)
+	}
+	if got := decodeCandidate(t, candidate); !bytes.Equal(got, nativeBytes) {
+		t.Fatalf("candidate differs from native sequential writes\n--- candidate ---\n%s\n--- native ---\n%s", got, nativeBytes)
+	}
+	if candidate.BaseRevision != ConfigRevision(base) || candidate.CandidateRevision != ConfigRevision(nativeBytes) {
+		t.Fatalf("revisions: %+v", candidate)
+	}
+	if after, _ := os.ReadFile(preparedPath); string(after) != prepareFixtureYAML {
+		t.Fatal("prepare wrote to the configuration file")
+	}
+	loaded, err := config.ParseConfigBytes(nativeBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.ProxyURL != "" || loaded.RequestRetry != 0 || loaded.WebsocketAuth || len(loaded.ClaudeKey) != 1 || loaded.ClaudeKey[0].APIKey != "sk-claude-test" {
+		t.Fatalf("native semantics lost: %+v", loaded)
+	}
+	if server := loaded.Codex.LiveMediaRelay.ICEServers[0]; server.Username != "test-relay-user" || server.Credential != "test-relay-password" {
+		t.Fatal("JSON write did not preserve redacted TURN credentials")
+	}
+	if strings.Contains(string(nativeBytes), "stale-index") {
+		t.Fatal("auth_index must be stripped from persisted api-keys")
+	}
+	if !strings.Contains(string(nativeBytes), "# Keep this configuration") || !strings.Contains(string(nativeBytes), "custom-null: null") || !strings.Contains(string(nativeBytes), "options: {}") {
+		t.Fatalf("comments, explicit nulls or empty maps lost:\n%s", nativeBytes)
+	}
+	wantChanged := []string{"api-keys/claude", "oauth/providers/aistudio/ws-auth", "routing/retry/request-retry"}
+	changed := append([]string(nil), candidate.ChangedPaths...)
+	sortStrings(changed)
+	if !reflect.DeepEqual(changed, wantChanged) {
+		t.Fatalf("changed_paths=%v want %v", candidate.ChangedPaths, wantChanged)
+	}
+	if !reflect.DeepEqual(candidate.Effects, []string{ConfigV8EffectProviderCredsChanged}) {
+		t.Fatalf("effects=%v", candidate.Effects)
+	}
+}
+
+func sortStrings(values []string) {
+	for i := 1; i < len(values); i++ {
+		for j := i; j > 0 && values[j-1] > values[j]; j-- {
+			values[j-1], values[j] = values[j], values[j-1]
+		}
+	}
+}
