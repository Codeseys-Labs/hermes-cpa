+// RegisteredManagementRoute describes one active plugin-owned route for
+// supervisors that need a finite route map.
+type RegisteredManagementRoute struct {
+	Method      string `json:"method"`
+	Path        string `json:"path"`
+	PluginID    string `json:"plugin_id"`
+	Menu        string `json:"menu,omitempty"`
+	Description string `json:"description,omitempty"`
+}
+
+// RouteRegistry is the dispatchable plugin surface together with its
+// incarnation. Revision changes whenever that surface changes: route tables,
+// and the plugin instances an owner can select by id or provider name
+// (Dispatches), including an instance replaced behind an identical id or path.
+type RouteRegistry struct {
+	Revision   string
+	Management []RegisteredManagementRoute
+	Resources  []RegisteredManagementRoute
+	Dispatches []RegisteredPluginDispatch
+}
+
+// RegisteredManagementRoutes returns the currently dispatchable plugin
+// management routes, browser resource routes and dispatch-capable plugin
+// instances in deterministic order. Provider names are read from the plugins
+// outside the registry lock; the listing is retried while the incarnation
+// moves underneath so the returned revision seals exactly the listed set.
+func (h *Host) RegisteredManagementRoutes() RouteRegistry {
+	if h == nil {
+		return RouteRegistry{}
+	}
+	var registry RouteRegistry
+	for range 4 {
+		var candidates []dispatchCandidate
+		registry, candidates = h.routeRegistryLocked()
+		registry.Dispatches = h.registeredDispatches(candidates)
+		if h.currentRouteRegistryRevision() == registry.Revision {
+			break
+		}
+	}
+	sortRegisteredRoutes(registry.Management)
+	sortRegisteredRoutes(registry.Resources)
+	return registry
+}
+
+// routeRegistryLocked snapshots the route tables, the incarnation and the
+// dispatch candidates under one lock hold.
+func (h *Host) routeRegistryLocked() (RouteRegistry, []dispatchCandidate) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	registry := RouteRegistry{Revision: h.routeRegistryRevisionLocked()}
+	for _, record := range h.managementRoutes {
+		if !h.routeRecordDispatchableLocked(record.pluginID, record.path, record.version) {
+			continue
+		}
+		registry.Management = append(registry.Management, RegisteredManagementRoute{
+			Method:      record.route.Method,
+			Path:        record.route.Path,
+			PluginID:    record.pluginID,
+			Description: record.route.Description,
+		})
+	}
+	for _, record := range h.resourceRoutes {
+		if !h.routeRecordDispatchableLocked(record.pluginID, record.path, record.version) {
+			continue
+		}
+		registry.Resources = append(registry.Resources, RegisteredManagementRoute{
+			Method:      http.MethodGet,
+			Path:        record.route.Path,
+			PluginID:    record.pluginID,
+			Menu:        record.route.Menu,
+			Description: record.route.Description,
+		})
+	}
+	return registry, h.dispatchCandidatesLocked()
+}
+
+// routeRecordDispatchableLocked mirrors the checks the dispatchers apply so the
+// listing never advertises a route that would not be served.
+func (h *Host) routeRecordDispatchableLocked(pluginID, path, version string) bool {
+	if _, fused := h.fused[pluginID]; fused {
+		return false
+	}
+	return h.pluginIdentityCurrentLocked(pluginID, path, version)
+}
+
+func sortRegisteredRoutes(routes []RegisteredManagementRoute) {
+	sort.Slice(routes, func(i, j int) bool {
+		if routes[i].Path != routes[j].Path {
+			return routes[i].Path < routes[j].Path
+		}
+		return routes[i].Method < routes[j].Method
+	})
+}
+
+// newRouteRegistryNonce makes revisions from different processes distinct so a
+// counter that restarts at one after a relaunch never equals a stale value.
+func newRouteRegistryNonce() string {
+	var raw [8]byte
+	if _, err := rand.Read(raw[:]); err != nil {
+		return fmt.Sprintf("%016x", uint64(time.Now().UnixNano()))
+	}
+	return hex.EncodeToString(raw[:])
+}
+
+// routeRegistryRevisionLocked formats the current incarnation. Callers hold h.mu.
+func (h *Host) routeRegistryRevisionLocked() string {
+	return fmt.Sprintf("%s-%d", h.routeRegistryNonce, h.routeRegistryRevision)
+}
+
+// setRouteTablesLocked installs rebuilt route tables and advances the registry
+// revision only when the dispatchable registration actually changed. Callers
+// hold h.mu.
+func (h *Host) setRouteTablesLocked(routes map[string]managementRouteRecord, resources map[string]resourceRouteRecord) {
+	changed := !managementRouteTablesEqual(h.managementRoutes, routes) || !resourceRouteTablesEqual(h.resourceRoutes, resources)
+	h.managementRoutes = routes
+	h.resourceRoutes = resources
+	if changed {
+		h.routeRegistryRevision++
+	}
+}
+
+// markPluginFusedLocked records a fused plugin and advances the registry revision
+// when the plugin owned anything an owner can dispatch. Callers hold h.mu.
+func (h *Host) markPluginFusedLocked(id, reason string) {
+	_, already := h.fused[id]
+	h.fused[id] = reason
+	if !already && h.pluginOwnsDispatchLocked(id) {
+		h.routeRegistryRevision++
+	}
+}
+
+// clearPluginFusedLocked lifts a fuse and advances the registry revision when
+// the plugin's routes or providers become dispatchable again. Callers hold h.mu.
+func (h *Host) clearPluginFusedLocked(id string) {
+	if _, fused := h.fused[id]; !fused {
+		return
+	}
+	delete(h.fused, id)
+	if h.pluginOwnsDispatchLocked(id) {
+		h.routeRegistryRevision++
+	}
+}
+
+// pluginOwnsDispatchLocked reports whether the plugin owns a route or a
+// dispatch-capable provider identity. Callers hold h.mu.
+func (h *Host) pluginOwnsDispatchLocked(id string) bool {
+	if _, ok := h.dispatchIdentities[id]; ok {
+		return true
+	}
+	for _, record := range h.managementRoutes {
+		if record.pluginID == id {
+			return true
+		}
+	}
+	for _, record := range h.resourceRoutes {
+		if record.pluginID == id {
+			return true
+		}
+	}
+	return false
+}
+
+func managementRouteTablesEqual(a, b map[string]managementRouteRecord) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for key, left := range a {
+		right, ok := b[key]
+		if !ok || left.pluginID != right.pluginID || left.path != right.path || left.version != right.version || left.schemaVersion != right.schemaVersion {
+			return false
+		}
+		if left.route.Method != right.route.Method || left.route.Path != right.route.Path || left.route.Menu != right.route.Menu || left.route.Description != right.route.Description {
+			return false
+		}
+		if !sameManagementHandler(left.route.Handler, right.route.Handler) {
+			return false
+		}
+	}
+	return true
+}
+
+func resourceRouteTablesEqual(a, b map[string]resourceRouteRecord) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for key, left := range a {
+		right, ok := b[key]
+		if !ok || left.pluginID != right.pluginID || left.path != right.path || left.version != right.version {
+			return false
+		}
+		if left.route.Path != right.route.Path || left.route.Menu != right.route.Menu || left.route.Description != right.route.Description {
+			return false
+		}
+		if !sameManagementHandler(left.route.Handler, right.route.Handler) {
+			return false
+		}
+	}
+	return true
+}
+
+// sameManagementHandler reports whether two handlers are the same instance;
+// see sameCapabilityInstance.
+func sameManagementHandler(a, b pluginapi.ManagementHandler) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return sameCapabilityInstance(a, b)
 }
