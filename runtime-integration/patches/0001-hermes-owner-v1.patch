+		"management": {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/management/allow-remote", BodyBase64: b64(`true`)}, []string{ConfigV8EffectManagementAccessChanged}},
+		"access":     {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/access/api-keys", BodyBase64: b64(`["rotated"]`)}, []string{ConfigV8EffectAccessKeysChanged}},
+		"proxy":      {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/requests/proxy-url", BodyBase64: b64(`"socks5://127.0.0.1:1080"`)}, []string{ConfigV8EffectProxyChanged}},
+		"plugins":    {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/plugins/configs/sample", BodyBase64: b64(`{"enabled":true}`)}, []string{ConfigV8EffectPluginsChanged}},
+		"hot":        {ConfigV8Request{Method: "PUT", Path: "/v8/management/config/routing/retry/request-retry", BodyBase64: b64(`5`)}, []string{}},
+	} {
+		t.Run(name, func(t *testing.T) {
