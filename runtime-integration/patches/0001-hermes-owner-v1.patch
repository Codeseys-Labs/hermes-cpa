diff --git a/internal/api/server_hermes_owner.go b/internal/api/server_hermes_owner.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c8689674a4d262ffe628b5e48ed742140504bf5
--- /dev/null
+++ b/internal/api/server_hermes_owner.go
@@ -0,0 +1,315 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/buildinfo"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/hermesowner"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	log "github.com/sirupsen/logrus"
+)
+
+// hermesOwnerWatchInterval bounds how long a supervised instance outlives its owner.
+const hermesOwnerWatchInterval = 500 * time.Millisecond
+
+// hermesInferenceRoutes is the inference channel allowlist: only routes the
+// Hermes broker consumes, nothing management-shaped.
+var hermesInferenceRoutes = map[string]struct{}{
+	http.MethodGet + " /v1/models":            {},
+	http.MethodPost + " /v1/chat/completions": {},
+	http.MethodPost + " /v1/responses":        {},
+}
+
+// WithHermesOwnerChannels serves the private owner-only control and inference
+// Unix channels from the same server, authenticated by peer identity.
+func WithHermesOwnerChannels(opts hermesowner.Options) ServerOption {
+	return func(cfg *serverOptionConfig) {
+		cfg.hermesOwner = &opts
+	}
+}
+
+type hermesOwnerState struct {
+	opts  hermesowner.Options
+	ready atomic.Bool
+
+	mu        sync.Mutex
+	listeners []hermesowner.Listener
+	servers   []*http.Server
+	stopWatch chan struct{}
+}
+
+// hermesOwnerEnabled reports whether this server was built with owner channels.
+func (s *Server) hermesOwnerEnabled() bool {
+	return s != nil && s.hermesOwner != nil
+}
+
+// hermesControlPathAllowed limits the control channel to management and owner routes.
+func hermesControlPathAllowed(path string) bool {
+	switch {
+	case strings.HasPrefix(path, "/hermes/"):
+		return true
+	case path == "/v8/management" || strings.HasPrefix(path, "/v8/management/"):
+		return true
+	case path == "/v0/management" || strings.HasPrefix(path, "/v0/management/"):
+		return true
+	case strings.HasPrefix(path, "/v0/resource/plugins/"):
+		return true
+	default:
+		return false
+	}
+}
+
+// hermesChannelGateMiddleware enforces disjoint privileges per private channel and
+// keeps owner-only request headers from meaning anything on the public listener.
+func (s *Server) hermesChannelGateMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if c.Request == nil || c.Request.URL == nil {
+			c.Next()
+			return
+		}
+		switch hermesowner.ChannelFromContext(c.Request.Context()) {
+		case hermesowner.ChannelControl:
+			if !hermesControlPathAllowed(c.Request.URL.Path) {
+				c.AbortWithStatusJSON(http.StatusNotFound, gin.H{"error": "not_found", "channel": hermesowner.ChannelControl.String()})
+				return
+			}
+			dropBearerHeaders(c.Request)
+		case hermesowner.ChannelInference:
+			if _, ok := hermesInferenceRoutes[c.Request.Method+" "+c.Request.URL.Path]; !ok {
+				c.AbortWithStatusJSON(http.StatusNotFound, gin.H{"error": "not_found", "channel": hermesowner.ChannelInference.String()})
+				return
+			}
+			dropBearerHeaders(c.Request)
+			dropOwnerOnlyHeaders(c.Request)
+		default:
+			dropOwnerOnlyHeaders(c.Request)
+		}
+		c.Next()
+	}
+}
+
+// dropBearerHeaders removes editable-key credentials: private channels are
+// authorised by the listener, so a bearer value must never be consulted or forwarded.
+func dropBearerHeaders(r *http.Request) {
+	r.Header.Del("Authorization")
+	r.Header.Del("X-Management-Key")
+}
+
+// dropOwnerOnlyHeaders removes request headers that carry authority only on the
+// control channel so they can never influence another listener.
+func dropOwnerOnlyHeaders(r *http.Request) {
+	r.Header.Del(hermesowner.EgressPolicyHeader)
+	r.Header.Del(hermesowner.ResourceRevisionHeader)
+	r.Header.Del(hermesowner.PluginRevisionHeader)
+}
+
+// hermesControlOnly rejects owner routes reached through any other listener.
+func hermesControlOnly() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if hermesowner.ChannelFromContext(c.Request.Context()) != hermesowner.ChannelControl {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		c.Next()
+	}
+}
+
+// hermesPluginReviewableRoutes are the fixed management routes that apply the
+// owner's plugin revision precondition themselves (handlers/management
+// plugin_review.go). Keys are METHOD + registered route pattern.
+var hermesPluginReviewableRoutes = map[string]struct{}{
+	"GET /v8/management/oauth/auth-url":           {},
+	"GET /v8/management/plugins/:id/quota":        {},
+	"POST /v8/management/plugins/:id/quota":       {},
+	"DELETE /v8/management/plugins/:id/quota":     {},
+	"GET /v0/management/plugins/:id/quota":        {},
+	"POST /v0/management/plugins/:id/quota":       {},
+	"DELETE /v0/management/plugins/:id/quota":     {},
+	"POST /v0/management/plugins/:id/quota/reset": {},
+}
+
+// hermesPluginReviewGate refuses a control-channel plugin revision assertion
+// on every fixed management route that cannot honour it, before the handler
+// runs, with host proof that nothing was invoked. A review can therefore only
+// ever reach a declared plugin route, a plugin-provider login start or a
+// fixed quota route; it can never land on a shadowing native handler and
+// merely come back without markers.
+func (s *Server) hermesPluginReviewGate() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		review := hermesowner.PluginReviewFromRequest(c.Request)
+		if !review.Asserted {
+			c.Next()
+			return
+		}
+		if _, ok := hermesPluginReviewableRoutes[c.Request.Method+" "+c.FullPath()]; ok {
+			c.Next()
+			return
+		}
+		hermesowner.SetPluginDispatchMarkers(c.Writer.Header(), true, s.pluginHost.RegistryRevision(), false)
+		c.AbortWithStatusJSON(http.StatusBadRequest, gin.H{"error": "plugin_review_unsupported"})
+	}
+}
+
+func (s *Server) registerHermesOwnerRoutes() {
+	if s == nil || s.engine == nil || s.mgmt == nil || !s.hermesOwnerEnabled() {
+		return
+	}
+	hermes := s.engine.Group("/hermes", hermesControlOnly())
+	hermes.GET("/health", s.hermesHealth)
+	hermes.GET("/plugin-routes", s.hermesPluginRoutes)
+	hermes.POST("/config/prepare", s.mgmt.HermesConfigPrepare)
+	hermes.POST("/config/commit", s.mgmt.HermesConfigCommit)
+}
+
+func (s *Server) hermesHealth(c *gin.Context) {
+	if !s.hermesOwnerEnabled() || !s.hermesOwner.ready.Load() {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"code": "STARTING", "error": "starting"})
+		return
+	}
+	revision, err := s.mgmt.CurrentConfigRevision()
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"code": "READ_FAILED", "error": "read_failed"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{
+		"protocol":        hermesowner.Protocol,
+		"integration":     hermesowner.Integration,
+		"cpa_version":     buildinfo.Version,
+		"config_revision": revision,
+	})
+}
+
+// hermesPluginRoutes reports the dispatchable plugin surface and its
+// incarnation: declared management routes, browser resource routes and the
+// plugin instances an owner may select by id (quota) or provider name (OAuth
+// start). registry_revision changes on every actual change of that surface,
+// including a plugin reloaded behind identical paths or the same id, so an
+// owner can revoke reviews that were approved against an earlier registry.
+func (s *Server) hermesPluginRoutes(c *gin.Context) {
+	registry := pluginhost.RouteRegistry{Revision: "none-0"}
+	if s.pluginHost != nil {
+		registry = s.pluginHost.RegisteredManagementRoutes()
+	}
+	management := []pluginhost.RegisteredManagementRoute{}
+	resources := []pluginhost.RegisteredManagementRoute{}
+	dispatches := []pluginhost.RegisteredPluginDispatch{}
+	management = append(management, registry.Management...)
+	resources = append(resources, registry.Resources...)
+	dispatches = append(dispatches, registry.Dispatches...)
+	c.JSON(http.StatusOK, gin.H{"registry_revision": registry.Revision, "management": management, "resources": resources, "dispatches": dispatches})
+}
+
+// startHermesOwnerChannels binds both private sockets. Any failure is fatal for
+// Start so a supervised instance never runs half-private.
+func (s *Server) startHermesOwnerChannels() error {
+	state := s.hermesOwner
+	if state == nil {
+		return nil
+	}
+	if err := state.opts.Validate(); err != nil {
+		return err
+	}
+	identity, err := hermesowner.ResolveOwner(state.opts.OwnerPID)
+	if err != nil {
+		return err
+	}
+	control, err := hermesowner.Listen(state.opts.ControlSocket, identity)
+	if err != nil {
+		return err
+	}
+	inference, err := hermesowner.Listen(state.opts.InferenceSocket, identity)
+	if err != nil {
+		_ = control.Close()
+		return err
+	}
+	type boundChannel struct {
+		channel  hermesowner.Channel
+		listener hermesowner.Listener
+		server   *http.Server
+	}
+	bound := []boundChannel{{channel: hermesowner.ChannelControl, listener: control}, {channel: hermesowner.ChannelInference, listener: inference}}
+	for i := range bound {
+		channel := bound[i].channel
+		bound[i].server = &http.Server{
+			Handler: s.engine,
+			ConnContext: func(ctx context.Context, _ net.Conn) context.Context {
+				return hermesowner.WithChannel(ctx, channel)
+			},
+		}
+	}
+	stop := make(chan struct{})
+	state.mu.Lock()
+	state.listeners = []hermesowner.Listener{control, inference}
+	state.servers = []*http.Server{bound[0].server, bound[1].server}
+	state.stopWatch = stop
+	state.mu.Unlock()
+	for _, item := range bound {
+		go func(item boundChannel) {
+			errServe := item.server.Serve(item.listener)
+			if errServe != nil && !errors.Is(errServe, http.ErrServerClosed) && !errors.Is(errServe, net.ErrClosed) {
+				log.WithError(errServe).Errorf("hermes owner %s channel stopped unexpectedly; stopping server", item.channel)
+				if errStop := s.Stop(context.Background()); errStop != nil {
+					log.WithError(errStop).Error("failed to stop server after owner channel failure")
+				}
+			}
+		}(item)
+	}
+	go s.watchHermesOwner(identity, stop)
+	log.Infof("hermes owner channels bound (control=%s inference=%s owner %s)", control.Path(), inference.Path(), identity)
+	return nil
+}
+
+// watchHermesOwner stops the instance once the launching supervisor is gone so a
+// reused PID can never regain the private channels.
+func (s *Server) watchHermesOwner(identity hermesowner.Identity, stop <-chan struct{}) {
+	ticker := time.NewTicker(hermesOwnerWatchInterval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			if identity.Alive() {
+				continue
+			}
+			log.Warn("hermes owner process exited; stopping the supervised instance")
+			if errStop := s.Stop(context.Background()); errStop != nil {
+				log.WithError(errStop).Error("failed to stop server after owner exit")
+			}
+			return
+		}
+	}
+}
+
+func (s *Server) stopHermesOwnerChannels() {
+	state := s.hermesOwner
+	if state == nil {
+		return
+	}
+	state.ready.Store(false)
+	state.mu.Lock()
+	servers, listeners, stop := state.servers, state.listeners, state.stopWatch
+	state.servers, state.listeners, state.stopWatch = nil, nil, nil
+	state.mu.Unlock()
+	if stop != nil {
+		close(stop)
+	}
+	for _, srv := range servers {
+		if errClose := srv.Close(); errClose != nil && !errors.Is(errClose, http.ErrServerClosed) {
+			log.WithError(errClose).Debug("failed to close hermes owner channel server")
+		}
+	}
+	for _, listener := range listeners {
+		if errClose := listener.Close(); errClose != nil {
+			log.WithError(errClose).Debug("failed to close hermes owner listener")
+		}
+	}
+}
