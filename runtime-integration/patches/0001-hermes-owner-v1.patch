+	if err != nil || !outcome.Invoked || !outcome.Handled || resp.State != "reviewed" || resp.URL != "http://127.0.0.1:1/cb" {
+		t.Fatalf("in-flight replacement: resp=%+v outcome=%+v err=%v", resp, outcome, err)
+	}
+	if starts["reviewed"] != 1 || starts["replacement"] != 0 || host.RegistryRevision() == revision {
+		t.Fatalf("starts=%v revision moved=%v", starts, host.RegistryRevision() != revision)
+	}
+	if _, outcome, err = host.StartLoginCaptured(context.Background(), dispatch, "custom-sso", "", nil); outcome.Invoked || err != nil || starts["replacement"] != 0 {
+		t.Fatalf("stale capture: outcome=%+v err=%v starts=%v", outcome, err, starts)
+	}
+
+	failing := &fakeAuthProvider{identifier: "custom-sso", startLogin: func(context.Context, pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+		return pluginapi.AuthLoginStartResponse{}, errors.New("provider down")
+	}}
+	setHostSnapshotForTest(host, true, authOnlyRecord("login", 1, failing))
+	dispatch, _, ok = host.CaptureAuthProvider("custom-sso")
+	if !ok {
+		t.Fatal("failing provider was not captured")
+	}
+	if _, outcome, err = host.StartLoginCaptured(context.Background(), dispatch, "custom-sso", "", nil); !outcome.Invoked || !outcome.Handled || err == nil {
+		t.Fatalf("provider error outcome=%+v err=%v", outcome, err)
+	}
+}
