diff --git a/internal/api/handlers/management/plugin_review.go b/internal/api/handlers/management/plugin_review.go
new file mode 100644
index 0000000000000000000000000000000000000000..bef99f7423e82371f7b482ca039be65b521bcd4f
--- /dev/null
+++ b/internal/api/handlers/management/plugin_review.go
@@ -0,0 +1,51 @@
+package management
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/hermesowner"
+	log "github.com/sirupsen/logrus"
+)
+
+// Fixed management routes that run plugin code selected by plugin id or
+// provider name (quota fetch/reset, plugin-provider login start) honour the
+// same owner precondition as declared plugin routes: on the control channel
+// the reviewed registry incarnation (X-Hermes-Plugin-Revision) is compared
+// atomically with the plugin instance lookup, only the captured instance can
+// run, and the response carries host-owned markers telling whether plugin
+// code ran. Refusals before any lookup (400/404) carry Invoked:0 and the
+// current incarnation so the owner can report an observed refusal.
+
+// pluginReviewMarkers writes the dispatch truth; no-op off the control channel.
+func pluginReviewMarkers(c *gin.Context, review hermesowner.PluginReview, revision string, invoked bool) {
+	if c == nil || c.Writer == nil {
+		return
+	}
+	hermesowner.SetPluginDispatchMarkers(c.Writer.Header(), review.OwnerChannel, revision, invoked)
+}
+
+// writeStalePluginReview answers an owner review whose registry incarnation no
+// longer matches, or whose reviewed instance could no longer run. Nothing ran.
+func writeStalePluginReview(c *gin.Context, revision string) {
+	if err := hermesowner.WriteStalePluginRevision(c.Writer, revision); err != nil {
+		log.WithError(err).Warn("failed to write stale plugin review response")
+	}
+	c.Abort()
+}
+
+// refuseBeforePluginDispatch rejects a request before any plugin lookup with
+// Invoked:0 markers and the current incarnation.
+func (h *Handler) refuseBeforePluginDispatch(c *gin.Context, review hermesowner.PluginReview, status int, body gin.H) {
+	pluginReviewMarkers(c, review, h.hostRegistryRevision(), false)
+	c.JSON(status, body)
+}
+
+// hostRegistryRevision reads the current incarnation; "none-0" without a host.
+func (h *Handler) hostRegistryRevision() string {
+	if h == nil {
+		return "none-0"
+	}
+	h.mu.Lock()
+	host := h.pluginHost
+	h.mu.Unlock()
+	return host.RegistryRevision()
+}
