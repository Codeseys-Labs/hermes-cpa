+// startProviderCallbackForwarder opens the provider's fixed callback port for a
+// browser-driven login. In stock mode the forwarder redirects to the public
+// listener's native callback route. In Hermes owner mode it binds loopback only
+// and completes the callback itself with the same native pending-session
+// validation and callback-file writer, so OAuth completion never depends on the
+// editable public host, port or TLS settings. It writes the native error
+// responses and returns false when the forwarder could not be started.
+func (h *Handler) startProviderCallbackForwarder(c *gin.Context, port int, provider, callbackPath string) (*callbackForwarder, bool) {
+	if h.HermesOwnerMode() {
+		authDir := ""
+		if h.cfg != nil {
+			authDir = h.cfg.AuthDir
+		}
+		forwarder, errStart := startNativeCallbackForwarder(port, provider, authDir)
+		if errStart != nil {
+			log.WithError(errStart).Errorf("failed to start %s callback forwarder", provider)
+			c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to start callback server"})
+			return nil, false
+		}
+		return forwarder, true
+	}
+	targetURL, errTarget := h.managementCallbackURL(callbackPath)
+	if errTarget != nil {
+		log.WithError(errTarget).Errorf("failed to compute %s callback target", provider)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "callback server unavailable"})
+		return nil, false
+	}
+	forwarder, errStart := startCallbackForwarder(port, provider, targetURL)
+	if errStart != nil {
+		log.WithError(errStart).Errorf("failed to start %s callback forwarder", provider)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to start callback server"})
+		return nil, false
+	}
+	return forwarder, true
+}
